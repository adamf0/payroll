---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser } from '../../lib/auth';
import { queryAll } from '../../lib/db';
import { formatRupiah, formatIndonesianDate } from '../../lib/payroll';
import type { Employee } from '../../lib/types';

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || currentUser.role !== 'admin') {
  return Astro.redirect('/login');
}

interface EmployeeWithAccount extends Employee {
  user_id?: number | null;
  username?: string | null;
  user_email?: string | null;
  user_password?: string | null;
}

const employees = await queryAll<EmployeeWithAccount>(`
  SELECT e.*, u.id as user_id, u.username, u.email as user_email, u.password as user_password
  FROM employees e
  LEFT JOIN users u ON u.employee_id = e.id
  ORDER BY e.id DESC
`);
---

<Layout title="Data Karyawan" activeNav="admin-karyawan">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Data Karyawan</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Kelola nama, kontak, sistem gaji, dan tanggal gajian karyawan.
        </p>
      </div>

      <div class="flex items-center gap-2 self-start sm:self-auto">
        <a
          href="/admin/riwayat?module=karyawan"
          class="px-3.5 py-2.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs border border-slate-200 transition shadow-sm flex items-center gap-1.5"
        >
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Riwayat Perubahan</span>
        </a>
        <button
          onclick="openModal()"
          class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs transition shadow-sm flex items-center gap-1.5"
        >
          <span class="text-sm font-bold">+</span>
          <span>Tambah Karyawan</span>
        </button>
      </div>
    </div>

    <!-- Table Container -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-4 border-b border-slate-100 flex items-center justify-between">
        <div class="text-xs font-bold text-slate-900">
          Total: <span class="text-indigo-600 font-extrabold">{employees.length} Karyawan</span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50/60 border-b border-slate-100 text-slate-400 font-semibold uppercase tracking-wider">
              <th class="py-3 px-4">Nama Karyawan</th>
              <th class="py-3 px-4">No. Telepon</th>
              <th class="py-3 px-4">Mulai Bekerja</th>
              <th class="py-3 px-4">Sistem & Tarif Gaji</th>
              <th class="py-3 px-4">Jadwal Gajian</th>
              <th class="py-3 px-4">Status</th>
              <th class="py-3 px-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="emp-table-body">
            {employees.map((emp) => (
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-slate-900 text-sm">{emp.name}</span>
                    {emp.position && (
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                        {emp.position}
                      </span>
                    )}
                  </div>
                  <div class="font-mono text-[11px] text-slate-400 flex flex-wrap items-center gap-1.5 mt-0.5">
                    <span>NIK: {emp.nik}</span>
                    {emp.username ? (
                      <span class="inline-flex items-center gap-1 text-[10px] text-indigo-700 bg-indigo-50 border border-indigo-200 px-1.5 py-0.5 rounded font-semibold font-sans" title="Akun Login Aktif">
                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                        username: {emp.username}
                      </span>
                    ) : (
                      <span class="inline-flex items-center text-[10px] text-amber-700 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded font-sans" title="Belum Dibuatkan Akun">
                        Belum ada akun
                      </span>
                    )}
                  </div>
                </td>
                <td class="py-3.5 px-4 font-mono text-slate-800">
                  <div class="font-medium">{emp.phone || '-'}</div>
                  {emp.bank_name && emp.bank_account_number && (
                    <div class="text-[11px] text-slate-500 font-sans mt-0.5">
                      <span class="font-semibold text-slate-700">{emp.bank_name}</span>: {emp.bank_account_number}
                      {emp.bank_account_holder && <span class="text-slate-400"> (a.n. {emp.bank_account_holder})</span>}
                    </div>
                  )}
                </td>
                <td class="py-3.5 px-4 font-medium text-slate-700 whitespace-nowrap">
                  {formatIndonesianDate(emp.join_date)}
                </td>
                <td class="py-3.5 px-4">
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200 capitalize">
                    {emp.scheme.replace('_', ' ')}
                  </span>
                  <div class="font-bold text-slate-900 mt-1">
                    {formatRupiah(emp.base_rate)}
                    <span class="text-[10px] text-slate-400 font-normal">
                      {emp.scheme === 'per_jam' ? '/jam' : emp.scheme === 'harian' ? '/hari' : emp.scheme === 'mingguan' ? '/minggu' : '/bulan'}
                    </span>
                  </div>
                  {Number(emp.fixed_allowance) > 0 && (
                    <div class="text-[10px] text-emerald-600 font-semibold mt-0.5">
                      + Tunjangan {formatRupiah(emp.fixed_allowance)}
                    </div>
                  )}
                </td>
                <td class="py-3.5 px-4">
                  <span class="font-semibold text-slate-800">
                    {emp.payday_rule === 'jumat' ? 'Tiap Hari Jumat' : `Tiap Tanggal ${emp.payday_rule}`}
                  </span>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap">
                  <span
                    class={`inline-flex items-center px-2.5 py-0.5 rounded-full font-semibold text-[10px] whitespace-nowrap ${
                      emp.is_active
                        ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                        : 'bg-slate-100 text-slate-500 border border-slate-200'
                    }`}
                  >
                    {emp.is_active ? 'Aktif' : 'Non-Aktif'}
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right space-x-1 whitespace-nowrap">
                  <button
                    onclick={`openAccountModal(${JSON.stringify(emp)})`}
                    class="px-2.5 py-1 rounded-lg text-indigo-700 hover:bg-indigo-50 border border-indigo-200 font-semibold transition"
                    title={emp.username ? 'Edit Akun Login' : 'Buat Akun Login'}
                  >
                    {emp.username ? 'Akun' : '+ Akun'}
                  </button>
                  <button
                    onclick={`editEmployee(${JSON.stringify(emp)})`}
                    class="px-2.5 py-1 rounded-lg text-slate-700 hover:bg-slate-100 border border-slate-200 font-semibold transition"
                  >
                    Edit
                  </button>
                  {emp.is_active === 1 ? (
                    <button
                      onclick={`deactivateEmployee(${emp.id}, '${emp.name}')`}
                      class="px-2.5 py-1 rounded-lg text-amber-700 hover:bg-amber-50 border border-amber-200 font-semibold transition"
                    >
                      Nonaktifkan
                    </button>
                  ) : (
                    <button
                      onclick={`activateEmployee(${emp.id}, '${emp.name}')`}
                      class="px-2.5 py-1 rounded-lg text-emerald-700 hover:bg-emerald-50 border border-emerald-200 font-semibold transition"
                    >
                      Aktifkan
                    </button>
                  )}
                  <button
                    onclick={`deleteEmployee(${emp.id}, '${emp.name}')`}
                    class="px-2.5 py-1 rounded-lg text-rose-700 hover:bg-rose-50 border border-rose-200 font-semibold transition"
                    title="Hapus Karyawan Permanen"
                  >
                    Hapus
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Employee Modal (Create & Edit) -->
  <div id="emp-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-xl border border-slate-200 relative max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
        <div>
          <h3 id="modal-title" class="text-lg font-bold text-slate-900">Tambah Karyawan Baru</h3>
          <p class="text-xs text-slate-500">Lengkapi data diri dan skema pembayaran</p>
        </div>
        <button onclick="closeModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center text-sm font-bold">
          ✕
        </button>
      </div>

      <form id="emp-form" class="space-y-4">
        <input type="hidden" id="emp-id" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">NIK / ID Karyawan</label>
            <input type="text" id="emp-nik" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs" required placeholder="EMP-007" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap</label>
            <input type="text" id="emp-name" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs" required placeholder="Nama Karyawan" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Jabatan / Posisi</label>
            <input type="text" id="emp-position" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs" placeholder="Staff Operasional / Kasir" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">No. Telepon</label>
            <input type="text" id="emp-phone" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs" placeholder="08123456789" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Mulai Bekerja</label>
          <input type="date" id="emp-join-date" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs" required />
        </div>

        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-3">
          <span class="text-[11px] font-bold text-slate-900 uppercase tracking-wider block">Skema Payroll & Gajian</span>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Sistem Penggajian</label>
              <select id="emp-scheme" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white" required>
                <option value="per_jam">Per Jam (Hourly)</option>
                <option value="harian">Harian (Daily)</option>
                <option value="mingguan">Mingguan (Weekly)</option>
                <option value="bulanan">Bulanan (Monthly)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Besaran Upah/Tarif (IDR)</label>
              <input type="text" inputmode="numeric" id="emp-rate" oninput="formatRupiahInput(this)" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold" required placeholder="Contoh: 50.000" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Aturan Tanggal Gajian</label>
              <select id="emp-payday" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white" required>
                <option value="25">Tiap Tanggal 25 (Standar Bulanan/Jam)</option>
                <option value="1">Tiap Tanggal 1 (Awal Bulan)</option>
                <option value="10">Tiap Tanggal 10</option>
                <option value="15">Tiap Tanggal 15</option>
                <option value="28">Tiap Tanggal 28 (Akhir Bulan)</option>
                <option value="jumat">Tiap Hari Jumat (Mingguan)</option>
                <option value="senin">Tiap Hari Senin</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Tunjangan Tetap (IDR)</label>
              <input type="text" inputmode="numeric" id="emp-allowance" oninput="formatRupiahInput(this)" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white font-bold" placeholder="0" />
            </div>
          </div>
        </div>

        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-3">
          <span class="text-[11px] font-bold text-slate-900 uppercase tracking-wider block">Rekening Bank Penggajian</span>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <div>
              <label class="block text-[11px] font-semibold text-slate-600 mb-1">Nama Bank / E-Wallet</label>
              <input type="text" id="emp-bank-name" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white" placeholder="BCA / Mandiri / BRI" />
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-600 mb-1">Nomor Rekening</label>
              <input type="text" id="emp-bank-acc" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white font-mono" placeholder="1234567890" />
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-600 mb-1">Atas Nama Rekening</label>
              <input type="text" id="emp-bank-holder" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white" placeholder="Nama Pemilik Rekening" />
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-4 border-t border-slate-100">
          <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
            Batal
          </button>
          <button type="submit" class="px-4 py-2 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white transition shadow-sm">
            Simpan Karyawan
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Account Modal (Add / Edit Login Account) -->
  <div id="account-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-7 shadow-xl border border-slate-200 relative">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
        <div>
          <h3 id="account-modal-title" class="text-base font-bold text-slate-900">Kelola Akun Login Karyawan</h3>
          <p class="text-xs text-slate-500 mt-0.5">Atur nama pengguna dan kata sandi untuk login karyawan</p>
        </div>
        <button type="button" onclick="closeAccountModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center text-sm font-bold">
          ✕
        </button>
      </div>

      <form id="account-form" class="space-y-4">
        <input type="hidden" id="acc-employee-id" />

        <!-- Info Karyawan -->
        <div class="p-3 bg-slate-50 rounded-2xl border border-slate-100 flex items-center justify-between text-xs">
          <div>
            <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Karyawan</span>
            <strong id="acc-emp-name" class="text-slate-900 font-bold">Nama Karyawan</strong>
          </div>
          <div class="text-right">
            <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">NIK</span>
            <span id="acc-emp-nik" class="font-mono text-slate-700 font-semibold">EMP-001</span>
          </div>
        </div>

        <div>
          <label for="acc-username" class="block text-xs font-semibold text-slate-700 mb-1">
            Nama Pengguna (Username Login)
          </label>
          <input
            type="text"
            id="acc-username"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white"
            required
            placeholder="Contoh: budi atau jamal"
          />
          <p class="text-[10px] text-slate-400 mt-1">Digunakan untuk login ke sistem.</p>
        </div>

        <div>
          <label for="acc-email" class="block text-xs font-semibold text-slate-700 mb-1">
            Email Login
          </label>
          <input
            type="email"
            id="acc-email"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white"
            required
            placeholder="karyawan@fermi.io"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="acc-password" class="block text-xs font-semibold text-slate-700">
              Kata Sandi (Password)
            </label>
            <span class="text-[10px] text-indigo-600 font-medium">Bisa diubah</span>
          </div>
          <input
            type="text"
            id="acc-password"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white"
            placeholder="Masukkan kata sandi (contoh: 123)"
            required
          />
          <p class="text-[10px] text-slate-400 mt-1">Standar login demo: 123</p>
        </div>

        <div id="account-error" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium"></div>

        <div class="flex items-center justify-end gap-2 pt-4 border-t border-slate-100">
          <button
            type="button"
            onclick="closeAccountModal()"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition"
          >
            Batal
          </button>
          <button
            type="submit"
            id="btn-save-account"
            class="px-4 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white transition shadow-sm"
          >
            Simpan Akun
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function formatRupiahInput(el) {
      const cursor = el.selectionStart;
      const prevLen = el.value.length;
      const raw = el.value.replace(/\D/g, '');
      if (!raw) {
        el.value = '';
        return;
      }
      const formatted = new Intl.NumberFormat('id-ID').format(Number(raw));
      el.value = formatted;
      const diff = formatted.length - prevLen;
      const newPos = Math.max(0, (cursor || 0) + diff);
      try {
        el.setSelectionRange(newPos, newPos);
      } catch (e) {}
    }

    function getRawNumber(input) {
      if (!input) return 0;
      const str = typeof input === 'object' && 'value' in input ? input.value : String(input);
      return Number(str.replace(/\D/g, '')) || 0;
    }

    const modal = document.getElementById('emp-modal');
    const form = document.getElementById('emp-form');
    const accModal = document.getElementById('account-modal');
    const accForm = document.getElementById('account-form');
    const accError = document.getElementById('account-error');

    window.openModal = function () {
      form.reset();
      document.getElementById('emp-id').value = '';
      document.getElementById('emp-position').value = '';
      document.getElementById('emp-rate').value = '';
      document.getElementById('emp-allowance').value = '0';
      document.getElementById('emp-bank-name').value = '';
      document.getElementById('emp-bank-acc').value = '';
      document.getElementById('emp-bank-holder').value = '';
      document.getElementById('modal-title').textContent = 'Tambah Karyawan Baru';
      document.getElementById('emp-join-date').value = new Date().toISOString().split('T')[0];
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    };

    window.closeModal = function () {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    };

    window.editEmployee = function (emp) {
      document.getElementById('emp-id').value = emp.id;
      document.getElementById('emp-nik').value = emp.nik;
      document.getElementById('emp-name').value = emp.name;
      document.getElementById('emp-position').value = emp.position || '';
      document.getElementById('emp-phone').value = emp.phone || '';
      document.getElementById('emp-join-date').value = emp.join_date;
      document.getElementById('emp-scheme').value = emp.scheme;
      document.getElementById('emp-rate').value = emp.base_rate ? new Intl.NumberFormat('id-ID').format(Number(emp.base_rate)) : '';
      document.getElementById('emp-payday').value = emp.payday_rule;
      document.getElementById('emp-allowance').value = emp.fixed_allowance ? new Intl.NumberFormat('id-ID').format(Number(emp.fixed_allowance)) : '0';
      document.getElementById('emp-bank-name').value = emp.bank_name || '';
      document.getElementById('emp-bank-acc').value = emp.bank_account_number || '';
      document.getElementById('emp-bank-holder').value = emp.bank_account_holder || '';

      document.getElementById('modal-title').textContent = 'Edit Data Karyawan';
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    };

    window.deactivateEmployee = async function (id, name) {
      if (!confirm(`Apakah Anda yakin ingin menonaktifkan karyawan ${name}?`)) return;
      try {
        const res = await fetch(`/api/karyawan?id=${id}&action=deactivate`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (window.showToast) window.showToast(`Karyawan ${name} dinonaktifkan`);
          setTimeout(() => window.location.reload(), 800);
        } else {
          alert(data.error || 'Gagal menonaktifkan karyawan');
        }
      } catch (e) {
        alert('Gagal menghubungi server');
      }
    };

    window.activateEmployee = async function (id, name) {
      try {
        const res = await fetch(`/api/karyawan?id=${id}&action=activate`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (window.showToast) window.showToast(`Karyawan ${name} berhasil diaktifkan kembali`);
          setTimeout(() => window.location.reload(), 800);
        } else {
          alert(data.error || 'Gagal mengaktifkan karyawan');
        }
      } catch (e) {
        alert('Gagal menghubungi server');
      }
    };

    window.deleteEmployee = async function (id, name) {
      if (!confirm(`Apakah Anda yakin ingin menghapus permanen data karyawan ${name}? Seluruh data absensi, slip gaji, dan akun login karyawan ini akan ikut terhapus.`)) return;
      try {
        const res = await fetch(`/api/karyawan?id=${id}&action=delete`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (window.showToast) window.showToast(data.message || `Karyawan ${name} berhasil dihapus`);
          setTimeout(() => window.location.reload(), 800);
        } else {
          alert(data.error || 'Gagal menghapus data karyawan');
        }
      } catch (e) {
        alert('Gagal menghubungi server');
      }
    };

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          id: document.getElementById('emp-id').value || undefined,
          nik: document.getElementById('emp-nik').value,
          name: document.getElementById('emp-name').value,
          position: document.getElementById('emp-position').value.trim() || undefined,
          phone: document.getElementById('emp-phone').value,
          join_date: document.getElementById('emp-join-date').value,
          scheme: document.getElementById('emp-scheme').value,
          base_rate: getRawNumber(document.getElementById('emp-rate')),
          payday_rule: document.getElementById('emp-payday').value,
          fixed_allowance: getRawNumber(document.getElementById('emp-allowance')),
          bank_name: document.getElementById('emp-bank-name').value.trim() || undefined,
          bank_account_number: document.getElementById('emp-bank-acc').value.trim() || undefined,
          bank_account_holder: document.getElementById('emp-bank-holder').value.trim() || undefined,
        };

        try {
          const res = await fetch('/api/karyawan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            closeModal();
            if (window.showToast) window.showToast(data.message);
            setTimeout(() => window.location.reload(), 1000);
          } else {
            alert(data.error || 'Gagal menyimpan data');
          }
        } catch (e) {
          alert('Gagal menghubungi server');
        }
      });
    }

    // Account Modal Handlers
    window.openAccountModal = function (emp) {
      if (accError) accError.classList.add('hidden');
      const defaultUsername = emp.username || emp.name.toLowerCase().replace(/[^a-z0-9]/g, '');
      document.getElementById('acc-employee-id').value = emp.id;
      document.getElementById('acc-emp-name').textContent = emp.name;
      document.getElementById('acc-emp-nik').textContent = emp.nik;
      document.getElementById('acc-username').value = defaultUsername;
      document.getElementById('acc-email').value = emp.user_email || `${defaultUsername}@fermi.io`;
      document.getElementById('acc-password').value = emp.user_password || '123';

      const title = emp.username ? `Edit Akun: ${emp.name}` : `Buat Akun: ${emp.name}`;
      document.getElementById('account-modal-title').textContent = title;

      if (accModal) {
        accModal.classList.remove('hidden');
        accModal.classList.add('flex');
      }
    };

    window.closeAccountModal = function () {
      if (accModal) {
        accModal.classList.add('hidden');
        accModal.classList.remove('flex');
      }
    };

    if (accForm) {
      accForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (accError) accError.classList.add('hidden');

        const payload = {
          employee_id: Number(document.getElementById('acc-employee-id').value),
          username: document.getElementById('acc-username').value.trim(),
          email: document.getElementById('acc-email').value.trim(),
          password: document.getElementById('acc-password').value.trim(),
        };

        try {
          const res = await fetch('/api/karyawan/account', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            closeAccountModal();
            if (window.showToast) window.showToast(data.message);
            setTimeout(() => window.location.reload(), 1000);
          } else {
            if (accError) {
              accError.textContent = data.error || 'Gagal menyimpan akun karyawan';
              accError.classList.remove('hidden');
            }
          }
        } catch (err) {
          if (accError) {
            accError.textContent = 'Gagal menghubungi server';
            accError.classList.remove('hidden');
          }
        }
      });
    }
  </script>
</Layout>
