  <script is:inline>
    let currentStatus = 'hari_ini_bayar';
    let currentScheme = 'all';

    function formatRupiahJs(amount) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(amount);
    }

    function formatRupiahInput(el) {
      const cursor = el.selectionStart;
      const prevLen = el.value.length;
      const raw = el.value.replace(/\D/g, '');
      if (!raw) {
        el.value = '';
        return;
      }
      const formatted = new Intl.NumberFormat('id-ID').format(Number(raw));
      el.value = formatted;
      const diff = formatted.length - prevLen;
      const newPos = Math.max(0, (cursor || 0) + diff);
      try {
        el.setSelectionRange(newPos, newPos);
      } catch (e) {}
    }

    function getRawNumber(input) {
      if (!input) return 0;
      const str = typeof input === 'object' && 'value' in input ? input.value : String(input);
      return Number(str.replace(/\D/g, '')) || 0;
    }

    window.filterStatus = function(status, btnEl) {
      currentStatus = status;
      document.querySelectorAll('.status-tab').forEach((b) => {
        b.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
        b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      });
      if (btnEl) {
        btnEl.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
        btnEl.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');
      }
      applyFilters();
    };

    window.toggleEmpDropdown = function() {
      const menu = document.getElementById('empDropdownMenu');
      const arrow = document.getElementById('empDropdownArrow');
      if (!menu) return;
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        if (arrow) arrow.classList.add('rotate-180');
        const searchInput = document.getElementById('empSearchInDropdown');
        if (searchInput) {
          searchInput.value = '';
          filterEmpDropdownOptions('');
          setTimeout(() => searchInput.focus(), 50);
        }
      } else {
        menu.classList.add('hidden');
        if (arrow) arrow.classList.remove('rotate-180');
      }
    };

    window.filterEmpDropdownOptions = function(query) {
      const q = (query || '').toLowerCase().trim();
      const items = document.querySelectorAll('.emp-dropdown-item');
      items.forEach((item) => {
        const searchData = (item.getAttribute('data-search') || '').toLowerCase();
        if (!q || searchData.includes(q)) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    };

    window.selectEmpFilter = function(id, label) {
      const hiddenInput = document.getElementById('empFilter');
      const labelEl = document.getElementById('empDropdownLabel');
      const menu = document.getElementById('empDropdownMenu');
      const arrow = document.getElementById('empDropdownArrow');

      if (hiddenInput) hiddenInput.value = id;
      if (labelEl) labelEl.textContent = label;
      if (menu) menu.classList.add('hidden');
      if (arrow) arrow.classList.remove('rotate-180');

      applyFilters();
    };

    document.addEventListener('click', (e) => {
      const container = document.getElementById('empDropdownContainer');
      const menu = document.getElementById('empDropdownMenu');
      const arrow = document.getElementById('empDropdownArrow');
      if (container && menu && !container.contains(e.target)) {
        menu.classList.add('hidden');
        if (arrow) arrow.classList.remove('rotate-180');
      }
    });

    window.clearDateFilter = function() {
      const s = document.getElementById('startDateFilter');
      const e = document.getElementById('endDateFilter');
      if (s) s.value = '';
      if (e) e.value = '';
      applyFilters();
    };

    window.applyFilters = function() {
      const schemeSelect = document.getElementById('schemeFilter');
      if (schemeSelect) currentScheme = schemeSelect.value;

      const empSelect = document.getElementById('empFilter');
      const empVal = empSelect ? empSelect.value : '';

      const startDateInput = document.getElementById('startDateFilter');
      const endDateInput = document.getElementById('endDateFilter');
      const startDateVal = startDateInput ? startDateInput.value : '';
      const endDateVal = endDateInput ? endDateInput.value : '';

      const clearBtn = document.getElementById('clearDateBtn');
      if (clearBtn) {
        if (startDateVal || endDateVal) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }

      const rows = document.querySelectorAll('.payroll-row');
      let totalVisibleItems = 0;
      let countHariIni = 0;
      let countBelumBayar = 0;
      let countBerlangsung = 0;
      const visibleCountByEmp = new Map();

      rows.forEach((r) => {
        const rowStatus = r.dataset.status;
        const rowScheme = r.dataset.scheme;
        const rowEmpId = r.dataset.empId;
        const pStart = r.dataset.periodStart || '';
        const pEnd = r.dataset.periodEnd || '';

        const matchScheme = currentScheme === 'all' || rowScheme === currentScheme;
        const matchEmp = !empVal || rowEmpId === empVal;

        let matchDate = true;
        if (startDateVal && endDateVal) {
          const minDate = startDateVal <= endDateVal ? startDateVal : endDateVal;
          const maxDate = startDateVal <= endDateVal ? endDateVal : startDateVal;
          const itemStart = pStart || pEnd || '';
          const itemEnd = pEnd || pStart || '';
          matchDate = !(itemEnd < minDate || itemStart > maxDate);
        } else if (startDateVal) {
          const itemEnd = pEnd || pStart || '';
          matchDate = itemEnd >= startDateVal;
        } else if (endDateVal) {
          const itemStart = pStart || pEnd || '';
          matchDate = itemStart <= endDateVal;
        }

        // Hitung badge dinamis berdasarkan kriteria filter aktif (skema, karyawan, tanggal)
        if (matchScheme && matchEmp && matchDate) {
          if (rowStatus === 'hari_ini_bayar') countHariIni++;
          else if (rowStatus === 'belum_terbayar') countBelumBayar++;
          else if (rowStatus === 'sedang_berlangsung') countBerlangsung++;
        }

        const matchStatus = currentStatus === 'all' || rowStatus === currentStatus;

        if (matchStatus && matchScheme && matchEmp && matchDate) {
          r.style.display = '';
          totalVisibleItems++;
          visibleCountByEmp.set(rowEmpId, (visibleCountByEmp.get(rowEmpId) || 0) + 1);
        } else {
          r.style.display = 'none';
          const cb = r.querySelector('.row-checkbox');
          if (cb) cb.checked = false;
        }
      });

      // Update angka counting pada ketiga badge filter
      const badgeHariIniEl = document.getElementById('badgeCountHariIni');
      if (badgeHariIniEl) badgeHariIniEl.textContent = countHariIni;

      const badgeBelumBayarEl = document.getElementById('badgeCountBelumBayar');
      if (badgeBelumBayarEl) badgeBelumBayarEl.textContent = countBelumBayar;

      const badgeBerlangsungEl = document.getElementById('badgeCountBerlangsung');
      if (badgeBerlangsungEl) badgeBerlangsungEl.textContent = countBerlangsung;

      // Perbarui heading karyawan: tampil jika ada tagihan yang cocok dengan filter aktif
      const headerRows = document.querySelectorAll('.group-header-row');
      headerRows.forEach((h) => {
        const empId = h.dataset.empId;
        const visibleRowsForEmp = Array.from(document.querySelectorAll(`.payroll-row[data-emp-id="${empId}"]`))
          .filter((r) => r.style.display !== 'none');
        const count = visibleRowsForEmp.length;
        if (count > 0) {
          h.style.display = '';
          const countEl = h.querySelector('.group-count');
          if (countEl) countEl.innerText = `${count} Tagihan`;
          const totalEmp = visibleRowsForEmp.reduce((sum, r) => {
            const cb = r.querySelector('.row-checkbox');
            return sum + (Number(cb?.dataset.amount) || 0);
          }, 0);
          const totalEl = h.querySelector('.group-total-amount');
          if (totalEl) totalEl.innerText = formatRupiahJs(totalEmp);
        } else {
          h.style.display = 'none';
          const groupCb = h.querySelector('.group-checkbox');
          if (groupCb) groupCb.checked = false;
        }
      });

      const countEl = document.getElementById('visibleRowCount');
      if (countEl) countEl.innerText = totalVisibleItems;

      const emptyEl = document.getElementById('emptyFilterMsg');
      if (emptyEl) {
        emptyEl.style.display = totalVisibleItems === 0 ? '' : 'none';
      }

      updateAllSelectionUI();
    };

    window.toggleMasterSelectAll = function(masterEl) {
      const isChecked = masterEl.checked;
      const visibleRows = Array.from(document.querySelectorAll('.payroll-row')).filter(r => r.style.display !== 'none');
      visibleRows.forEach(r => {
        const cb = r.querySelector('.row-checkbox');
        if (cb) cb.checked = isChecked;
      });
      updateAllSelectionUI();
    };

    window.toggleGroupCheckbox = function(groupEl) {
      const empId = groupEl.dataset.empId;
      const isChecked = groupEl.checked;
      const visibleRows = Array.from(document.querySelectorAll(`.payroll-row[data-emp-id="${empId}"]`)).filter(r => r.style.display !== 'none');
      visibleRows.forEach(r => {
        const cb = r.querySelector('.row-checkbox');
        if (cb) cb.checked = isChecked;
      });
      updateAllSelectionUI();
    };

    window.onRowCheckboxChange = function() {
      updateAllSelectionUI();
    };

    function updateAllSelectionUI() {
      const visibleRows = Array.from(document.querySelectorAll('.payroll-row')).filter(r => r.style.display !== 'none');
      const allCheckedRows = visibleRows.filter(r => {
        const cb = r.querySelector('.row-checkbox');
        return cb && cb.checked;
      });

      // Master select all checkbox
      const masterCb = document.getElementById('masterSelectAll');
      if (masterCb) {
        if (visibleRows.length === 0) {
          masterCb.checked = false;
          masterCb.indeterminate = false;
        } else if (allCheckedRows.length === visibleRows.length) {
          masterCb.checked = true;
          masterCb.indeterminate = false;
        } else if (allCheckedRows.length > 0) {
          masterCb.checked = false;
          masterCb.indeterminate = true;
        } else {
          masterCb.checked = false;
          masterCb.indeterminate = false;
        }
      }

      // Master batch pay button
      const batchBar = document.getElementById('batchPayBar');
      const countText = document.getElementById('selectedCountText');
      const amountText = document.getElementById('selectedAmountText');
      if (batchBar && countText && amountText) {
        if (allCheckedRows.length > 0) {
          batchBar.classList.remove('hidden');
          batchBar.classList.add('flex');
          countText.innerText = allCheckedRows.length;
          const totalAmount = allCheckedRows.reduce((sum, r) => {
            const cb = r.querySelector('.row-checkbox');
            return sum + (Number(cb?.dataset.amount) || 0);
          }, 0);
          amountText.innerText = formatRupiahJs(totalAmount);
        } else {
          batchBar.classList.add('hidden');
          batchBar.classList.remove('flex');
        }
      }

      // Per-group checkbox & inline button states
      const groupRows = document.querySelectorAll('.group-header-row');
      groupRows.forEach(h => {
        const empId = h.dataset.empId;
        const groupCb = h.querySelector('.group-checkbox');
        const groupBtn = document.getElementById(`btn-bayar-group-${empId}`);

        const empVisibleRows = visibleRows.filter(r => r.dataset.empId === empId);
        const empCheckedRows = empVisibleRows.filter(r => {
          const cb = r.querySelector('.row-checkbox');
          return cb && cb.checked;
        });

        if (groupCb) {
          if (empVisibleRows.length === 0) {
            groupCb.checked = false;
            groupCb.indeterminate = false;
          } else if (empCheckedRows.length === empVisibleRows.length) {
            groupCb.checked = true;
            groupCb.indeterminate = false;
          } else if (empCheckedRows.length > 0) {
            groupCb.checked = false;
            groupCb.indeterminate = true;
          } else {
            groupCb.checked = false;
            groupCb.indeterminate = false;
          }
        }

        if (groupBtn) {
          if (empCheckedRows.length > 0) {
            groupBtn.classList.remove('hidden');
            const empTotal = empCheckedRows.reduce((sum, r) => {
              const cb = r.querySelector('.row-checkbox');
              return sum + (Number(cb?.dataset.amount) || 0);
            }, 0);
            groupBtn.innerHTML = `
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Bayar (${empCheckedRows.length}) • ${formatRupiahJs(empTotal)}</span>
            `;
          } else {
            groupBtn.classList.add('hidden');
          }
        }
      });
    }

    window.payGroupBills = async function(empId) {
      const headerRow = document.querySelector(`.group-header-row[data-emp-id="${empId}"]`);
      const empName = headerRow ? headerRow.dataset.empRealName : 'Karyawan';

      const visibleRowCbs = Array.from(document.querySelectorAll(`.payroll-row[data-emp-id="${empId}"]`))
        .filter(r => r.style.display !== 'none')
        .map(r => r.querySelector('.row-checkbox'))
        .filter(cb => cb && cb.checked);

      if (visibleRowCbs.length === 0) {
        alert('Silakan pilih setidaknya satu tagihan untuk dibayarkan.');
        return;
      }

      const items = visibleRowCbs.map(cb => ({
        employee_id: Number(cb.dataset.empId),
        scheme: cb.dataset.scheme,
        total_units: Number(cb.dataset.units) || 1,
        rate: Number(cb.dataset.rate) || 0,
        amount_paid: Number(cb.dataset.amount) || 0,
        period_start: cb.dataset.periodStart,
        period_end: cb.dataset.periodEnd,
        notes: `Pembayaran ${cb.dataset.scheme} untuk ${empName} (${cb.dataset.periodStart} s/d ${cb.dataset.periodEnd})`,
      }));

      const totalAmount = items.reduce((acc, it) => acc + it.amount_paid, 0);

      if (!confirm(`Konfirmasi pembayaran ${items.length} tagihan untuk ${empName}?\nTotal Tagihan: ${formatRupiahJs(totalAmount)}`)) {
        return;
      }

      try {
        const res = await fetch('/api/payroll/settle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (window.showToast) window.showToast(`${items.length} tagihan ${empName} berhasil dibayarkan!`);
          else alert(`${items.length} tagihan ${empName} berhasil dibayarkan!`);
          setTimeout(() => window.location.reload(), 1000);
        } else {
          alert(data.error || 'Gagal memproses pembayaran');
        }
      } catch (e) {
        alert('Gagal menghubungi server');
      }
    };

    window.payAllSelectedBills = async function() {
      const visibleRowCbs = Array.from(document.querySelectorAll('.payroll-row'))
        .filter(r => r.style.display !== 'none')
        .map(r => r.querySelector('.row-checkbox'))
        .filter(cb => cb && cb.checked);

      if (visibleRowCbs.length === 0) {
        alert('Silakan centang tagihan yang ingin dibayarkan terlebih dahulu.');
        return;
      }

      const items = visibleRowCbs.map(cb => ({
        employee_id: Number(cb.dataset.empId),
        scheme: cb.dataset.scheme,
        total_units: Number(cb.dataset.units) || 1,
        rate: Number(cb.dataset.rate) || 0,
        amount_paid: Number(cb.dataset.amount) || 0,
        period_start: cb.dataset.periodStart,
        period_end: cb.dataset.periodEnd,
        notes: `Pembayaran ${cb.dataset.scheme} untuk ${cb.dataset.empName} (${cb.dataset.periodStart} s/d ${cb.dataset.periodEnd})`,
      }));

      const totalAmount = items.reduce((acc, it) => acc + it.amount_paid, 0);

      if (!confirm(`Konfirmasi pembayaran ${items.length} tagihan terpilih?\nTotal Pembayaran: ${formatRupiahJs(totalAmount)}`)) {
        return;
      }

      try {
        const res = await fetch('/api/payroll/settle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (window.showToast) window.showToast(`${items.length} tagihan berhasil dibayarkan!`);
          else alert(`${items.length} tagihan berhasil dibayarkan!`);
          setTimeout(() => window.location.reload(), 1000);
        } else {
          alert(data.error || 'Gagal memproses pembayaran batch');
        }
      } catch (e) {
        alert('Gagal menghubungi server');
      }
    };

    let modalCalculatedBase = 0;
    let modalCurrentActiveCashbon = 0;

    window.openSettleModal = function (empId, empName, empNik, position, scheme, baseAmount, rate, units, periodStart, periodEnd, fixedAllowance, activeCashbon) {
      document.getElementById('modalEmpId').value = empId;
      document.getElementById('modalScheme').value = scheme;
      document.getElementById('modalTotalUnits').value = units;
      document.getElementById('modalRate').value = rate;
      document.getElementById('modalPeriodStart').value = periodStart;
      document.getElementById('modalPeriodEnd').value = periodEnd;

      document.getElementById('modalEmpName').textContent = empName;
      document.getElementById('modalEmpSub').textContent = `NIK: ${empNik}${position ? ' • ' + position : ''} • Skema: ${scheme.replace('_', ' ')}`;
      
      const periodLabel = periodStart === periodEnd ? periodStart : `${periodStart} s/d ${periodEnd}`;
      document.getElementById('modalPeriodText').textContent = periodLabel;

      modalCalculatedBase = Number(baseAmount) || 0;
      modalCurrentActiveCashbon = Number(activeCashbon) || 0;

      const unitText = scheme === 'per_jam' ? 'Jam' : scheme === 'harian' ? 'Hari' : scheme === 'mingguan' ? 'Minggu' : 'Bulan';
      document.getElementById('modalBaseWageDetail').textContent = `${units} ${unitText} × ${formatRupiahJs(rate)}`;
      document.getElementById('modalBaseWageDisplay').textContent = formatRupiahJs(modalCalculatedBase);

      document.getElementById('modalAllowance').value = fixedAllowance ? new Intl.NumberFormat('id-ID').format(Number(fixedAllowance)) : '0';
      document.getElementById('modalOvertime').value = '0';
      document.getElementById('modalBonus').value = '0';

      document.getElementById('modalActiveCashbonBadge').textContent = formatRupiahJs(modalCurrentActiveCashbon);
      // Auto pre-fill cashbon deduction if employee has cashbon balance
      const suggestedDeduction = Math.min(modalCalculatedBase + (Number(fixedAllowance) || 0), modalCurrentActiveCashbon);
      document.getElementById('modalCashbonDeduction').value = suggestedDeduction ? new Intl.NumberFormat('id-ID').format(suggestedDeduction) : '0';

      document.getElementById('modalNotes').value = `Gaji ${scheme.replace('_', ' ')} (${periodLabel})`;

      calcModalTotal();
      document.getElementById('settleModal').classList.remove('hidden');
    };

    window.closeSettleModal = function () {
      document.getElementById('settleModal').classList.add('hidden');
    };

    window.calcModalTotal = function () {
      const allowance = getRawNumber(document.getElementById('modalAllowance'));
      const overtime = getRawNumber(document.getElementById('modalOvertime'));
      const bonus = getRawNumber(document.getElementById('modalBonus'));
      let cashbonDed = getRawNumber(document.getElementById('modalCashbonDeduction'));

      if (cashbonDed > modalCurrentActiveCashbon) {
        cashbonDed = modalCurrentActiveCashbon;
        document.getElementById('modalCashbonDeduction').value = new Intl.NumberFormat('id-ID').format(cashbonDed);
      }

      const totalGross = modalCalculatedBase + allowance + overtime + bonus;
      const totalNet = Math.max(0, totalGross - cashbonDed);

      document.getElementById('modalNetWageDisplay').textContent = formatRupiahJs(totalNet);
      return { totalGross, totalNet, allowance, overtime, bonus, cashbonDed };
    };

    window.submitSettleForm = async function (e) {
      e.preventDefault();
      const { totalNet, allowance, overtime, bonus, cashbonDed } = calcModalTotal();
      const empId = Number(document.getElementById('modalEmpId').value);
      const scheme = document.getElementById('modalScheme').value;
      const units = Number(document.getElementById('modalTotalUnits').value) || 1;
      const rate = Number(document.getElementById('modalRate').value) || 0;
      const pStart = document.getElementById('modalPeriodStart').value;
      const pEnd = document.getElementById('modalPeriodEnd').value;
      const notes = document.getElementById('modalNotes').value;
      const btn = document.getElementById('modalSubmitBtn');

      btn.disabled = true;
      btn.textContent = 'Memproses...';

      try {
        const res = await fetch('/api/payroll/settle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            employee_id: empId,
            scheme,
            total_units: units,
            rate,
            amount_paid: totalNet,
            allowance,
            overtime_pay: overtime,
            bonus,
            cashbon_deduction: cashbonDed,
            period_start: pStart,
            period_end: pEnd,
            notes,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal memproses pembayaran');

        window.showToast?.('Pembayaran berhasil dibukukan!');
        closeSettleModal();
        setTimeout(() => location.reload(), 800);
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.textContent = 'Bayar & Terbitkan Slip';
      }
    };

    let activePrintSlip = null;
    window.printSettlementSlip = function (slipData) {
      activePrintSlip = slipData;
      document.getElementById('slipModalNo').textContent = `#PAY-${slipData.id}`;
      document.getElementById('slipModalDate').textContent = slipData.date;
      document.getElementById('slipModalName').textContent = slipData.name;
      document.getElementById('slipModalNikPos').textContent = `NIK: ${slipData.nik} • ${slipData.position}`;
      document.getElementById('slipModalPeriod').textContent = slipData.period;
      document.getElementById('slipModalScheme').textContent = `Gaji ${slipData.scheme}`;

      document.getElementById('slipModalBaseDesc').textContent = `Gaji Pokok (${slipData.units}):`;
      document.getElementById('slipModalBaseAmount').textContent = slipData.baseWage;
      document.getElementById('slipModalAllowance').textContent = slipData.allowance;
      document.getElementById('slipModalOvertime').textContent = slipData.overtime;
      document.getElementById('slipModalBonus').textContent = slipData.bonus;
      document.getElementById('slipModalCashbon').textContent = `-${slipData.cashbon}`;
      document.getElementById('slipModalNet').textContent = slipData.totalNet;

      document.getElementById('slipModal').classList.remove('hidden');
    };

    window.closeSlipModal = function () {
      document.getElementById('slipModal').classList.add('hidden');
    };

