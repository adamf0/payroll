---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser } from '../../lib/auth';
import { computeAllRealtimePayroll, formatRupiah, formatIndonesianDate, getJakartaTodayStr } from '../../lib/payroll';
import type { PayrollSettlement, Employee } from '../../lib/types';
import { queryAll } from '../../lib/db';

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || currentUser.role !== 'admin') {
  return Astro.redirect('/login');
}

const payrollItems = await computeAllRealtimePayroll();
const totalAccrued = payrollItems.reduce((sum, item) => sum + (Number(item.accrued_amount) || 0), 0);

const todayStr = getJakartaTodayStr();

// Helper: Tentukan kategori status tagihan (hari ini bayar, belum terbayar, sedang berlangsung)
function getItemStatus(item: typeof payrollItems[0]): 'hari_ini_bayar' | 'belum_terbayar' | 'sedang_berlangsung' {
  const isDailyOrHourly = item.employee.scheme === 'per_jam' || item.employee.scheme === 'harian';
  if (isDailyOrHourly) {
    return item.period_end === todayStr ? 'hari_ini_bayar' : 'belum_terbayar';
  }
  // Mingguan / Bulanan
  // 1. Jika hari ini adalah hari/tanggal gajian:
  if (item.next_payday === todayStr) {
    return 'hari_ini_bayar';
  }
  // 2. Jika periode sudah berakhir atau hari gajian sudah lewat di masa lalu:
  if ((item.period_end && item.period_end < todayStr) || (item.next_payday && item.next_payday < todayStr)) {
    return 'belum_terbayar';
  }
  // 3. Sisanya adalah siklus berjalan yang belum jatuh tempo gajian:
  return 'sedang_berlangsung';
}

const enrichedItems = payrollItems.map((item) => ({
  ...item,
  statusCategory: getItemStatus(item),
}));

// Hitung total item per kategori status (default filter tanggal: hari ini)
const initialDefaultItems = enrichedItems.filter((i) => {
  const pStart = i.period_start || i.period_end || '';
  const pEnd = i.period_end || i.period_start || '';
  return !(pEnd < todayStr || pStart > todayStr);
});
const countHariIni = initialDefaultItems.filter((i) => i.statusCategory === 'hari_ini_bayar').length;
const countBelumBayar = initialDefaultItems.filter((i) => i.statusCategory === 'belum_terbayar').length;
const countBerlangsung = initialDefaultItems.filter((i) => i.statusCategory === 'sedang_berlangsung').length;

// Kelompokkan data per nama karyawan
interface EmployeeGroup {
  employee: Employee;
  items: typeof enrichedItems;
  totalAmount: number;
}

const employeeGroupsMap = new Map<number, EmployeeGroup>();
for (const item of enrichedItems) {
  if (!employeeGroupsMap.has(item.employee.id)) {
    employeeGroupsMap.set(item.employee.id, {
      employee: item.employee,
      items: [],
      totalAmount: 0,
    });
  }
  const grp = employeeGroupsMap.get(item.employee.id)!;
  grp.items.push(item);
  grp.totalAmount += Number(item.accrued_amount) || 0;
}
const employeeGroups = Array.from(employeeGroupsMap.values()).sort((a, b) => a.employee.name.localeCompare(b.employee.name));

// Unique employees untuk dropdown filter
const uniqueEmployees = employeeGroups.map((g) => g.employee);

// Fetch active cashbon balances per employee
const activeCashbonRows = await queryAll<{
  employee_id: number;
  balance: number;
}>(
  `SELECT c.employee_id, SUM(c.amount_approved - COALESCE(r.total_repaid, 0)) AS balance
   FROM cashbon_requests c
   LEFT JOIN (
     SELECT cashbon_id, SUM(amount) AS total_repaid
     FROM cashbon_repayments
     GROUP BY cashbon_id
   ) r ON c.id = r.cashbon_id
   WHERE c.status IN ('approved', 'partial') AND c.disbursed_at IS NOT NULL
   GROUP BY c.employee_id
   HAVING balance > 0`
);
const cashbonMap = new Map<number, number>();
for (const row of activeCashbonRows) {
  cashbonMap.set(row.employee_id, Number(row.balance) || 0);
}

// Fetch recent settlements with breakdown components
const settlements = await queryAll<{
  id: number;
  employee_id: number;
  name: string;
  nik: string;
  position: string | null;
  period_start: string;
  period_end: string;
  scheme: string;
  total_units: number;
  rate: number;
  amount_paid: number;
  allowance: number;
  overtime_pay: number;
  bonus: number;
  cashbon_deduction: number;
  settled_at: string;
  notes: string | null;
}>(
  `SELECT s.*, e.name, e.nik, e.position
   FROM payroll_settlements s
   JOIN employees e ON s.employee_id = e.id
   ORDER BY s.id DESC LIMIT 50`
);
---

<Layout title="Kelola Gaji Karyawan" activeNav="admin-payroll">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Kelola Gaji Karyawan</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Pantau gaji berjalan karyawan. Dikelompokkan per karyawan dengan filter status tagihan.
        </p>
      </div>

      <div class="bg-indigo-50 border border-indigo-200 px-4 py-2.5 rounded-2xl text-left sm:text-right">
        <span class="text-[11px] font-semibold text-indigo-700 block">Total Gaji Belum Dibayar</span>
        <div class="text-xl font-extrabold text-indigo-900">{formatRupiah(totalAccrued)}</div>
      </div>
    </div>

    <!-- Tab Filter Status: Belum Terbayar, Hari Ini Bayar, Sedang Berlangsung -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-4 mb-6">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <!-- Status Tabs -->
        <div class="flex flex-wrap items-center gap-2" id="statusTabs">
          <button
            type="button"
            onclick="filterStatus('hari_ini_bayar', this)"
            class="status-tab px-3.5 py-2 rounded-xl text-xs font-bold transition bg-indigo-600 text-white shadow-sm flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Hari Ini Bayar (<span id="badgeCountHariIni">{countHariIni}</span>)
          </button>
          <button
            type="button"
            onclick="filterStatus('belum_terbayar', this)"
            class="status-tab px-3.5 py-2 rounded-xl text-xs font-bold transition bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Belum Terbayar (<span id="badgeCountBelumBayar">{countBelumBayar}</span>)
          </button>
          <button
            type="button"
            onclick="filterStatus('sedang_berlangsung', this)"
            class="status-tab px-3.5 py-2 rounded-xl text-xs font-bold transition bg-white text-slate-700 border border-slate-200 hover:bg-slate-50 flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            Sedang Berlangsung (<span id="badgeCountBerlangsung">{countBerlangsung}</span>)
          </button>
        </div>

        <!-- Filter Dropdown & Search -->
        <div class="flex flex-wrap items-center gap-2">
          <!-- Filter Skema -->
          <select
            id="schemeFilter"
            onchange="applyFilters()"
            class="px-3 py-2 rounded-xl border border-slate-200 text-xs font-medium text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            <option value="all">Semua Jenis Gaji</option>
            <option value="per_jam">Per Jam</option>
            <option value="harian">Harian</option>
            <option value="mingguan">Mingguan</option>
            <option value="bulanan">Bulanan</option>
          </select>

          <!-- Filter Karyawan (Searchable Dropdown) -->
          <div class="relative inline-block text-left" id="empDropdownContainer">
            <input type="hidden" id="empFilter" value="" />
            <button
              type="button"
              id="empDropdownBtn"
              onclick="toggleEmpDropdown()"
              class="flex items-center justify-between gap-2 px-3 py-2 rounded-xl border border-slate-200 text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer min-w-[190px] sm:min-w-[210px]"
            >
              <span id="empDropdownLabel" class="truncate font-semibold text-slate-800">
                Semua Karyawan ({uniqueEmployees.length})
              </span>
              <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0 transition-transform duration-150" id="empDropdownArrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- Floating Search Dropdown Menu -->
            <div
              id="empDropdownMenu"
              class="hidden absolute left-0 top-full mt-1.5 w-64 sm:w-72 bg-white rounded-2xl shadow-xl border border-slate-200 p-2.5 z-50"
            >
              <div class="relative mb-2">
                <input
                  type="text"
                  id="empSearchInDropdown"
                  oninput="filterEmpDropdownOptions(this.value)"
                  placeholder="Cari nama atau NIK..."
                  autocomplete="off"
                  class="w-full pl-8 pr-3 py-1.5 rounded-xl border border-slate-200 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50 placeholder:text-slate-400"
                />
                <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>

              <div class="max-h-56 overflow-y-auto space-y-0.5 divide-y divide-slate-50 text-xs" id="empDropdownList">
                <button
                  type="button"
                  onclick={`selectEmpFilter('', 'Semua Karyawan (${uniqueEmployees.length})')`}
                  class="emp-dropdown-item w-full text-left px-2.5 py-1.5 rounded-xl font-bold text-indigo-600 hover:bg-indigo-50 transition flex items-center justify-between cursor-pointer"
                  data-search="semua karyawan all"
                >
                  <span>Semua Karyawan</span>
                  <span class="text-[10px] text-slate-400 font-normal">{uniqueEmployees.length}</span>
                </button>
                {uniqueEmployees.map((emp) => (
                  <button
                    type="button"
                    onclick={`selectEmpFilter('${emp.id}', '${emp.name.replace(/'/g, "\\'")}')`}
                    class="emp-dropdown-item w-full text-left px-2.5 py-1.5 rounded-xl text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition flex items-center justify-between cursor-pointer"
                    data-search={`${emp.name.toLowerCase()} ${emp.nik.toLowerCase()} ${emp.scheme.toLowerCase()}`}
                  >
                    <div class="truncate">
                      <span class="font-semibold block truncate">{emp.name}</span>
                      <span class="text-[10px] text-slate-400">{emp.nik} • {emp.scheme.replace('_', ' ')}</span>
                    </div>
                    {emp.position && (
                      <span class="text-[10px] text-slate-400 flex-shrink-0 ml-1">{emp.position}</span>
                    )}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- Filter Rentang Tanggal -->
          <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-xl px-2.5 py-1.5 focus-within:ring-2 focus-within:ring-indigo-500 shadow-sm">
            <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <input
              type="date"
              id="startDateFilter"
              value={todayStr}
              onchange="applyFilters()"
              oninput="applyFilters()"
              class="text-xs font-medium text-slate-700 bg-transparent focus:outline-none cursor-pointer w-[110px] sm:w-auto"
              title="Dari Tanggal"
            />
            <span class="text-slate-300 text-xs">-</span>
            <input
              type="date"
              id="endDateFilter"
              value={todayStr}
              onchange="applyFilters()"
              oninput="applyFilters()"
              class="text-xs font-medium text-slate-700 bg-transparent focus:outline-none cursor-pointer w-[110px] sm:w-auto"
              title="Sampai Tanggal"
            />
            <button
              type="button"
              id="clearDateBtn"
              onclick="clearDateFilter()"
              class="text-slate-400 hover:text-rose-600 text-xs px-1 font-bold"
              title="Hapus filter tanggal"
            >
              ✕
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabel Gaji Berjalan dengan Heading Pengelompokan Karyawan -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden mb-10">
      <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-sm font-bold text-slate-900">
            Daftar Gaji Karyawan (<span id="visibleRowCount">{countHariIni}</span> Tagihan)
          </h2>
          <span class="text-[11px] text-slate-400">Dikelompokkan rapi per nama karyawan</span>
        </div>
        <!-- Tombol Bayar Batch untuk Tagihan Terpilih -->
        <div id="batchPayBar" class="hidden items-center gap-2">
          <button
            type="button"
            onclick="payAllSelectedBills()"
            class="px-3.5 py-1.5 rounded-xl font-bold text-xs bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition flex items-center gap-1.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>Bayar Tagihan Terpilih (<span id="selectedCountText">0</span> Tagihan • <span id="selectedAmountText">Rp 0</span>)</span>
          </button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50/60 border-b border-slate-100 text-slate-400 font-semibold uppercase tracking-wider">
              <th class="py-3 px-3 w-10 text-center">
                <input
                  type="checkbox"
                  id="masterSelectAll"
                  onchange="toggleMasterSelectAll(this)"
                  class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer"
                  title="Pilih seluruh tagihan"
                />
              </th>
              <th class="py-3 px-4">Nama Karyawan</th>
              <th class="py-3 px-4">Periode / Tanggal</th>
              <th class="py-3 px-4">Jenis Gaji</th>
              <th class="py-3 px-4">Tarif</th>
              <th class="py-3 px-4">Data Kehadiran</th>
              <th class="py-3 px-4">Status & Jadwal</th>
              <th class="py-3 px-4">Gaji Siap Bayar</th>
              <th class="py-3 px-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="payrollTableBody">
            {employeeGroups.map((grp) => {
              const hariIniItems = grp.items.filter((i) => i.statusCategory === 'hari_ini_bayar');
              const initialSum = hariIniItems.reduce((s, it) => s + (Number(it.accrued_amount) || 0), 0);
              return (
                <>
                  {/* Heading Pengelompokan Karyawan */}
                  <tr
                    class="group-header-row bg-slate-100/90 border-t-2 border-b border-slate-200"
                    data-group-header="true"
                    data-emp-id={grp.employee.id.toString()}
                    data-emp-real-name={grp.employee.name}
                    data-scheme={grp.employee.scheme}
                    data-emp-name={grp.employee.name.toLowerCase()}
                    style={hariIniItems.length > 0 ? '' : 'display: none;'}
                  >
                    <td colspan="9" class="py-2.5 px-4">
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div class="flex items-center gap-3">
                          <input
                            type="checkbox"
                            class="group-checkbox w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer"
                            data-emp-id={grp.employee.id.toString()}
                            onchange="toggleGroupCheckbox(this)"
                            title={`Pilih seluruh tagihan ${grp.employee.name}`}
                          />
                          <span class="w-7 h-7 rounded-full bg-indigo-600 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm">
                            {grp.employee.name.charAt(0)}
                          </span>
                          <div>
                            <span class="font-extrabold text-slate-900 text-sm">{grp.employee.name}</span>
                            {cashbonMap.has(grp.employee.id) && (
                              <span class="text-[11px] px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 font-bold border border-rose-200 ml-2">
                                Cashbon Aktif: {formatRupiah(cashbonMap.get(grp.employee.id)!)}
                              </span>
                            )}
                            <span class="text-xs text-slate-500 ml-2">
                              <span class="capitalize font-semibold text-slate-700">{grp.employee.scheme.replace('_', ' ')}</span> • <span class="group-count font-bold text-indigo-700">{hariIniItems.length} Tagihan</span>
                            </span>
                          </div>
                        </div>
                        <div class="flex items-center gap-3">
                          <div class="text-xs sm:text-right">
                            <span class="text-slate-500">Total Akumulasi:</span>
                            <span class="group-total-amount font-extrabold text-indigo-900 text-sm ml-1.5">{formatRupiah(initialSum)}</span>
                          </div>
                          <!-- Tombol Bayar Group yang muncul ketika checkbox di heading di-check -->
                          <button
                            type="button"
                            id={`btn-bayar-group-${grp.employee.id}`}
                            onclick={`payGroupBills(${grp.employee.id})`}
                            class="hidden px-3.5 py-1.5 rounded-xl font-bold text-xs bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition flex items-center gap-1.5 shrink-0"
                          >
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Bayar Tagihan</span>
                          </button>
                        </div>
                      </div>
                    </td>
                  </tr>

                {/* Baris data tagihan untuk karyawan ini */}
                {grp.items.map((item) => (
                  <tr
                    class="payroll-row hover:bg-slate-50/80 transition-colors"
                    data-emp-id={grp.employee.id.toString()}
                    data-status={item.statusCategory}
                    data-scheme={grp.employee.scheme}
                    data-emp-name={grp.employee.name.toLowerCase()}
                    data-period-start={item.period_start || ''}
                    data-period-end={item.period_end || ''}
                    data-period-label={item.period_label.toLowerCase()}
                    style={item.statusCategory === 'hari_ini_bayar' ? '' : 'display: none;'}
                  >
                    <td class="py-3.5 px-3 w-10 text-center">
                      <input
                        type="checkbox"
                        class="row-checkbox w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer"
                        data-emp-id={grp.employee.id.toString()}
                        data-emp-name={item.employee.name}
                        data-scheme={grp.employee.scheme}
                        data-amount={item.accrued_amount}
                        data-rate={item.employee.base_rate}
                        data-units={item.employee.scheme === 'per_jam' ? item.total_hours_worked : item.total_present_days}
                        data-period-start={item.period_start || ''}
                        data-period-end={item.period_end || ''}
                        onchange="onRowCheckboxChange(this)"
                      />
                    </td>
                    <td class="py-3.5 px-4">
                      <div class="font-bold text-slate-900 text-sm">{item.employee.name}</div>
                      <div class="text-[11px] text-slate-400">NIK: {item.employee.nik}</div>
                    </td>
                    <td class="py-3.5 px-4 font-medium text-slate-800 whitespace-nowrap">
                      {item.period_label}
                    </td>
                    <td class="py-3.5 px-4">
                      <span
                        class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold capitalize ${
                          item.employee.scheme === 'per_jam'
                            ? 'bg-sky-50 text-sky-700 border border-sky-200'
                            : item.employee.scheme === 'harian'
                            ? 'bg-amber-50 text-amber-700 border border-amber-200'
                            : item.employee.scheme === 'mingguan'
                            ? 'bg-purple-50 text-purple-700 border border-purple-200'
                            : 'bg-indigo-50 text-indigo-700 border border-indigo-200'
                        }`}
                      >
                        {item.employee.scheme.replace('_', ' ')}
                      </span>
                    </td>
                    <td class="py-3.5 px-4 font-mono font-medium text-slate-700 whitespace-nowrap">
                      {formatRupiah(item.employee.base_rate)}
                      <span class="text-[10px] text-slate-400 block font-sans">
                        {item.employee.scheme === 'per_jam'
                          ? '/ jam'
                          : item.employee.scheme === 'harian'
                          ? '/ hari'
                          : item.employee.scheme === 'mingguan'
                          ? '/ minggu (÷ 6)'
                          : '/ bulan (÷ 26)'}
                      </span>
                    </td>
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <div class="font-bold text-slate-900 text-sm">
                        {item.attendance_label}
                      </div>
                      {item.attendance_badge && (
                        <div class="mt-0.5">
                          <span
                            class={`inline-block px-1.5 py-0.5 rounded text-[9px] font-bold ${
                              item.attendance_badge_type === 'success'
                                ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                                : item.attendance_badge_type === 'warning'
                                ? 'bg-amber-50 text-amber-700 border border-amber-200'
                                : item.attendance_badge_type === 'danger'
                                ? 'bg-rose-50 text-rose-700 border border-rose-200'
                                : 'bg-slate-100 text-slate-700'
                            }`}
                          >
                            {item.attendance_badge}
                          </span>
                        </div>
                      )}
                    </td>
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      {item.statusCategory === 'hari_ini_bayar' ? (
                        <div>
                          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            Hari Ini Bayar
                          </span>
                          <div class="text-[10px] text-slate-400 mt-0.5">Bisa bayar hari ini</div>
                        </div>
                      ) : item.statusCategory === 'belum_terbayar' ? (
                        <div>
                          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                            Belum Terbayar
                          </span>
                          <div class="text-[10px] text-slate-400 mt-0.5">Masa lalu belum dicairkan</div>
                        </div>
                      ) : (
                        <div>
                          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                            Sedang Berlangsung
                          </span>
                          <div class="text-[10px] text-slate-400 mt-0.5">
                            {item.days_until_payday > 0 ? `${item.days_until_payday} hari lagi gajian` : 'Periode berjalan'}
                          </div>
                        </div>
                      )}
                    </td>
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <div class="font-extrabold text-sm text-indigo-600">{item.currency_formatted}</div>
                      <div class="text-[10px] text-slate-400 max-w-[200px] truncate" title={item.breakdown}>
                        {item.breakdown}
                      </div>
                    </td>
                    <td class="py-3.5 px-4 text-right whitespace-nowrap">
                      <button
                        onclick={`openSettleModal(${item.employee.id}, '${item.employee.name.replace(/'/g, "\\'")}', '${item.employee.nik}', '${(item.employee.position || '').replace(/'/g, "\\'")}', '${item.employee.scheme}', ${item.accrued_amount}, ${item.employee.base_rate}, ${item.employee.scheme === 'per_jam' ? item.total_hours_worked : item.total_present_days}, '${item.period_start || ''}', '${item.period_end || ''}', ${item.employee.fixed_allowance || 0}, ${cashbonMap.get(item.employee.id) || 0})`}
                        class={`px-3.5 py-1.5 rounded-xl font-bold text-xs transition shadow-sm ${
                          item.statusCategory === 'hari_ini_bayar'
                            ? 'bg-emerald-600 hover:bg-emerald-700 text-white'
                            : item.statusCategory === 'belum_terbayar'
                            ? 'bg-rose-600 hover:bg-rose-700 text-white'
                            : 'bg-indigo-600 hover:bg-indigo-700 text-white'
                        }`}
                      >
                        {item.statusCategory === 'hari_ini_bayar'
                          ? 'Bayar Hari Ini'
                          : item.statusCategory === 'belum_terbayar'
                          ? 'Bayar Sekarang'
                          : 'Bayar Gaji'}
                      </button>
                    </td>
                  </tr>
                ))}
              </>
            );
          })}
          </tbody>
        </table>
        <div id="emptyFilterMsg" class="py-10 text-center text-slate-400 text-xs" style={countHariIni === 0 ? '' : 'display: none;'}>
