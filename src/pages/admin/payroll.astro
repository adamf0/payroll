        <body>
          <div class="header">
            <div>
              <div class="brand">PAYROLLKU</div>
              <div class="sub">Bukti Resmi Penggajian & Potongan</div>
            </div>
            <div style="text-align: right;">
              <div style="font-family: monospace; font-weight: bold;">#PAY-${d.id}</div>
              <div class="sub">${d.date}</div>
            </div>
          </div>
          <div class="info-grid">
            <div>
              <div style="color: #64748b; font-size: 11px;">Karyawan:</div>
              <strong style="font-size: 15px;">${d.name}</strong>
              <div style="color: #64748b;">NIK: ${d.nik} • Posisi: ${d.position}</div>
            </div>
            <div style="text-align: right;">
              <div style="color: #64748b; font-size: 11px;">Periode Pembayaran:</div>
              <strong style="font-size: 14px;">${d.period}</strong>
              <div style="color: #64748b; text-transform: capitalize;">Skema Gaji: ${d.scheme}</div>
            </div>
          </div>

          <div class="section-title">Pendapatan</div>
          <div class="row"><span>Gaji Pokok (${d.units} × ${d.rate}):</span><span>${d.baseWage}</span></div>
          <div class="row"><span>Tunjangan:</span><span>${d.allowance}</span></div>
          <div class="row"><span>Upah Lembur:</span><span>${d.overtime}</span></div>
          <div class="row"><span>Bonus:</span><span>${d.bonus}</span></div>

          <div class="section-title" style="color: #b91c1c;">Potongan</div>
          <div class="row" style="color: #b91c1c;"><span>Potongan Cashbon:</span><span>-${d.cashbon}</span></div>

          <div class="total-box">
            <span>Total Gaji Bersih (Take Home Pay):</span>
            <span style="color: #047857;">${d.totalNet}</span>
          </div>

          <div class="footer">
            Dokumen ini dihasilkan secara otomatis oleh sistem Payrollku dan sah tanpa tanda tangan fisik.
          </div>
        </body>
        </html>
      `);
      w.document.close();
      w.focus();
      w.print();
    };

    applyFilters();
    document.addEventListener('DOMContentLoaded', applyFilters);
  </script>
</Layout>
