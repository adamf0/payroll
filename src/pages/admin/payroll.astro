              settlements.map((s) => {
                const totalAdditional = (Number(s.allowance) || 0) + (Number(s.overtime_pay) || 0) + (Number(s.bonus) || 0);
                const baseWage = Number(s.rate) * Number(s.total_units) || Number(s.amount_paid);
                return (
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="py-3 px-4 font-mono font-bold text-slate-700">#PAY-{s.id}</td>
                    <td class="py-3 px-4">
                      <div class="font-bold text-slate-900">{s.name}</div>
