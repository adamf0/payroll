---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser } from '../../lib/auth';
import { queryAll, queryOne } from '../../lib/db';
import { computeAllRealtimePayroll, formatRupiah, formatIndonesianDate, getJakartaTodayStr } from '../../lib/payroll';
import type { AttendanceRecord } from '../../lib/types';

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || currentUser.role !== 'admin') {
  return Astro.redirect('/login');
}

// 1. Employee Stats
const totalEmployees = (await queryOne<{ count: number }>('SELECT COUNT(*) as count FROM employees WHERE is_active = 1'))?.count || 0;

// 2. Today's Presence Stats
const todayStr = getJakartaTodayStr();
const [currYear, currMonth] = todayStr.split('-');
const currentPeriodName = new Date(Number(currYear), Number(currMonth) - 1, 1).toLocaleDateString('id-ID', {
  month: 'long',
  year: 'numeric',
});

const todayAttendance = await queryAll<AttendanceRecord & { name: string; nik: string; scheme: string }>(
  `SELECT a.*, e.name, e.nik, e.scheme 
   FROM attendance a
   JOIN employees e ON a.employee_id = e.id
   WHERE a.date = ?
   ORDER BY a.id DESC`,
  [todayStr]
);
const presentTodayCount = todayAttendance.length;
const presencePercentage = totalEmployees > 0 ? Math.round((presentTodayCount / totalEmployees) * 100) : 0;

// 3. Realtime Accrued Payroll Stats
const payrollItems = await computeAllRealtimePayroll();
const totalAccruedPayroll = payrollItems.reduce((acc, item) => acc + item.accrued_amount, 0);
const duePayrollCount = payrollItems.filter((item) => item.is_due).length;

// 4. Cashbon Stats (Matching Client Mockup ide1 & ide2)
const totalCashbonRequested = (await queryOne<{ total: number }>('SELECT COALESCE(SUM(amount_requested), 0) as total FROM cashbon_requests'))?.total || 0;
const pendingCashbonCount = (await queryOne<{ count: number }>("SELECT COUNT(*) as count FROM cashbon_requests WHERE status = 'pending'"))?.count || 0;
const approvedCashbonCount = (await queryOne<{ count: number }>("SELECT COUNT(*) as count FROM cashbon_requests WHERE status IN ('approved', 'partial', 'settled')"))?.count || 0;

const totalCashbonDisbursedActive = (await queryOne<{ total: number }>(`
  SELECT COALESCE(SUM(c.amount_approved - COALESCE(r.total_repaid, 0)), 0) as total
  FROM cashbon_requests c
  LEFT JOIN (
    SELECT cashbon_id, SUM(amount) AS total_repaid
    FROM cashbon_repayments
    GROUP BY cashbon_id
  ) r ON c.id = r.cashbon_id
  WHERE c.status IN ('approved', 'partial') AND c.disbursed_at IS NOT NULL
`))?.total || 0;

// Active employees list for direct cashbon modal
const activeEmployees = await queryAll<{ id: number; nik: string; name: string; position: string | null }>(
  `SELECT id, nik, name, position FROM employees WHERE is_active = 1 ORDER BY name ASC`
);
---

<Layout title="Dashboard Admin - PAYROLLKU" activeNav="admin-dashboard">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">

    <!-- 1. Hero Welcome Banner (Ide Client ide2.jpeg) -->
    <div class="relative overflow-hidden rounded-3xl bg-slate-900 border border-slate-800 text-white p-6 sm:p-8 shadow-sm">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-5">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 text-xs font-bold border border-indigo-500/30">
              <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
              PAYROLLKU • Employee & Salary Management
            </span>
            <span class="text-xs font-semibold text-slate-400 hidden sm:inline">• Admin Dashboard</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
            Selamat datang, {currentUser.name}!
          </h1>
          <p class="text-xs sm:text-sm text-slate-300 max-w-xl">
            Kelola gaji dan cashbon karyawan dalam satu tempat secara transparan dan otomatis.
          </p>
        </div>

        <!-- Period Badge -->
        <div class="self-start md:self-auto bg-slate-800/90 border border-slate-700/80 px-4 py-3 rounded-2xl flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-indigo-600/30 border border-indigo-500/40 flex items-center justify-center text-indigo-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Periode Aktif</span>
            <span class="text-sm font-extrabold text-white">{currentPeriodName}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Alert Bar: Permohonan Cashbon Pending (Actionable) -->
    {pendingCashbonCount > 0 && (
      <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-700 flex items-center justify-center shrink-0 font-bold">
            ⚠️
          </span>
          <div>
            <div class="text-xs font-bold text-amber-900">
              Ada {pendingCashbonCount} Permohonan Cashbon Menunggu Persetujuan
            </div>
            <div class="text-[11px] text-amber-800/80">
              Karyawan telah mengajukan pinjaman dan menunggu review plafon nominal dari admin.
            </div>
          </div>
        </div>
        <a
          href="/admin/cashbon"
          class="inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-bold bg-amber-600 hover:bg-amber-700 text-white shadow-sm transition whitespace-nowrap self-start sm:self-auto"
        >
          Tinjau Sekarang &rarr;
        </a>
      </div>
    )}

    <!-- 3. Menu Utama Hub (Penyajian Elegan dari ide2.jpeg) -->
    <div>
      <div class="flex items-center justify-between mb-3 px-1">
        <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider">
          Menu Utama • Pilih Untuk Melihat Tampilan
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <!-- Dashboard -->
        <a
          href="/admin"
          class="p-4 rounded-2xl bg-indigo-50 border-2 border-indigo-500/50 text-indigo-900 shadow-sm flex flex-col justify-between transition group hover:shadow"
        >
          <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white flex items-center justify-center mb-3 shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          </div>
          <div>
            <div class="text-xs font-extrabold text-slate-900">Dashboard</div>
            <div class="text-[10px] text-indigo-700 font-semibold mt-0.5">Ringkasan Sistem</div>
          </div>
        </a>

        <!-- Data Karyawan -->
        <a
          href="/admin/karyawan"
          class="p-4 rounded-2xl bg-white border border-slate-200/80 text-slate-800 shadow-sm hover:border-indigo-300 hover:bg-slate-50/80 transition group"
        >
          <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 group-hover:bg-indigo-50 group-hover:text-indigo-600 flex items-center justify-center mb-3 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          </div>
          <div>
            <div class="text-xs font-extrabold text-slate-900">Data Karyawan</div>
            <div class="text-[10px] text-slate-500 mt-0.5">{totalEmployees} Karyawan Aktif</div>
          </div>
        </a>

        <!-- Presensi / Kehadiran -->
        <a
          href="/admin/presensi"
          class="p-4 rounded-2xl bg-white border border-slate-200/80 text-slate-800 shadow-sm hover:border-indigo-300 hover:bg-slate-50/80 transition group"
        >
          <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 group-hover:bg-emerald-50 group-hover:text-emerald-600 flex items-center justify-center mb-3 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          </div>
          <div>
            <div class="text-xs font-extrabold text-slate-900">Daftar Hadir</div>
            <div class="text-[10px] text-emerald-600 font-semibold mt-0.5">{presentTodayCount} Hadir Hari Ini</div>
          </div>
        </a>

        <!-- Payroll / Gaji -->
        <a
          href="/admin/payroll"
          class="p-4 rounded-2xl bg-white border border-slate-200/80 text-slate-800 shadow-sm hover:border-indigo-300 hover:bg-slate-50/80 transition group"
        >
          <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 group-hover:bg-indigo-50 group-hover:text-indigo-600 flex items-center justify-center mb-3 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <div>
            <div class="text-xs font-extrabold text-slate-900">Payroll / Gaji</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Hitung & Bayar Gaji</div>
          </div>
        </a>

        <!-- Cashbon -->
        <a
          href="/admin/cashbon"
          class="p-4 rounded-2xl bg-white border border-slate-200/80 text-slate-800 shadow-sm hover:border-indigo-300 hover:bg-slate-50/80 transition group relative"
        >
          {pendingCashbonCount > 0 && (
            <span class="absolute top-3 right-3 w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
          )}
          <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 group-hover:bg-amber-50 group-hover:text-amber-600 flex items-center justify-center mb-3 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <div class="text-xs font-extrabold text-slate-900">Cashbon</div>
            <div class="text-[10px] text-amber-700 font-semibold mt-0.5">
              {pendingCashbonCount > 0 ? `${pendingCashbonCount} Perlu Review` : 'Pinjaman Karyawan'}
            </div>
          </div>
        </a>

        <!-- Laporan -->
        <a
          href="/admin/laporan"
          class="p-4 rounded-2xl bg-white border border-slate-200/80 text-slate-800 shadow-sm hover:border-indigo-300 hover:bg-slate-50/80 transition group"
        >
          <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 group-hover:bg-blue-50 group-hover:text-blue-600 flex items-center justify-center mb-3 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <div>
            <div class="text-xs font-extrabold text-slate-900">Laporan</div>
            <div class="text-[10px] text-slate-500 mt-0.5">Rekap & Ekspor CSV</div>
          </div>
        </a>
      </div>
    </div>

    <!-- 4. Ringkasan Keuangan (4 Kartu dari ide1.jpeg) -->
    <div>
      <div class="flex items-center justify-between mb-3 px-1">
        <div>
          <h2 class="text-sm font-bold text-slate-900">Ringkasan Keuangan & Operasional</h2>
          <p class="text-xs text-slate-500">Statistik realtime penggajian dan perputaran pinjaman</p>
        </div>
        <span class="text-xs font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-xl border border-indigo-100">
          Periode: {currentPeriodName}
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- 1. Total Karyawan -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500">Total Karyawan</span>
            <div class="w-8 h-8 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
          </div>
          <div class="mt-3">
            <div class="text-2xl font-black text-slate-900">{totalEmployees} Orang</div>
            <div class="text-[11px] text-emerald-600 font-semibold mt-1 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              {presentTodayCount} hadir hari ini ({presencePercentage}%)
            </div>
          </div>
        </div>

        <!-- 2. Total Gaji Pokok (Berjalan) -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500">Total Gaji Pokok</span>
            <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-700 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
            </div>
          </div>
          <div class="mt-3">
            <div class="text-2xl font-black text-indigo-900">{formatRupiah(totalAccruedPayroll)}</div>
            <div class="text-[11px] text-slate-500 mt-1">
              {duePayrollCount > 0 ? (
                <span class="text-rose-600 font-bold">{duePayrollCount} tagihan siap cair hari ini</span>
              ) : (
                'Akumulasi berjalan bulan ini'
              )}
            </div>
          </div>
        </div>

        <!-- 3. Cashbon Diajukan -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500">Cashbon Diajukan</span>
            <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
          </div>
          <div class="mt-3">
            <div class="text-2xl font-black text-slate-900">{formatRupiah(totalCashbonRequested)}</div>
            <div class="text-[11px] text-amber-700 font-semibold mt-1">
              {pendingCashbonCount > 0 ? `${pendingCashbonCount} pengajuan menunggu persetujuan` : 'Semua pengajuan telah ditinjau'}
            </div>
          </div>
        </div>

        <!-- 4. Status Cashbon -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500">Status Cashbon</span>
            <div class="w-8 h-8 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
          </div>
          <div class="mt-3">
            <div class="text-2xl font-black text-emerald-700">{approvedCashbonCount} Disetujui</div>
            <div class="text-[11px] text-slate-500 mt-1">
              Sisa pinjaman aktif: <strong class="text-rose-600">{formatRupiah(totalCashbonDisbursedActive)}</strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. Akses Cepat (3 Tombol dari ide1.jpeg disajikan sebagai Action Cards) -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-5 sm:p-6 shadow-sm">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
        <div>
          <h2 class="text-sm font-bold text-slate-900">Akses Cepat (Quick Actions)</h2>
          <p class="text-xs text-slate-500">Aksi kilat untuk mengelola administrasi karyawan dan penggajian</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
        <!-- Action 1: Tambah Karyawan -->
        <a
          href="/admin/karyawan"
          class="p-4 rounded-2xl bg-slate-50 hover:bg-indigo-50/60 border border-slate-200 hover:border-indigo-300 transition group flex items-center gap-3.5 shadow-sm"
        >
          <div class="w-11 h-11 rounded-2xl bg-indigo-600 text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
          </div>
          <div>
            <div class="text-sm font-bold text-slate-900 group-hover:text-indigo-900">+ Tambah Karyawan</div>
            <div class="text-[11px] text-slate-500">Daftarkan profil, rekening, & skema gaji</div>
          </div>
        </a>

        <!-- Action 2: Input Cashbon Langsung -->
        <button
          type="button"
          onclick="openDirectCashbonModal()"
          class="p-4 rounded-2xl bg-slate-50 hover:bg-amber-50/60 border border-slate-200 hover:border-amber-300 transition group flex items-center gap-3.5 shadow-sm text-left"
        >
          <div class="w-11 h-11 rounded-2xl bg-amber-600 text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          </div>
          <div>
            <div class="text-sm font-bold text-slate-900 group-hover:text-amber-900">+ Input Cashbon</div>
            <div class="text-[11px] text-slate-500">Pencatatan pinjaman langsung dari kasir</div>
          </div>
        </button>

        <!-- Action 3: Kelola Penggajian -->
        <a
          href="/admin/payroll"
          class="p-4 rounded-2xl bg-slate-50 hover:bg-emerald-50/60 border border-slate-200 hover:border-emerald-300 transition group flex items-center gap-3.5 shadow-sm"
        >
          <div class="w-11 h-11 rounded-2xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <div class="text-sm font-bold text-slate-900 group-hover:text-emerald-900">Kelola Penggajian</div>
            <div class="text-[11px] text-slate-500">Hitung komponen, bayar & cetak slip</div>
          </div>
        </a>
      </div>
    </div>

    <!-- 6. Two-Column Live Overview: Gaji Berjalan & Kehadiran Hari Ini -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Gaji Berjalan (7 cols) -->
      <div class="lg:col-span-7 bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
          <div>
            <h2 class="text-sm font-bold text-slate-900">Gaji Berjalan Karyawan</h2>
            <p class="text-xs text-slate-500">Akumulasi gaji dan jadwal pencairan</p>
          </div>
          <a href="/admin/payroll" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">
            Kelola Semua &rarr;
          </a>
        </div>

        <div class="space-y-2.5">
          {payrollItems.slice(0, 5).map((item) => (
            <div class="p-3.5 rounded-2xl border border-slate-100 bg-slate-50/60 flex items-center justify-between hover:bg-slate-50 transition">
              <div>
                <div class="text-xs font-bold text-slate-900">{item.employee.name}</div>
                <div class="text-[11px] text-slate-500">
                  NIK: {item.employee.nik} • Gaji <span class="capitalize">{item.employee.scheme.replace('_', ' ')}</span>
                </div>
              </div>

              <div class="text-right">
                <div class="text-xs font-extrabold text-slate-900">{item.currency_formatted}</div>
                <div class="text-[10px] text-slate-400 mt-0.5">
                  {item.days_until_payday <= 0 ? (
                    <span class="text-emerald-600 font-bold">Siap Bayar Hari Ini</span>
                  ) : (
                    <span>Gajian {item.days_until_payday} hari lagi</span>
                  )}
                </div>
              </div>
            </div>
          ))}
          {payrollItems.length > 5 && (
            <div class="text-center pt-2">
              <a href="/admin/payroll" class="text-xs font-bold text-slate-500 hover:text-slate-800">
                + Lihat {payrollItems.length - 5} karyawan lainnya di kelola gaji &rarr;
              </a>
            </div>
          )}
        </div>
      </div>

      <!-- Kehadiran Hari Ini (5 cols) -->
      <div class="lg:col-span-5 bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
          <div>
            <h2 class="text-sm font-bold text-slate-900">Kehadiran Hari Ini</h2>
            <p class="text-xs text-slate-500">{formatIndonesianDate(todayStr)}</p>
          </div>
          <a href="/admin/presensi" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">
            Daftar Hadir &rarr;
          </a>
        </div>

        <div class="space-y-2.5">
          {todayAttendance.length > 0 ? (
            todayAttendance.slice(0, 5).map((att) => (
              <div class="p-3.5 rounded-2xl border border-slate-100 bg-slate-50/60 flex items-center justify-between">
                <div>
                  <div class="text-xs font-bold text-slate-900">{att.name}</div>
                  <div class="text-[11px] text-slate-500">NIK: {att.nik}</div>
                </div>

                <div class="text-right">
                  <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                    Masuk: {att.check_in.slice(0, 5)}
                  </span>
                  <div class="text-[10px] text-slate-400 mt-0.5 capitalize">{att.scheme.replace('_', ' ')}</div>
                </div>
              </div>
            ))
          ) : (
            <div class="text-center py-8 text-xs text-slate-400">
              Belum ada karyawan yang absen hari ini.
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Input Cashbon Langsung (Embedded for Fast Action) -->
  <div id="directCashbonModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-xl border border-slate-100">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="text-base font-bold text-slate-900">+ Input Cashbon Langsung</h3>
        <button type="button" onclick="closeDirectCashbonModal()" class="text-slate-400 hover:text-slate-600 text-lg font-bold">&times;</button>
      </div>

      <form id="directCashbonForm" onsubmit="submitDirectCashbon(event)" class="mt-4 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Pilih Karyawan <span class="text-rose-500">*</span></label>
          <select
            id="dirEmpId"
            required
            class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            <option value="">-- Pilih Karyawan --</option>
            {activeEmployees.map((emp) => (
              <option value={emp.id}>
                {emp.name} ({emp.nik}) {emp.position ? `- ${emp.position}` : ''}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Nominal Cashbon (Rp) <span class="text-rose-500">*</span></label>
          <input
            type="number"
            id="dirAmount"
            required
            min="10000"
            step="5000"
            placeholder="Contoh: 500000"
            class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Alasan Keperluan</label>
          <textarea
            id="dirReason"
            rows="2"
            placeholder="Keperluan mendesak, operasional, dll..."
            class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          ></textarea>
        </div>

        <div class="bg-indigo-50/60 p-3 rounded-2xl border border-indigo-100">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="dirAutoDisburse" checked class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500" />
            <span class="text-xs font-bold text-indigo-900">Langsung Tandai Dicairkan Hari Ini</span>
          </label>
          <span class="text-[11px] text-indigo-700 mt-1 block pl-6">
            Uang sudah diserahkan/ditransfer ke rekening karyawan, langsung aktif sebagai tagihan payroll.
          </span>
        </div>

        <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
          <button
            type="button"
            onclick="closeDirectCashbonModal()"
            class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition"
          >
            Batal
          </button>
          <button
            type="submit"
            id="dirSubmitBtn"
            class="px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white transition shadow-sm"
          >
            Simpan Cashbon
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function openDirectCashbonModal() {
      document.getElementById('directCashbonForm').reset();
      document.getElementById('dirAutoDisburse').checked = true;
      document.getElementById('directCashbonModal').classList.remove('hidden');
    }

    function closeDirectCashbonModal() {
      document.getElementById('directCashbonModal').classList.add('hidden');
    }

    async function submitDirectCashbon(e) {
      e.preventDefault();
      const empId = document.getElementById('dirEmpId').value;
      const amount = document.getElementById('dirAmount').value;
      const reason = document.getElementById('dirReason').value.trim();
      const autoDisburse = document.getElementById('dirAutoDisburse').checked;
      const btn = document.getElementById('dirSubmitBtn');

      if (!empId || !amount) {
        alert('Lengkapi karyawan dan nominal cashbon');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Menyimpan...';

      try {
        const res = await fetch('/api/cashbon', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            employee_id: Number(empId),
            amount: Number(amount),
            reason,
            direct_disburse: autoDisburse,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal menyimpan cashbon');

        window.showToast?.(data.message || 'Cashbon berhasil ditambahkan');
        setTimeout(() => location.reload(), 500);
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.textContent = 'Simpan Cashbon';
      }
    }
  </script>
</Layout>
