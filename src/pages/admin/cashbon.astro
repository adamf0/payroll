  <script is:inline src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>

  <script is:inline define:vars={{ cashbons }}>
    async function getXLSX() {
      if (window.XLSX) return window.XLSX;
      return new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';
        s.onload = () => resolve(window.XLSX);
        s.onerror = () => {
          const s2 = document.createElement('script');
          s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
          s2.onload = () => resolve(window.XLSX);
          s2.onerror = () => reject(new Error('Gagal memuat pustaka XLSX'));
          document.head.appendChild(s2);
        };
        document.head.appendChild(s);
      });
    }

    window.exportCashbonToXLSX = async function () {
      if (!cashbons || cashbons.length === 0) {
        alert('Tidak ada data cashbon untuk diekspor');
        return;
      }

      try {
        const XLSXLib = await getXLSX();
        if (!XLSXLib) throw new Error('Modul XLSX tidak tersedia');

        const q = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
        const itemsToExport = cashbons.filter((c) => {
          let matchStatus = false;
          if (activeFilter === 'all') matchStatus = true;
          else if (activeFilter === 'pending') matchStatus = c.status === 'pending';
          else if (activeFilter === 'active') matchStatus = (c.status === 'approved' || c.status === 'partial') && Boolean(c.disbursed_at) && c.remaining_balance > 0;
          else if (activeFilter === 'settled') matchStatus = c.status === 'settled';
          else if (activeFilter === 'rejected') matchStatus = c.status === 'rejected';

          const searchText = `${c.emp_name} ${c.emp_nik} ${c.reason || ''} ${c.admin_notes || ''}`.toLowerCase();
          const matchSearch = !q || searchText.includes(q);

          return matchStatus && matchSearch;
        });

        if (itemsToExport.length === 0) {
          alert('Tidak ada data yang sesuai filter untuk diekspor');
          return;
        }

        const headers = [
          'No Bukti',
          'Tanggal Pengajuan',
          'Nama Karyawan',
          'NIK',
          'Jabatan / Posisi',
          'Nominal Pengajuan (Rp)',
          'Nominal Disetujui (Rp)',
          'Sudah Terpotong Gaji (Rp)',
          'Sisa Belum Dipotong (Rp)',
          'Status',
          'Tanggal Pencairan',
          'Alasan Pengajuan',
          'Catatan Admin',
        ];

        let sumReq = 0;
        let sumApp = 0;
        let sumRep = 0;
        let sumBal = 0;

        const rows = itemsToExport.map((c) => {
          sumReq += c.amount_requested;
          sumApp += c.amount_approved;
          sumRep += c.total_repaid;
          sumBal += c.remaining_balance;

          let statusLabel = c.status;
          if (c.status === 'pending') statusLabel = 'Menunggu Persetujuan';
          else if (c.status === 'approved') statusLabel = c.disbursed_at ? 'Disetujui & Dicairkan' : 'Disetujui Penuh';
          else if (c.status === 'partial') statusLabel = c.disbursed_at ? 'Disetujui Sebagian & Dicairkan' : 'Disetujui Sebagian';
          else if (c.status === 'settled') statusLabel = 'Lunas';
          else if (c.status === 'rejected') statusLabel = 'Ditolak';

          return [
            `CB-${c.id}`,
            c.created_at ? c.created_at.slice(0, 10) : '-',
            c.emp_name || '-',
            c.emp_nik || '-',
            c.emp_position || '-',
            c.amount_requested,
            c.amount_approved,
            c.total_repaid,
            c.remaining_balance,
            statusLabel,
            c.disbursed_at ? c.disbursed_at.slice(0, 10) : '-',
            c.reason || '-',
            c.admin_notes || '-',
          ];
        });

        // Baris total rekap
        rows.push([
          'TOTAL',
          '',
          `${itemsToExport.length} Data`,
          '',
          '',
          sumReq,
          sumApp,
          sumRep,
          sumBal,
          '',
          '',
          '',
          '',
        ]);

        const ws = XLSXLib.utils.aoa_to_sheet([headers, ...rows]);
        ws['!cols'] = [
          { wch: 14 },
          { wch: 16 },
          { wch: 24 },
          { wch: 14 },
          { wch: 18 },
          { wch: 22 },
          { wch: 22 },
          { wch: 18 },
          { wch: 18 },
          { wch: 26 },
          { wch: 18 },
          { wch: 30 },
          { wch: 30 },
        ];

        const wb = XLSXLib.utils.book_new();
        XLSXLib.utils.book_append_sheet(wb, ws, 'Data Cashbon');
        const filename = `Laporan_Cashbon_${new Date().toISOString().slice(0, 10)}.xlsx`;
        XLSXLib.writeFile(wb, filename);
      } catch (err) {
        alert(err.message || 'Gagal mengekspor data ke Excel');
      }
    };

    window.formatRupiahInput = function (el) {
      const cursor = el.selectionStart;
      const prevLen = el.value.length;
      const raw = el.value.replace(/\D/g, '');
      if (!raw) {
        el.value = '';
        return;
      }
      const formatted = new Intl.NumberFormat('id-ID').format(Number(raw));
      el.value = formatted;
      const diff = formatted.length - prevLen;
      const newPos = Math.max(0, (cursor || 0) + diff);
      try {
        el.setSelectionRange(newPos, newPos);
      } catch (e) {}
    };

    window.getRawNumber = function (input) {
      if (!input) return 0;
      const str = typeof input === 'object' && 'value' in input ? input.value : String(input);
      return Number(str.replace(/\D/g, '')) || 0;
    };

    let activeFilter = 'all';

    window.setFilterStatus = function (status, btn) {
      activeFilter = status;
      document.querySelectorAll('#statusFilterTabs .filter-tab').forEach((el) => {
        el.className = 'filter-tab px-3 py-1.5 rounded-xl text-xs font-bold transition bg-white text-slate-700 border border-slate-200 hover:bg-slate-50';
      });
      if (btn) {
        btn.className = 'filter-tab px-3 py-1.5 rounded-xl text-xs font-bold transition bg-slate-900 text-white shadow-sm';
      }
      window.applyFilterTable();
    };

    window.applyFilterTable = function () {
      const q = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('.cashbon-row');

      rows.forEach((row) => {
        const rowStatus = row.getAttribute('data-status');
        const isActive = row.getAttribute('data-is-active') === 'true';
        const searchText = row.getAttribute('data-search') || '';

        let matchStatus = false;
        if (activeFilter === 'all') matchStatus = true;
        else if (activeFilter === 'pending') matchStatus = rowStatus === 'pending';
        else if (activeFilter === 'active') matchStatus = isActive;
        else if (activeFilter === 'settled') matchStatus = rowStatus === 'settled';
        else if (activeFilter === 'rejected') matchStatus = rowStatus === 'rejected';

        const matchSearch = !q || searchText.includes(q);

        row.style.display = matchStatus && matchSearch ? '' : 'none';
      });
    };

    // Review Modal Handlers
    let currentReqAmount = 0;
    window.openReviewModal = function (id, empName, amount) {
      document.getElementById('revCashbonId').value = id;
      document.getElementById('revEmpName').textContent = empName;
      document.getElementById('revReqAmount').textContent = 'Rp ' + Number(amount).toLocaleString('id-ID');
      document.getElementById('revApprovedAmount').value = Number(amount) ? new Intl.NumberFormat('id-ID').format(Number(amount)) : '';
      currentReqAmount = Number(amount) || 0;

      const radios = document.getElementsByName('decision');
      if (radios.length > 0) radios[0].checked = true;
      const remRadios = document.getElementsByName('revRemainingMode');
      if (remRadios.length > 0) remRadios[0].checked = true;
      window.toggleDecisionType();

      document.getElementById('reviewModal').classList.remove('hidden');
    };

    window.closeReviewModal = function () {
      document.getElementById('reviewModal').classList.add('hidden');
    };

    window.toggleDecisionType = function () {
      const decision = document.querySelector('input[name="decision"]:checked')?.value;
      const partialContainer = document.getElementById('partialAmountContainer');
      if (decision === 'approve_partial') {
        partialContainer.classList.remove('hidden');
      } else {
        partialContainer.classList.add('hidden');
        document.getElementById('revApprovedAmount').value = currentReqAmount ? new Intl.NumberFormat('id-ID').format(Number(currentReqAmount)) : '';
      }
    };

    window.submitReview = async function (e) {
      e.preventDefault();
      const id = document.getElementById('revCashbonId').value;
      const decision = document.querySelector('input[name="decision"]:checked')?.value;
      const adminNotes = document.getElementById('revAdminNotes').value.trim();
      const btn = document.getElementById('revSubmitBtn');

      let action = 'approve';
      let approvedAmount = currentReqAmount;
      let remainingMode = 'open';

      if (decision === 'approve_partial') {
        action = 'partial';
        approvedAmount = window.getRawNumber(document.getElementById('revApprovedAmount'));
        if (!approvedAmount || approvedAmount <= 0) {
          alert('Masukkan nominal disetujui yang valid');
          return;
        }
        remainingMode = document.querySelector('input[name="revRemainingMode"]:checked')?.value || 'open';
      }

      btn.disabled = true;
      btn.textContent = 'Menyimpan...';

      try {
        const res = await fetch('/api/cashbon/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: Number(id),
            action,
            amount_approved: approvedAmount,
            remaining_mode: remainingMode,
            admin_notes: adminNotes,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal menyimpan keputusan');

        window.showToast?.(data.message || 'Persetujuan cashbon berhasil disimpan');
        setTimeout(() => location.reload(), 500);
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.textContent = 'Simpan Keputusan';
      }
    };

    // Reject Modal Handlers (dengan Catatan)
    window.openRejectModal = function (id, empName, amount) {
      const idEl = document.getElementById('rejCashbonId');
      const nameEl = document.getElementById('rejEmpName');
      const amtEl = document.getElementById('rejReqAmount');
      const notesEl = document.getElementById('rejAdminNotes');
      const modal = document.getElementById('rejectModal');

      if (idEl) idEl.value = id;
      if (nameEl) nameEl.textContent = empName;
      if (amtEl) amtEl.textContent = 'Rp ' + Number(amount || 0).toLocaleString('id-ID');
      if (notesEl) notesEl.value = '';
      if (modal) modal.classList.remove('hidden');
    };

    window.closeRejectModal = function () {
      const modal = document.getElementById('rejectModal');
      if (modal) modal.classList.add('hidden');
    };

    window.submitReject = async function (e) {
      e.preventDefault();
      const id = document.getElementById('rejCashbonId')?.value;
      const adminNotes = (document.getElementById('rejAdminNotes')?.value || '').trim();
      const btn = document.getElementById('rejSubmitBtn');

      if (!adminNotes) {
        alert('Mohon masukkan alasan / catatan penolakan');
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Menolak...';
      }

      try {
        const res = await fetch('/api/cashbon/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: Number(id),
            action: 'reject',
            admin_notes: adminNotes,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal menolak cashbon');

        window.showToast?.(data.message || 'Permohonan cashbon telah ditolak');
        setTimeout(() => location.reload(), 500);
      } catch (err) {
        alert(err.message);
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Tolak Cashbon';
        }
      }
    };

    // Backwards-compatible alias
    window.rejectRequest = function (id, empName, amount) {
      window.openRejectModal(id, empName, amount || 0);
    };

    window.markDisbursed = async function (id, empName, amount) {
      if (!confirm(`Konfirmasi pencairan dana cashbon untuk ${empName} sebesar Rp ${Number(amount).toLocaleString('id-ID')}?`)) {
        return;
      }

      try {
        const res = await fetch('/api/cashbon/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: Number(id),
            action: 'disburse',
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal menandai pencairan');

        window.showToast?.(data.message || 'Cashbon telah ditandai dicairkan');
        setTimeout(() => location.reload(), 500);
      } catch (err) {
        alert(err.message);
      }
    };

    // Disburse Remaining Handlers
    let currentMaxRemaining = 0;
    window.openDisburseRemainingModal = function (id, empName, alreadyDisbursed, unDisbursed, totalReq) {
      currentMaxRemaining = Number(unDisbursed) || 0;
      document.getElementById('remCashbonId').value = id;
      document.getElementById('remEmpName').textContent = empName;
      document.getElementById('remTotalRequested').textContent = 'Rp ' + Number(totalReq).toLocaleString('id-ID');
      document.getElementById('remAlreadyDisbursed').textContent = 'Rp ' + Number(alreadyDisbursed).toLocaleString('id-ID');
      document.getElementById('remMaxAvailable').textContent = 'Rp ' + Number(unDisbursed).toLocaleString('id-ID');
      document.getElementById('remDisburseAmount').value = Number(unDisbursed) ? new Intl.NumberFormat('id-ID').format(Number(unDisbursed)) : '';
      document.getElementById('remAdminNotes').value = '';
      document.getElementById('disburseRemainingModal').classList.remove('hidden');
    };

    window.closeDisburseRemainingModal = function () {
      document.getElementById('disburseRemainingModal').classList.add('hidden');
    };

    window.submitDisburseRemaining = async function (e) {
      e.preventDefault();
      const id = document.getElementById('remCashbonId').value;
      const amount = window.getRawNumber(document.getElementById('remDisburseAmount'));
      const adminNotes = document.getElementById('remAdminNotes').value.trim();
      const btn = document.getElementById('remSubmitBtn');

      if (!amount || amount <= 0) {
        alert('Masukkan nominal pencairan yang valid');
        return;
      }
      if (amount > currentMaxRemaining) {
        alert(`Nominal pencairan melebihi sisa dana (Maksimal Rp ${Number(currentMaxRemaining).toLocaleString('id-ID')})`);
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Memproses...';

      try {
        const res = await fetch('/api/cashbon/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: Number(id),
            action: 'disburse_remaining',
            amount_to_disburse: Number(amount),
            admin_notes: adminNotes,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal mencairkan sisa cashbon');

        window.showToast?.(data.message || 'Sisa cashbon berhasil dicairkan');
        setTimeout(() => location.reload(), 500);
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.textContent = 'Konfirmasi Pencairan Sisa';
      }
    };

    window.confirmCloseRemaining = async function (id, empName, unDisbursed) {
      const confirmed = confirm(
        `Apakah Anda yakin ingin menutup sisa permohonan cashbon untuk ${empName} sebesar Rp ${Number(unDisbursed).toLocaleString('id-ID')}?\n\nSetelah ditutup, sisa dana ini tidak akan dicairkan lagi.`
      );
      if (!confirmed) return;

      try {
        const res = await fetch('/api/cashbon/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: Number(id),
            action: 'close_remaining',
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal menutup sisa cashbon');

        window.showToast?.(data.message || 'Sisa permohonan cashbon telah ditutup');
        setTimeout(() => location.reload(), 500);
      } catch (err) {
        alert(err.message);
      }
    };

    // Direct Cashbon Modal Handlers
    window.openDirectCashbonModal = function () {
      document.getElementById('directCashbonForm').reset();
      document.getElementById('dirAutoDisburse').checked = true;
      document.getElementById('directCashbonModal').classList.remove('hidden');
    };

    window.closeDirectCashbonModal = function () {
      document.getElementById('directCashbonModal').classList.add('hidden');
    };

    window.submitDirectCashbon = async function (e) {
      e.preventDefault();
      const empId = document.getElementById('dirEmpId').value;
      const amount = window.getRawNumber(document.getElementById('dirAmount'));
      const reason = document.getElementById('dirReason').value.trim();
      const autoDisburse = document.getElementById('dirAutoDisburse').checked;
      const btn = document.getElementById('dirSubmitBtn');

      if (!empId || !amount || amount <= 0) {
        alert('Lengkapi karyawan dan pastikan nominal cashbon lebih besar dari 0');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Menyimpan...';

      try {
        const res = await fetch('/api/cashbon', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            employee_id: Number(empId),
            amount: Number(amount),
            amount_requested: Number(amount),
            reason,
            direct_disburse: autoDisburse,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal menyimpan cashbon');

        window.showToast?.(data.message || 'Cashbon berhasil ditambahkan');
        setTimeout(() => location.reload(), 500);
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.textContent = 'Simpan Cashbon';
      }
    };
  </script>
</Layout>
