---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser } from '../../lib/auth';
import { queryAll } from '../../lib/db';
import type { AuditLog } from '../../lib/types';
import { formatIndonesianDate } from '../../lib/payroll';

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || currentUser.role !== 'admin') {
  return Astro.redirect('/login');
}

const url = new URL(Astro.request.url);
const selectedModule = url.searchParams.get('module') || 'all';
const selectedAction = url.searchParams.get('action') || 'all';
const searchQuery = (url.searchParams.get('q') || '').trim();

let sql = `SELECT * FROM audit_logs WHERE 1=1`;
const params: any[] = [];

if (selectedModule && selectedModule !== 'all') {
  sql += ` AND module = ?`;
  params.push(selectedModule);
}

if (selectedAction && selectedAction !== 'all') {
  sql += ` AND action = ?`;
  params.push(selectedAction);
}

if (searchQuery) {
  sql += ` AND (record_title LIKE ? OR user_name LIKE ? OR notes LIKE ?)`;
  const wild = `%${searchQuery}%`;
  params.push(wild, wild, wild);
}

sql += ` ORDER BY id DESC LIMIT 250`;

const logs = await queryAll<AuditLog>(sql, params);

// Aggregate metrics
const countsRow = await queryAll<{
  total_count: number;
  karyawan_count: number;
  cashbon_count: number;
  payroll_count: number;
}>(`
  SELECT 
    COUNT(*) AS total_count,
    SUM(CASE WHEN module = 'karyawan' THEN 1 ELSE 0 END) AS karyawan_count,
    SUM(CASE WHEN module = 'cashbon' THEN 1 ELSE 0 END) AS cashbon_count,
    SUM(CASE WHEN module = 'payroll' THEN 1 ELSE 0 END) AS payroll_count
  FROM audit_logs
`);

const metrics = countsRow[0] || {
  total_count: 0,
  karyawan_count: 0,
  cashbon_count: 0,
  payroll_count: 0,
};

function formatActionBadge(action: string) {
  switch (action) {
    case 'create':
      return { label: 'Tambah Karyawan', bg: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
    case 'update':
      return { label: 'Ubah Data', bg: 'bg-amber-50 text-amber-700 border-amber-200' };
    case 'delete':
      return { label: 'Hapus Permanen', bg: 'bg-rose-50 text-rose-700 border-rose-200' };
    case 'activate':
      return { label: 'Aktifkan Kembali', bg: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
    case 'deactivate':
      return { label: 'Nonaktifkan', bg: 'bg-slate-100 text-slate-700 border-slate-300' };
    case 'account_create':
      return { label: 'Buat Akun Login', bg: 'bg-indigo-50 text-indigo-700 border-indigo-200' };
    case 'account_update':
      return { label: 'Ubah Akun Login', bg: 'bg-blue-50 text-blue-700 border-blue-200' };
    case 'request':
      return { label: 'Pengajuan Cashbon', bg: 'bg-purple-50 text-purple-700 border-purple-200' };
    case 'approve':
      return { label: 'Persetujuan Penuh', bg: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
    case 'partial_approve':
      return { label: 'Persetujuan Sebagian', bg: 'bg-amber-50 text-amber-700 border-amber-200' };
    case 'reject':
      return { label: 'Tolak Cashbon', bg: 'bg-rose-50 text-rose-700 border-rose-200' };
    case 'disburse':
    case 'disburse_direct':
      return { label: 'Pencairan Dana', bg: 'bg-teal-50 text-teal-700 border-teal-200' };
    case 'settle':
    case 'settle_batch':
      return { label: 'Pembayaran Gaji', bg: 'bg-indigo-50 text-indigo-700 border-indigo-200' };
    case 'void':
      return { label: 'Pembatalan Slip Gaji', bg: 'bg-rose-50 text-rose-700 border-rose-200' };
    default:
      return { label: action.replace('_', ' ').toUpperCase(), bg: 'bg-slate-50 text-slate-700 border-slate-200' };
  }
}

function formatModuleBadge(module: string) {
  switch (module) {
    case 'karyawan':
      return { label: 'Karyawan', bg: 'bg-sky-50 text-sky-700 border-sky-200', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' };
    case 'cashbon':
      return { label: 'Cashbon', bg: 'bg-purple-50 text-purple-700 border-purple-200', icon: 'M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z' };
    case 'payroll':
      return { label: 'Kelola Gaji', bg: 'bg-indigo-50 text-indigo-700 border-indigo-200', icon: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z' };
    default:
      return { label: module, bg: 'bg-slate-100 text-slate-700 border-slate-200', icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' };
  }
}
---

<Layout title="Riwayat Log & Perubahan Data" activeNav="admin-riwayat">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Riwayat Log & Audit Perubahan
          </h1>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
            Khusus Admin
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Rekam jejak setiap perubahan data karyawan, cashbon, pembayaran gaji, dan pembatalan transaksi lengkap dengan aktor (siapa), waktu (kapan), dan data sebelum vs sesudah.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/admin/riwayat"
          class="inline-flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-bold bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-sm transition"
        >
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Muat Ulang Log
        </a>
      </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
      <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm">
        <span class="text-xs font-medium text-slate-500 block">Total Aktivitas</span>
        <div class="text-2xl font-extrabold text-slate-900 mt-1">{metrics.total_count}</div>
        <span class="text-[11px] text-slate-400 mt-0.5 block">Seluruh log audit tersimpan</span>
      </div>

      <div class="bg-sky-50/60 p-4 rounded-2xl border border-sky-200/80 shadow-sm">
        <span class="text-xs font-semibold text-sky-800 block">Log Karyawan</span>
        <div class="text-2xl font-extrabold text-sky-900 mt-1">{metrics.karyawan_count}</div>
        <span class="text-[11px] text-sky-700 mt-0.5 block">Tambah, edit & status profil</span>
      </div>

      <div class="bg-purple-50/60 p-4 rounded-2xl border border-purple-200/80 shadow-sm">
        <span class="text-xs font-semibold text-purple-800 block">Log Cashbon</span>
        <div class="text-2xl font-extrabold text-purple-900 mt-1">{metrics.cashbon_count}</div>
        <span class="text-[11px] text-purple-700 mt-0.5 block">Pengajuan, persetujuan & pencairan</span>
      </div>

      <div class="bg-indigo-50/60 p-4 rounded-2xl border border-indigo-200/80 shadow-sm">
        <span class="text-xs font-semibold text-indigo-800 block">Log Kelola Gaji</span>
        <div class="text-2xl font-extrabold text-indigo-900 mt-1">{metrics.payroll_count}</div>
        <span class="text-[11px] text-indigo-700 mt-0.5 block">Pembayaran slip & pembatalan void</span>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-4 mb-6">
      <form method="GET" class="flex flex-wrap items-center gap-3">
        <!-- Module Filter Pills -->
        <div class="w-full sm:w-auto flex items-center gap-1.5 p-1 bg-slate-100/80 rounded-xl border border-slate-200 text-xs font-bold">
          <a
            href={`/admin/riwayat?module=all${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
            class={`px-3 py-1.5 rounded-lg transition ${
              selectedModule === 'all' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            Semua
          </a>
          <a
            href={`/admin/riwayat?module=karyawan${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
            class={`px-3 py-1.5 rounded-lg transition ${
              selectedModule === 'karyawan' ? 'bg-sky-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            Karyawan
          </a>
          <a
            href={`/admin/riwayat?module=cashbon${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
            class={`px-3 py-1.5 rounded-lg transition ${
              selectedModule === 'cashbon' ? 'bg-purple-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            Cashbon
          </a>
          <a
            href={`/admin/riwayat?module=payroll${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
            class={`px-3 py-1.5 rounded-lg transition ${
              selectedModule === 'payroll' ? 'bg-indigo-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            Kelola Gaji
          </a>
        </div>

        <input type="hidden" name="module" value={selectedModule} />

        <!-- Action Filter -->
        <div class="flex-1 min-w-[150px]">
          <select
            name="action"
            class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white"
            onchange="this.form.submit()"
          >
            <option value="all" selected={selectedAction === 'all'}>-- Semua Jenis Aksi --</option>
            <option value="create" selected={selectedAction === 'create'}>Tambah Karyawan</option>
            <option value="update" selected={selectedAction === 'update'}>Ubah Profil Karyawan</option>
            <option value="deactivate" selected={selectedAction === 'deactivate'}>Nonaktifkan Karyawan</option>
            <option value="activate" selected={selectedAction === 'activate'}>Aktifkan Karyawan</option>
            <option value="delete" selected={selectedAction === 'delete'}>Hapus Permanen</option>
            <option value="request" selected={selectedAction === 'request'}>Pengajuan Cashbon</option>
            <option value="approve" selected={selectedAction === 'approve'}>Persetujuan Cashbon</option>
            <option value="partial_approve" selected={selectedAction === 'partial_approve'}>Persetujuan Sebagian</option>
            <option value="reject" selected={selectedAction === 'reject'}>Tolak Cashbon</option>
            <option value="disburse" selected={selectedAction === 'disburse'}>Pencairan Cashbon</option>
            <option value="settle" selected={selectedAction === 'settle'}>Pembayaran Gaji</option>
            <option value="settle_batch" selected={selectedAction === 'settle_batch'}>Pembayaran Gaji Batch</option>
            <option value="void" selected={selectedAction === 'void'}>Pembatalan / Void Slip Gaji</option>
          </select>
        </div>

        <!-- Search Input -->
        <div class="flex-1 min-w-[200px] relative">
          <input
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Cari nama karyawan, admin, atau ID..."
            class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>

        <div>
          <button
            type="submit"
            class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-900 hover:bg-slate-800 text-white shadow-sm transition"
          >
            Terapkan
          </button>
        </div>

        {(searchQuery || selectedAction !== 'all' || selectedModule !== 'all') && (
          <div>
            <a
              href="/admin/riwayat"
              class="px-3 py-2 rounded-xl text-xs font-semibold text-rose-600 hover:bg-rose-50 transition block"
            >
              Reset Filter
            </a>
          </div>
        )}
      </form>
    </div>

    <!-- Table of Audit Logs -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="text-sm font-bold text-slate-900">
          Daftar Log Riwayat Perubahan
        </h2>
        <span class="text-xs text-slate-400">{logs.length} Data Ditampilkan</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50/80 border-b border-slate-200/80 text-slate-500 font-bold uppercase tracking-wider">
              <th class="py-3 px-4">Waktu (Kapan)</th>
              <th class="py-3 px-3">Modul</th>
              <th class="py-3 px-3">Aksi</th>
              <th class="py-3 px-4">Target / Data</th>
              <th class="py-3 px-4">Aktor (Siapa)</th>
              <th class="py-3 px-4">Keterangan</th>
              <th class="py-3 px-4 text-right">Detail</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {logs.length === 0 ? (
              <tr>
                <td colspan="7" class="text-center py-12 text-slate-400">
                  <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  Belum ada catatan log aktivitas yang sesuai dengan filter.
                </td>
              </tr>
            ) : (
              logs.map((log) => {
                const modBadge = formatModuleBadge(log.module);
                const actBadge = formatActionBadge(log.action);
                const dateStr = log.created_at ? log.created_at.slice(0, 19).replace('T', ' ') : '-';
                return (
                  <tr class="hover:bg-slate-50/80 transition group">
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <div class="font-mono text-slate-700 font-semibold text-[11px]">{dateStr}</div>
                      <div class="text-[10px] text-slate-400">#LOG-{log.id}</div>
                    </td>
                    <td class="py-3.5 px-3 whitespace-nowrap">
                      <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold border ${modBadge.bg}`}>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={modBadge.icon} /></svg>
                        {modBadge.label}
                      </span>
                    </td>
                    <td class="py-3.5 px-3 whitespace-nowrap">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded-lg text-[10px] font-extrabold border ${actBadge.bg}`}>
                        {actBadge.label}
                      </span>
                    </td>
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <div class="font-bold text-slate-900 text-xs">{log.record_title || `ID #${log.record_id || '-'}`}</div>
                      {log.record_id && (
                        <div class="text-[10px] text-slate-400 font-mono">Ref ID: {log.record_id}</div>
                      )}
                    </td>
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-700 font-bold flex items-center justify-center text-[10px]">
                          {(log.user_name || 'A')[0].toUpperCase()}
                        </div>
                        <div>
                          <div class="font-semibold text-slate-800">{log.user_name}</div>
                          <div class="text-[10px] text-slate-400">{log.user_id ? `User ID #${log.user_id}` : 'System'}</div>
                        </div>
                      </div>
                    </td>
                    <td class="py-3.5 px-4">
                      <div class="text-xs text-slate-600 max-w-xs truncate" title={log.notes || '-'}>
                        {log.notes || '-'}
                      </div>
                    </td>
                    <td class="py-3.5 px-4 whitespace-nowrap text-right">
                      <button
                        type="button"
                        class="view-diff-btn inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl text-[11px] font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition cursor-pointer"
                        data-log={JSON.stringify(log)}
                      >
                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Lihat Data
                      </button>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Diff Sebelum vs Sesudah -->
  <div id="diffModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <div id="modalBackdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"></div>
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

      <div class="inline-block align-bottom bg-white rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-3xl sm:w-full border border-slate-200">
        <!-- Modal Header -->
        <div class="px-6 py-4 bg-slate-50 border-b border-slate-200/80 flex items-center justify-between">
          <div>
            <div class="flex items-center gap-2">
              <span id="modalModuleBadge" class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase border"></span>
              <span id="modalActionBadge" class="px-2 py-0.5 rounded text-[10px] font-extrabold uppercase border"></span>
              <span id="modalLogId" class="text-xs font-mono font-bold text-slate-400"></span>
            </div>
            <h3 id="modalTitle" class="text-base font-extrabold text-slate-900 mt-1">Detail Riwayat Perubahan</h3>
          </div>
          <button
            type="button"
            id="closeModalBtn"
            class="text-slate-400 hover:text-slate-600 p-1.5 rounded-xl hover:bg-slate-200/60 transition cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6 space-y-5 max-h-[75vh] overflow-y-auto">
          <!-- Meta info grid -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 bg-slate-50 p-3.5 rounded-2xl border border-slate-200/80 text-xs">
            <div>
              <span class="text-[10px] font-semibold text-slate-400 block uppercase">Diubah Oleh (Siapa)</span>
              <span id="modalActor" class="font-bold text-slate-800"></span>
            </div>
            <div>
              <span class="text-[10px] font-semibold text-slate-400 block uppercase">Waktu Perubahan (Kapan)</span>
              <span id="modalTimestamp" class="font-mono font-semibold text-slate-800"></span>
            </div>
            <div>
              <span class="text-[10px] font-semibold text-slate-400 block uppercase">Target Data Terkait</span>
              <span id="modalTarget" class="font-bold text-slate-800"></span>
            </div>
          </div>

          <!-- Notes callout -->
          <div id="modalNotesBox" class="bg-indigo-50/70 border border-indigo-200/80 rounded-2xl p-3 text-xs text-indigo-900">
            <span class="font-bold block mb-0.5 text-indigo-950">Keterangan / Catatan:</span>
            <p id="modalNotes" class="text-indigo-800"></p>
          </div>

          <!-- Comparison Table (Diff Sebelum vs Sesudah) -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wide">
                Perbandingan Data: Sebelum vs Sesudah
              </h4>
              <span id="diffStateLabel" class="text-[11px] font-semibold text-slate-500"></span>
            </div>

            <div class="border border-slate-200 rounded-2xl overflow-hidden">
              <table class="w-full text-left border-collapse text-xs">
                <thead>
                  <tr class="bg-slate-100/80 border-b border-slate-200 text-slate-600 font-bold">
                    <th class="py-2.5 px-3 w-1/3">Parameter / Kolom</th>
                    <th class="py-2.5 px-3 w-1/3 bg-rose-50/50 text-rose-800">Sebelum (Old)</th>
                    <th class="py-2.5 px-3 w-1/3 bg-emerald-50/50 text-emerald-800">Sesudah (New)</th>
                  </tr>
                </thead>
                <tbody id="diffTableBody" class="divide-y divide-slate-100">
                  <!-- Injected via JavaScript -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Raw JSON Accordion -->
          <details class="bg-slate-50 rounded-2xl border border-slate-200/80 text-xs">
            <summary class="px-4 py-2.5 font-bold text-slate-600 cursor-pointer hover:text-slate-900 select-none">
              Lihat Raw JSON Data
            </summary>
            <div class="p-4 pt-1 border-t border-slate-200/80 space-y-3 font-mono text-[11px]">
              <div>
                <span class="font-bold text-slate-500 block mb-1">Old Values:</span>
                <pre id="rawOldJson" class="p-3 bg-slate-900 text-slate-100 rounded-xl overflow-x-auto whitespace-pre-wrap"></pre>
              </div>
              <div>
                <span class="font-bold text-slate-500 block mb-1">New Values:</span>
                <pre id="rawNewJson" class="p-3 bg-slate-900 text-slate-100 rounded-xl overflow-x-auto whitespace-pre-wrap"></pre>
              </div>
            </div>
          </details>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-200/80 text-right">
          <button
            type="button"
            id="modalCloseBottomBtn"
            class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-900 text-white transition cursor-pointer"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const diffModal = document.getElementById('diffModal');
    const modalBackdrop = document.getElementById('modalBackdrop');
    const closeModalBtn = document.getElementById('closeModalBtn');
    const modalCloseBottomBtn = document.getElementById('modalCloseBottomBtn');

    function closeModal() {
      diffModal.classList.add('hidden');
    }

    [modalBackdrop, closeModalBtn, modalCloseBottomBtn].forEach((el) => {
      if (el) el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !diffModal.classList.contains('hidden')) {
        closeModal();
      }
    });

    function formatVal(v) {
      if (v === null || v === undefined) return '<span class="text-slate-400 italic font-mono">-</span>';
      if (typeof v === 'boolean') return v ? 'true' : 'false';
      if (typeof v === 'number') {
        return `<span class="font-mono font-semibold">${v.toLocaleString('id-ID')}</span>`;
      }
      if (typeof v === 'object') return `<pre class="text-[10px]">${JSON.stringify(v, null, 1)}</pre>`;
      return String(v);
    }

    document.querySelectorAll('.view-diff-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          const log = JSON.parse(btn.getAttribute('data-log') || '{}');

          document.getElementById('modalLogId').innerText = `#LOG-${log.id}`;
          document.getElementById('modalTitle').innerText = log.notes || `Log Aktivitas #${log.id}`;
          document.getElementById('modalActor').innerText = `${log.user_name || 'System'} ${log.user_id ? `(#${log.user_id})` : ''}`;
          document.getElementById('modalTimestamp').innerText = log.created_at ? log.created_at.replace('T', ' ') : '-';
          document.getElementById('modalTarget').innerText = log.record_title || `ID #${log.record_id || '-'}`;
          document.getElementById('modalNotes').innerText = log.notes || 'Tidak ada catatan tambahan.';

          const moduleBadge = document.getElementById('modalModuleBadge');
          moduleBadge.innerText = (log.module || '').toUpperCase();
          moduleBadge.className = 'px-2 py-0.5 rounded text-[10px] font-extrabold uppercase border ' + 
            (log.module === 'karyawan' ? 'bg-sky-50 text-sky-700 border-sky-200' :
             log.module === 'cashbon' ? 'bg-purple-50 text-purple-700 border-purple-200' :
             'bg-indigo-50 text-indigo-700 border-indigo-200');

          const actionBadge = document.getElementById('modalActionBadge');
          actionBadge.innerText = (log.action || '').replace('_', ' ').toUpperCase();
          actionBadge.className = 'px-2 py-0.5 rounded text-[10px] font-extrabold uppercase border ' +
            (log.action === 'delete' || log.action === 'reject' || log.action === 'void' ? 'bg-rose-50 text-rose-700 border-rose-200' :
             log.action === 'create' || log.action === 'approve' || log.action === 'activate' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
             'bg-amber-50 text-amber-700 border-amber-200');

          let oldObj = null;
          let newObj = null;
          try {
            oldObj = typeof log.old_values === 'string' ? JSON.parse(log.old_values) : log.old_values;
          } catch (e) {
            oldObj = log.old_values;
          }
          try {
            newObj = typeof log.new_values === 'string' ? JSON.parse(log.new_values) : log.new_values;
          } catch (e) {
            newObj = log.new_values;
          }

          document.getElementById('rawOldJson').innerText = oldObj ? JSON.stringify(oldObj, null, 2) : 'null (Data belum ada sebelumnya)';
          document.getElementById('rawNewJson').innerText = newObj ? JSON.stringify(newObj, null, 2) : 'null (Data dihapus / ditiadakan)';

          const diffTableBody = document.getElementById('diffTableBody');
          diffTableBody.innerHTML = '';

          const diffStateLabel = document.getElementById('diffStateLabel');

          if (!oldObj && newObj) {
            diffStateLabel.innerText = 'Data Baru (Penambahan / Create)';
            diffStateLabel.className = 'text-[11px] font-bold text-emerald-700';
            Object.keys(newObj).forEach((key) => {
              const tr = document.createElement('tr');
              tr.className = 'bg-emerald-50/20';
              tr.innerHTML = `
                <td class="py-2 px-3 font-mono font-bold text-slate-700">${key}</td>
                <td class="py-2 px-3 text-slate-400 italic">-</td>
                <td class="py-2 px-3 font-medium text-emerald-900">${formatVal(newObj[key])}</td>
              `;
              diffTableBody.appendChild(tr);
            });
          } else if (oldObj && !newObj) {
            diffStateLabel.innerText = 'Data Dihapus / Dibatalkan (Delete / Void)';
            diffStateLabel.className = 'text-[11px] font-bold text-rose-700';
            Object.keys(oldObj).forEach((key) => {
              const tr = document.createElement('tr');
              tr.className = 'bg-rose-50/20';
              tr.innerHTML = `
                <td class="py-2 px-3 font-mono font-bold text-slate-700">${key}</td>
                <td class="py-2 px-3 font-medium text-rose-900 line-through">${formatVal(oldObj[key])}</td>
                <td class="py-2 px-3 text-slate-400 italic">-</td>
              `;
              diffTableBody.appendChild(tr);
            });
          } else if (oldObj && newObj) {
            diffStateLabel.innerText = 'Perubahan Data (Update / Modifikasi)';
            diffStateLabel.className = 'text-[11px] font-bold text-amber-700';

            const allKeys = Array.from(new Set([...Object.keys(oldObj), ...Object.keys(newObj)]));
            allKeys.forEach((key) => {
              const oldV = oldObj[key];
              const newV = newObj[key];
              const isDiff = JSON.stringify(oldV) !== JSON.stringify(newV);

              const tr = document.createElement('tr');
              tr.className = isDiff ? 'bg-amber-50/40 font-semibold' : 'opacity-70';
              tr.innerHTML = `
                <td class="py-2 px-3 font-mono text-slate-700 flex items-center gap-1.5">
                  ${isDiff ? '<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>' : ''}
                  ${key}
                </td>
                <td class="py-2 px-3 ${isDiff ? 'bg-rose-50/60 text-rose-900 font-bold' : 'text-slate-600'}">${formatVal(oldV)}</td>
                <td class="py-2 px-3 ${isDiff ? 'bg-emerald-50/60 text-emerald-900 font-bold' : 'text-slate-600'}">${formatVal(newV)}</td>
              `;
              diffTableBody.appendChild(tr);
            });
          } else {
            diffStateLabel.innerText = 'Tidak ada snapshot data';
            diffStateLabel.className = 'text-[11px] font-medium text-slate-400';
            const tr = document.createElement('tr');
            tr.innerHTML = '<td colspan="3" class="py-4 text-center text-slate-400">Tidak ada snapshot nilai sebelum dan sesudah.</td>';
            diffTableBody.appendChild(tr);
          }

          diffModal.classList.remove('hidden');
        } catch (err) {
          alert('Gagal memuat detail log: ' + err.message);
        }
      });
    });
  </script>
</Layout>
