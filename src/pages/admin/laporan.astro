---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser } from '../../lib/auth';
import { queryAll } from '../../lib/db';
import { formatRupiah, formatIndonesianDate, getJakartaTodayStr } from '../../lib/payroll';

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || currentUser.role !== 'admin') {
  return Astro.redirect('/login');
}

// Get filter params from URL or default to current month
const todayStr = getJakartaTodayStr();
const url = new URL(Astro.request.url);
const currentYear = todayStr.substring(0, 4);
const currentMonth = todayStr.substring(5, 7);

const selectedYear = url.searchParams.get('year') || currentYear;
const selectedMonth = url.searchParams.get('month') || currentMonth;
const selectedEmpId = url.searchParams.get('emp') || '';

// Query settlements matching filter
let settlementSql = `
  SELECT s.*, e.name, e.nik, e.position
  FROM payroll_settlements s
  JOIN employees e ON s.employee_id = e.id
  WHERE 1=1
`;
const settlementParams: any[] = [];

// Query cashbon disbursed matching filter
let cashbonSql = `
  SELECT c.*, e.name, e.nik
  FROM cashbon_requests c
  JOIN employees e ON c.employee_id = e.id
  WHERE c.disbursed_at IS NOT NULL
`;
const cashbonParams: any[] = [];

if (selectedYear !== 'all' && selectedMonth !== 'all') {
  const monthPattern = `${selectedYear}-${selectedMonth}%`;
  settlementSql += ` AND (s.settled_at LIKE ? OR s.period_end LIKE ?)`;
  settlementParams.push(monthPattern, monthPattern);

  cashbonSql += ` AND c.disbursed_at LIKE ?`;
  cashbonParams.push(monthPattern);
} else if (selectedYear !== 'all' && selectedMonth === 'all') {
  const yearPattern = `${selectedYear}%`;
  settlementSql += ` AND (s.settled_at LIKE ? OR s.period_end LIKE ?)`;
  settlementParams.push(yearPattern, yearPattern);

  cashbonSql += ` AND c.disbursed_at LIKE ?`;
  cashbonParams.push(yearPattern);
} else if (selectedYear === 'all' && selectedMonth !== 'all') {
  settlementSql += ` AND (DATE_FORMAT(s.settled_at, '%m') = ? OR DATE_FORMAT(s.period_end, '%m') = ?)`;
  settlementParams.push(selectedMonth, selectedMonth);

  cashbonSql += ` AND DATE_FORMAT(c.disbursed_at, '%m') = ?`;
  cashbonParams.push(selectedMonth);
}

if (selectedEmpId) {
  settlementSql += ` AND s.employee_id = ?`;
  settlementParams.push(Number(selectedEmpId));

  cashbonSql += ` AND c.employee_id = ?`;
  cashbonParams.push(Number(selectedEmpId));
}

settlementSql += ` ORDER BY s.settled_at DESC`;
const settlements = await queryAll<{
  id: number;
  employee_id: number;
  name: string;
  nik: string;
  position: string | null;
  period_start: string;
  period_end: string;
  scheme: string;
  total_units: number;
  rate: number;
  amount_paid: number;
  allowance: number;
  overtime_pay: number;
  bonus: number;
  cashbon_deduction: number;
  settled_at: string;
  notes: string | null;
}>(settlementSql, settlementParams);

const cashbonDisbursed = await queryAll<{
  id: number;
  employee_id: number;
  amount_approved: number;
  disbursed_at: string;
  name: string;
  nik: string;
}>(cashbonSql, cashbonParams);

// Financial Aggregates
const totalBaseWage = settlements.reduce((sum, s) => sum + (Number(s.rate) * Number(s.total_units) || Number(s.amount_paid)), 0);
const totalAllowance = settlements.reduce((sum, s) => sum + (Number(s.allowance) || 0), 0);
const totalOvertime = settlements.reduce((sum, s) => sum + (Number(s.overtime_pay) || 0), 0);
const totalBonus = settlements.reduce((sum, s) => sum + (Number(s.bonus) || 0), 0);
const totalCashbonDeducted = settlements.reduce((sum, s) => sum + (Number(s.cashbon_deduction) || 0), 0);
const totalNetPaid = settlements.reduce((sum, s) => sum + Number(s.amount_paid), 0);
const totalCashbonDisbursed = cashbonDisbursed.reduce((sum, c) => sum + Number(c.amount_approved), 0);

// Fetch all employees for filter dropdown
const employees = await queryAll<{ id: number; name: string; nik: string }>(
  `SELECT id, name, nik FROM employees ORDER BY name ASC`
);

const monthsList = [
  { val: 'all', label: 'Semua Bulan' },
  { val: '01', label: 'Januari' },
  { val: '02', label: 'Februari' },
  { val: '03', label: 'Maret' },
  { val: '04', label: 'April' },
  { val: '05', label: 'Mei' },
  { val: '06', label: 'Juni' },
  { val: '07', label: 'Juli' },
  { val: '08', label: 'Agustus' },
  { val: '09', label: 'September' },
  { val: '10', label: 'Oktober' },
  { val: '11', label: 'November' },
  { val: '12', label: 'Desember' },
];

const currentYearNum = parseInt(currentYear, 10);
const yearsList = [currentYearNum - 1, currentYearNum, currentYearNum + 1];

const selectedMonthName = monthsList.find((m) => m.val === selectedMonth)?.label || (selectedMonth === 'all' ? 'Semua Bulan' : selectedMonth);

let selectedPeriodTitle = '';
if (selectedMonth === 'all' && selectedYear === 'all') {
  selectedPeriodTitle = 'Semua Periode';
} else if (selectedMonth === 'all') {
  selectedPeriodTitle = `Semua Bulan ${selectedYear}`;
} else if (selectedYear === 'all') {
  selectedPeriodTitle = `${selectedMonthName} (Semua Tahun)`;
} else {
  selectedPeriodTitle = `${selectedMonthName} ${selectedYear}`;
}

const selectedEmployee = employees.find((e) => e.id.toString() === selectedEmpId);
---

<Layout title="Laporan Keuangan & Penggajian" activeNav="admin-laporan">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <!-- Header Web (Disembunyikan saat Cetak PDF) -->
    <div id="reportHeader" class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 print:hidden">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Laporan Keuangan & Payroll</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Rekapitulasi pengeluaran gaji pokok, tunjangan, lembur, bonus, dan perputaran cashbon karyawan.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          onclick="exportToXLSX()"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-sm transition cursor-pointer"
        >
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Unduh Excel (.xlsx)
        </button>
        <button
          type="button"
          onclick="printReport()"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          Cetak Laporan
        </button>
      </div>
    </div>

    <!-- Filter Bar (Disembunyikan saat Cetak PDF) -->
    <div id="filterCard" class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-4 mb-6 print:hidden">
      <form method="GET" class="flex flex-wrap items-center gap-3">
        <div>
          <label class="block text-[10px] font-semibold text-slate-400 mb-1">Bulan</label>
          <select
            name="month"
            class="px-3 py-1.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            {monthsList.map((m) => (
              <option value={m.val} selected={m.val === selectedMonth}>
                {m.label}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-[10px] font-semibold text-slate-400 mb-1">Tahun</label>
          <select
            name="year"
            class="px-3 py-1.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            <option value="all" selected={selectedYear === 'all'}>Semua Tahun</option>
            {yearsList.map((y) => (
              <option value={y.toString()} selected={selectedYear === y.toString()}>
                {y}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-[10px] font-semibold text-slate-400 mb-1">Karyawan</label>
          <select
            name="emp"
            class="px-3 py-1.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
            <option value="">-- Semua Karyawan --</option>
            {employees.map((e) => (
              <option value={e.id.toString()} selected={e.id.toString() === selectedEmpId}>
                {e.name} ({e.nik})
              </option>
            ))}
          </select>
        </div>

        <div class="self-end">
          <button
            type="submit"
            class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-900 hover:bg-slate-800 text-white shadow-sm transition"
          >
            Terapkan Filter
          </button>
        </div>
      </form>
    </div>

    <!-- Summary Metrics Grid (Disembunyikan saat Cetak PDF agar fokus pada tabel lengkap) -->
    <div id="printSummaryGrid" class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6 print:hidden">
      <div class="bg-indigo-900 text-white p-4 rounded-2xl shadow-sm">
        <span class="text-xs text-indigo-200 font-medium block">Total Pengeluaran Bersih</span>
        <div class="text-xl sm:text-2xl font-extrabold mt-1">{formatRupiah(totalNetPaid)}</div>
        <span class="text-[11px] text-indigo-300 mt-0.5 block">{settlements.length} transaksi slip dibayar</span>
      </div>

      <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm">
        <span class="text-xs font-medium text-slate-500 block">Total Gaji Pokok</span>
        <div class="text-xl font-extrabold text-slate-900 mt-1">{formatRupiah(totalBaseWage)}</div>
        <span class="text-[11px] text-slate-400 mt-0.5 block">Akumulasi tarif & unit kerja</span>
      </div>

      <div class="bg-emerald-50/60 p-4 rounded-2xl border border-emerald-200/80 shadow-sm">
        <span class="text-xs font-semibold text-emerald-800 block">Tunjangan, Lembur & Bonus</span>
        <div class="text-xl font-extrabold text-emerald-900 mt-1">
          {formatRupiah(totalAllowance + totalOvertime + totalBonus)}
        </div>
        <span class="text-[11px] text-emerald-700 mt-0.5 block">
          Tunjangan: {formatRupiah(totalAllowance)} • Lembur/Bonus: {formatRupiah(totalOvertime + totalBonus)}
        </span>
      </div>

      <div class="bg-rose-50/60 p-4 rounded-2xl border border-rose-200/80 shadow-sm">
        <span class="text-xs font-semibold text-rose-800 block">Potongan Cashbon</span>
        <div class="text-xl font-extrabold text-rose-900 mt-1">-{formatRupiah(totalCashbonDeducted)}</div>
        <span class="text-[11px] text-rose-700 mt-0.5 block">
          Cashbon Baru Dicairkan: {formatRupiah(totalCashbonDisbursed)}
        </span>
      </div>
    </div>

    <!-- Kop Judul Laporan Khusus Cetak PDF -->
    <div class="hidden print:block mb-4 pb-2 border-b-2 border-slate-800">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-base font-extrabold text-slate-900 uppercase tracking-wide">
            Laporan Rekapitulasi Penggajian & Keuangan Karyawan
          </h1>
          <p class="text-xs text-slate-700 mt-0.5 font-medium">
            Periode: <strong>{selectedPeriodTitle}</strong>
            {selectedEmployee ? <span> • Karyawan: <strong>{selectedEmployee.name} ({selectedEmployee.nik})</strong></span> : ' • Seluruh Karyawan'}
            <span> • Total Transaksi: <strong>{settlements.length} Data</strong></span>
          </p>
        </div>
        <div class="text-right text-[10px] text-slate-500">
          <div class="font-bold text-slate-800">Payrollku</div>
          <div>Dicetak: {new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
        </div>
      </div>
    </div>

    <!-- Detailed Table -->
    <div id="printTableContainer" class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden print:border-none print:shadow-none print:rounded-none print:m-0 print:p-0 print:overflow-visible">
      <div class="p-4 border-b border-slate-100 flex items-center justify-between print:hidden">
        <h2 class="text-sm font-bold text-slate-900">
          Rincian Penggajian Periode: {selectedPeriodTitle}
        </h2>
        <span class="text-xs text-slate-400">{settlements.length} Data Ditemukan</span>
      </div>

      <div class="overflow-x-auto">
        <table id="reportTable" class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50/80 border-b border-slate-200/80 text-slate-500 font-bold uppercase tracking-wider">
              <th class="py-3 px-3">No. Bukti</th>
              <th class="py-3 px-4">Karyawan</th>
              <th class="py-3 px-4">Periode</th>
              <th class="py-3 px-3">Gaji Pokok</th>
              <th class="py-3 px-3">Tunjangan</th>
              <th class="py-3 px-3">Lembur</th>
              <th class="py-3 px-3">Bonus</th>
              <th class="py-3 px-3">Potongan Cashbon</th>
              <th class="py-3 px-4">Gaji Bersih</th>
              <th class="py-3 px-4">Tanggal Bayar</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {settlements.length === 0 ? (
              <tr>
                <td colspan="10" class="text-center py-10 text-slate-400">
                  Tidak ada data penggajian pada periode {selectedPeriodTitle}.
                </td>
              </tr>
            ) : (
              settlements.map((s) => {
                const base = Number(s.rate) * Number(s.total_units) || Number(s.amount_paid);
                return (
                  <tr class="hover:bg-slate-50/80 transition">
                    <td class="py-3 px-3 font-mono font-bold text-slate-700">#PAY-{s.id}</td>
                    <td class="py-3 px-4 whitespace-nowrap">
                      <div class="font-bold text-slate-900">{s.name}</div>
                      <div class="text-[11px] text-slate-400">
                        {s.nik} {s.position ? `• ${s.position}` : ''}
                      </div>
                    </td>
                    <td class="py-3 px-4 whitespace-nowrap text-slate-600">
                      {s.period_start === s.period_end ? s.period_start : `${s.period_start} s/d ${s.period_end}`}
                    </td>
                    <td class="py-3 px-3 whitespace-nowrap font-medium text-slate-800">
                      {formatRupiah(base)}
                    </td>
                    <td class="py-3 px-3 whitespace-nowrap text-slate-700">
                      {Number(s.allowance) > 0 ? formatRupiah(Number(s.allowance)) : '-'}
                    </td>
                    <td class="py-3 px-3 whitespace-nowrap text-slate-700">
                      {Number(s.overtime_pay) > 0 ? formatRupiah(Number(s.overtime_pay)) : '-'}
                    </td>
                    <td class="py-3 px-3 whitespace-nowrap text-slate-700">
                      {Number(s.bonus) > 0 ? formatRupiah(Number(s.bonus)) : '-'}
                    </td>
                    <td class="py-3 px-3 whitespace-nowrap font-bold text-rose-600">
                      {Number(s.cashbon_deduction) > 0 ? `-${formatRupiah(Number(s.cashbon_deduction))}` : 'Rp 0'}
                    </td>
                    <td class="py-3 px-4 whitespace-nowrap font-extrabold text-slate-900 text-sm">
                      {formatRupiah(s.amount_paid)}
                    </td>
                    <td class="py-3 px-4 whitespace-nowrap font-mono text-slate-500">
                      {formatIndonesianDate(s.settled_at)}
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
          {settlements.length > 0 && (
            <tfoot>
              <tr class="bg-slate-100/90 font-bold border-t-2 border-slate-300 text-slate-900">
                <td colspan="3" class="py-3.5 px-4 text-right">TOTAL KESELURUHAN:</td>
                <td class="py-3.5 px-3 whitespace-nowrap">{formatRupiah(totalBaseWage)}</td>
                <td class="py-3.5 px-3 whitespace-nowrap">{formatRupiah(totalAllowance)}</td>
                <td class="py-3.5 px-3 whitespace-nowrap">{formatRupiah(totalOvertime)}</td>
                <td class="py-3.5 px-3 whitespace-nowrap">{formatRupiah(totalBonus)}</td>
                <td class="py-3.5 px-3 whitespace-nowrap text-rose-600">-{formatRupiah(totalCashbonDeducted)}</td>
                <td class="py-3.5 px-4 whitespace-nowrap text-indigo-900 text-sm">{formatRupiah(totalNetPaid)}</td>
                <td></td>
              </tr>
            </tfoot>
          )}
        </table>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>

  <script is:inline define:vars={{ settlements, selectedPeriodTitle, totalNetPaid, totalBaseWage, totalCashbonDeducted, totalAllowance, totalOvertime, totalBonus }}>
    async function getXLSX() {
      if (window.XLSX) return window.XLSX;
      return new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';
        s.onload = () => resolve(window.XLSX);
        s.onerror = () => {
          const s2 = document.createElement('script');
          s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
          s2.onload = () => resolve(window.XLSX);
          s2.onerror = () => reject(new Error('Gagal memuat pustaka XLSX. Periksa koneksi internet Anda.'));
          document.head.appendChild(s2);
        };
        document.head.appendChild(s);
      });
    }

    window.exportToXLSX = async function () {
      if (!settlements || settlements.length === 0) {
        alert('Tidak ada data untuk diekspor');
        return;
      }

      try {
        const XLSXLib = await getXLSX();
        if (!XLSXLib) throw new Error('Modul XLSX tidak tersedia');

        const headers = [
          'No Bukti',
          'Nama Karyawan',
          'NIK',
          'Jabatan / Posisi',
          'Periode Mulai',
          'Periode Selesai',
          'Sistem Gaji',
          'Gaji Pokok (Rp)',
          'Tunjangan (Rp)',
          'Lembur (Rp)',
          'Bonus (Rp)',
          'Potongan Cashbon (Rp)',
          'Gaji Bersih / THP (Rp)',
          'Tanggal Bayar',
          'Catatan',
        ];

        const rows = settlements.map((s) => {
          const base = Number(s.rate) * Number(s.total_units) || Number(s.amount_paid);
          return [
            `PAY-${s.id}`,
            s.name || '-',
            s.nik || '-',
            s.position || '-',
            s.period_start || '-',
            s.period_end || '-',
            s.scheme ? s.scheme.replace('_', ' ') : '-',
            base,
            Number(s.allowance) || 0,
            Number(s.overtime_pay) || 0,
            Number(s.bonus) || 0,
            Number(s.cashbon_deduction) || 0,
            Number(s.amount_paid) || 0,
            s.settled_at ? s.settled_at.slice(0, 19).replace('T', ' ') : '-',
            s.notes || '-',
          ];
        });

        const totalRow = [
          'TOTAL KESELURUHAN',
          '',
          '',
          '',
          '',
          '',
          '',
          Number(totalBaseWage) || 0,
          Number(totalAllowance) || 0,
          Number(totalOvertime) || 0,
          Number(totalBonus) || 0,
          Number(totalCashbonDeducted) || 0,
          Number(totalNetPaid) || 0,
          '',
          '',
        ];

        const wsData = [headers, ...rows, totalRow];
        const worksheet = XLSXLib.utils.aoa_to_sheet(wsData);

        worksheet['!cols'] = [
          { wch: 12 }, // No Bukti
          { wch: 22 }, // Nama
          { wch: 14 }, // NIK
          { wch: 18 }, // Jabatan
          { wch: 14 }, // Periode Mulai
          { wch: 14 }, // Periode Selesai
          { wch: 14 }, // Skema
          { wch: 16 }, // Gaji Pokok
          { wch: 14 }, // Tunjangan
          { wch: 14 }, // Lembur
          { wch: 14 }, // Bonus
          { wch: 22 }, // Potongan Cashbon
          { wch: 22 }, // Gaji Bersih
          { wch: 20 }, // Tanggal Bayar
          { wch: 25 }, // Catatan
        ];

        const workbook = XLSXLib.utils.book_new();
        XLSXLib.utils.book_append_sheet(workbook, worksheet, 'Laporan Payroll');
        const fileName = `Laporan_Gaji_${selectedPeriodTitle.replace(/[\s\(\)\/]/g, '_')}.xlsx`;
        XLSXLib.writeFile(workbook, fileName);
      } catch (err) {
        alert(err.message || 'Gagal mengekspor file Excel');
      }
    };

    window.exportToCSV = window.exportToXLSX;

    window.printReport = function () {
      window.print();
    };
  </script>

  <style is:global>
    @page {
      size: landscape;
      margin: 8mm 10mm;
    }

    @media print {
      /* Sembunyikan semua navigasi web, navbar, footer, drawer, tombol, dan kartu */
      header,
      footer,
      nav,
      .no-print,
      #reportHeader,
      #filterCard,
      #printSummaryGrid,
      #mobileMenu,
      #mobileMenuBtn,
      #toast-container {
        display: none !important;
      }

      body {
        background: #ffffff !important;
        color: #000000 !important;
        padding: 0 !important;
        margin: 0 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .max-w-7xl {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      #printTableContainer {
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        overflow: visible !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .overflow-x-auto {
        overflow: visible !important;
        display: block !important;
      }

      #reportTable {
        width: 100% !important;
        border-collapse: collapse !important;
        font-size: 8.5px !important;
        table-layout: auto !important;
      }

      #reportTable thead {
