---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser } from '../../lib/auth';
import { queryAll, queryOne } from '../../lib/db';
import { formatRupiah, formatIndonesianDate } from '../../lib/payroll';

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || currentUser.role !== 'karyawan' || !currentUser.employee_id) {
  return Astro.redirect('/login');
}

const employee = await queryOne<{
  id: number;
  nik: string;
  name: string;
  position: string | null;
  base_rate: number;
  scheme: string;
}>(
  `SELECT id, nik, name, position, base_rate, scheme FROM employees WHERE id = ?`,
  [currentUser.employee_id]
);

if (!employee) {
  return Astro.redirect('/login');
}

// Fetch all cashbon requests of this employee
const rawRequests = await queryAll<{
  id: number;
  amount_requested: number;
  amount_approved: number;
  reason: string;
  status: string;
  remaining_status: 'open' | 'closed' | 'disbursed';
  disbursed_at: string | null;
  admin_notes: string | null;
  created_at: string;
  total_repaid: number;
}>(
  `SELECT 
     c.id, c.amount_requested, c.amount_approved, c.reason, c.status,
     COALESCE(c.remaining_status, 'open') AS remaining_status,
     c.disbursed_at, c.admin_notes, c.created_at,
     COALESCE(SUM(r.amount), 0) AS total_repaid
   FROM cashbon_requests c
   LEFT JOIN cashbon_repayments r ON c.id = r.cashbon_id
   WHERE c.employee_id = ?
   GROUP BY c.id, c.amount_requested, c.amount_approved, c.reason, c.status,
            c.remaining_status, c.disbursed_at, c.admin_notes, c.created_at
   ORDER BY c.created_at DESC`,
  [currentUser.employee_id]
);

const requests = rawRequests.map((r) => {
  const req = Number(r.amount_requested) || 0;
  const app = Number(r.amount_approved) || 0;
  const rep = Number(r.total_repaid) || 0;
  const balance = Math.max(0, app - rep);
  const unDisbursed = Math.max(0, req - app);
  return {
    ...r,
    amount_requested: req,
    amount_approved: app,
    total_repaid: rep,
    remaining_balance: balance,
    un_disbursed_amount: unDisbursed,
    remaining_status: r.remaining_status || 'open',
  };
});

// Calculate active total balance
const totalActiveBalance = requests
  .filter((r) => (r.status === 'approved' || r.status === 'partial') && r.disbursed_at)
  .reduce((sum, r) => sum + r.remaining_balance, 0);

const totalAllRepaid = requests.reduce((sum, r) => sum + r.total_repaid, 0);

// Fetch repayment history
const repayments = await queryAll<{
  id: number;
  amount: number;
  repaid_at: string;
  notes: string | null;
  cashbon_id: number;
  settlement_id: number | null;
}>(
  `SELECT r.id, r.amount, r.repaid_at, r.notes, r.cashbon_id, r.settlement_id
   FROM cashbon_repayments r
   JOIN cashbon_requests c ON r.cashbon_id = c.id
   WHERE c.employee_id = ?
   ORDER BY r.repaid_at DESC`,
  [currentUser.employee_id]
);

const repaymentsByCashbonId = new Map<number, typeof repayments>();
for (const rp of repayments) {
  const existing = repaymentsByCashbonId.get(rp.cashbon_id) || [];
  existing.push(rp);
  repaymentsByCashbonId.set(rp.cashbon_id, existing);
}

const monthsList = [
  { val: 'all', label: 'Semua Bulan' },
  { val: '01', label: 'Januari' },
  { val: '02', label: 'Februari' },
  { val: '03', label: 'Maret' },
  { val: '04', label: 'April' },
  { val: '05', label: 'Mei' },
  { val: '06', label: 'Juni' },
  { val: '07', label: 'Juli' },
  { val: '08', label: 'Agustus' },
  { val: '09', label: 'September' },
  { val: '10', label: 'Oktober' },
  { val: '11', label: 'November' },
  { val: '12', label: 'Desember' },
];

const currentYearStr = String(new Date().getFullYear());
const uniqueYears = Array.from(
  new Set([
    currentYearStr,
    ...requests.map((r) => {
      const s = typeof r.created_at === 'string' ? r.created_at : new Date(r.created_at).toISOString();
      return s.slice(0, 4);
    }),
  ])
).sort((a, b) => b.localeCompare(a));
---

<Layout title="Cashbon Mandiri" activeNav="karyawan-cashbon">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 font-bold border border-indigo-200">
            Portal Karyawan
          </span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">Cashbon & Pinjaman</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Ajukan pinjaman mandiri, pantau status persetujuan, dan lihat rincian pemotongan otomatis dari gaji.
        </p>
      </div>
    </div>

    <!-- Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
      <div class="bg-gradient-to-br from-indigo-950 via-slate-900 to-indigo-900 text-white p-5 rounded-3xl shadow-sm">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-indigo-200 block">Sisa Pinjaman Belum Lunas</span>
          <span class={`text-[10px] px-2 py-0.5 rounded-full font-semibold border ${
            totalActiveBalance > 0
              ? 'bg-rose-500/20 text-rose-300 border-rose-500/30'
              : 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30'
          }`}>
            {totalActiveBalance > 0 ? 'Utang Aktif' : 'Semua Lunas'}
          </span>
        </div>
        <div class="text-2xl sm:text-3xl font-extrabold mt-2 tracking-tight text-white">
          {formatRupiah(totalActiveBalance)}
        </div>
        <p class="text-[11px] text-indigo-200/90 mt-2 leading-relaxed">
          {totalActiveBalance > 0
            ? 'Nominal ini akan otomatis dipotong dari Slip Gaji Anda pada tanggal gajian berikutnya (tidak perlu bayar tunai ke kantor).'
            : 'Tidak ada pinjaman berjalan saat ini. Seluruh tagihan cashbon telah lunas.'}
        </p>
      </div>

      <div class="bg-white p-5 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 block">Total Sudah Terpotong dari Gaji</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">
              Tuntas Lunas
            </span>
          </div>
          <div class="text-2xl font-extrabold text-emerald-600 mt-2">
            {formatRupiah(totalAllRepaid)}
          </div>
        </div>
        <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
          <span>Sumber Pemotongan:</span>
          <span class="font-bold text-slate-800">Otomatis via Slip Gaji (Payroll)</span>
        </div>
      </div>
    </div>

    <!-- Informasi Alur Cashbon (Transparan & Sederhana) -->
    <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-4 mb-6 text-xs text-indigo-950">
      <div class="font-bold flex items-center gap-1.5 mb-2 text-indigo-900">
        <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Bagaimana Alur Pemotongan Cashbon?
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-[11px] leading-relaxed">
        <div class="bg-white/80 p-2.5 rounded-xl border border-indigo-100">
          <strong class="text-slate-900 block mb-0.5">1. Ajukan Pinjaman</strong>
          Masukkan nominal & alasan kebutuhan. Permohonan ditinjau manajemen.
        </div>
        <div class="bg-white/80 p-2.5 rounded-xl border border-indigo-100">
          <strong class="text-slate-900 block mb-0.5">2. Uang Dicairkan Kasir</strong>
          Setelah disetujui, kasir mencairkan dana tunai / transfer ke rekening Anda.
        </div>
        <div class="bg-white/80 p-2.5 rounded-xl border border-indigo-100">
          <strong class="text-slate-900 block mb-0.5">3. Dipotong Otomatis dari Gaji</strong>
          Saat gajian tiba, uang dipotong langsung di Slip Gaji tanpa perlu setor tunai.
        </div>
      </div>
    </div>

    <!-- Action: Form Ajukan Cashbon Baru -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-5 sm:p-6 mb-8">
      <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
        <span class="w-6 h-6 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs font-black">+</span>
        Ajukan Cashbon Baru
      </h2>
      <p class="text-xs text-slate-500 mt-1">
        Permohonan akan langsung ditinjau oleh Admin. Pastikan nominal sesuai dengan kebutuhan mendesak Anda.
      </p>

      <form id="cashbonApplyForm" onsubmit="submitApplyCashbon(event)" class="mt-4 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">
            Nominal yang Diajukan (Rp) <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            inputmode="numeric"
            id="applyAmount"
            required
            oninput="formatRupiahInput(this)"
            placeholder="Contoh: 300.000"
            class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">
            Alasan Kebutuhan <span class="text-rose-500">*</span>
          </label>
          <textarea
            id="applyReason"
            required
            rows="2"
            placeholder="Jelaskan secara singkat keperluan mendesak Anda..."
            class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          ></textarea>
        </div>

        <div class="flex items-center justify-end">
          <button
            type="submit"
            id="applySubmitBtn"
            class="w-full sm:w-auto px-6 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            Kirim Pengajuan Cashbon
          </button>
        </div>
      </form>
    </div>

    <!-- Riwayat Pengajuan Cashbon -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden mb-8">
      <div class="p-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="text-sm font-bold text-slate-900">Riwayat Pengajuan Cashbon Anda</h2>
        <span class="text-xs text-slate-400" id="cashbonCountBadge">{requests.length} Pengajuan</span>
      </div>

      <!-- Filter Bar Bulan, Tahun & Status -->
      <div class="p-4 bg-slate-50/70 border-b border-slate-100">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
            <!-- Filter Bulan -->
            <div>
              <label for="filterMonth" class="block text-[10px] font-semibold text-slate-400 mb-1">Bulan</label>
              <select
                id="filterMonth"
                onchange="applyCashbonFilters()"
                class="px-3 py-1.5 rounded-xl border border-slate-200 text-xs font-medium text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer shadow-sm"
              >
                {monthsList.map((m) => (
                  <option value={m.val}>{m.label}</option>
                ))}
              </select>
            </div>

            <!-- Filter Tahun -->
            <div>
              <label for="filterYear" class="block text-[10px] font-semibold text-slate-400 mb-1">Tahun</label>
              <select
                id="filterYear"
                onchange="applyCashbonFilters()"
                class="px-3 py-1.5 rounded-xl border border-slate-200 text-xs font-medium text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer shadow-sm"
              >
                <option value="all">Semua Tahun</option>
                {uniqueYears.map((y) => (
                  <option value={y}>{y}</option>
                ))}
              </select>
            </div>

            <!-- Filter Status -->
            <div>
              <label for="filterStatus" class="block text-[10px] font-semibold text-slate-400 mb-1">Status</label>
              <select
                id="filterStatus"
                onchange="applyCashbonFilters()"
                class="px-3 py-1.5 rounded-xl border border-slate-200 text-xs font-medium text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer shadow-sm"
              >
                <option value="all">Semua Status</option>
                <option value="pending">Menunggu</option>
                <option value="rejected">Tolak</option>
                <option value="settled">Lunas Terpotong Gaji</option>
                <option value="approved">Disetujui</option>
              </select>
            </div>
          </div>

          <!-- Reset Filter Button -->
          <div class="self-end">
            <button
              type="button"
              onclick="resetCashbonFilter()"
              class="px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-100 text-slate-600 text-xs font-semibold transition shadow-sm cursor-pointer"
            >
              Reset Filter
            </button>
          </div>
        </div>
      </div>

      <div class="divide-y divide-slate-100">
        {requests.length === 0 ? (
          <div class="p-8 text-center text-slate-400 text-xs">
            Belum pernah mengajukan cashbon.
          </div>
        ) : (
          requests.map((r) => {
            const myRepayments = repaymentsByCashbonId.get(r.id) || [];
            let statusBadge = 'bg-slate-100 text-slate-700';
            let statusText = r.status;
            let filterCategory = 'pending';

            if (r.status === 'pending') {
              statusBadge = 'bg-amber-100 text-amber-800 border-amber-200';
              statusText = 'Menunggu Review Admin';
              filterCategory = 'pending';
            } else if (r.status === 'approved' || r.status === 'partial') {
              if (r.disbursed_at) {
                if (r.remaining_balance > 0) {
                  statusBadge = 'bg-emerald-100 text-emerald-800 border-emerald-200';
                  if (r.status === 'approved') {
                    statusText = 'Uang Cair • Menunggu Potong Gaji';
                  } else {
                    statusText = r.remaining_status === 'closed'
                      ? 'Disetujui Sebagian • 1x Selesai'
                      : 'Disetujui Sebagian • Bertahap';
                  }
                  filterCategory = 'approved';
                } else {
                  statusBadge = 'bg-purple-100 text-purple-800 border-purple-200';
                  statusText = 'Lunas Terpotong Gaji';
                  filterCategory = 'settled';
                }
              } else {
                statusBadge = 'bg-blue-100 text-blue-800 border-blue-200';
                if (r.status === 'approved') {
                  statusText = 'Disetujui Penuh • Belum Cair';
                } else {
                  statusText = r.remaining_status === 'closed'
                    ? 'Disetujui Sebagian (1x) • Belum Cair'
                    : 'Disetujui Sebagian • Belum Cair';
                }
                filterCategory = 'approved';
              }
            } else if (r.status === 'settled') {
              statusBadge = 'bg-purple-100 text-purple-800 border-purple-200';
              statusText = 'Lunas Terpotong Gaji';
              filterCategory = 'settled';
            } else if (r.status === 'rejected') {
              statusBadge = 'bg-rose-100 text-rose-800 border-rose-200';
              statusText = 'Pengajuan Ditolak';
              filterCategory = 'rejected';
            }

            const createdAtStr = typeof r.created_at === 'string' ? r.created_at : new Date(r.created_at).toISOString();
            const cardYear = createdAtStr.slice(0, 4);
            const cardMonth = createdAtStr.slice(5, 7);

            return (
              <div
                class="cashbon-card p-4 sm:p-5 hover:bg-slate-50/60 transition space-y-3"
                data-month={cardMonth}
                data-year={cardYear}
                data-status={filterCategory}
              >
                <!-- Baris 1: Status & Tanggal Pengajuan (+ Aksi Edit/Hapus jika pending) -->
                <div class="flex items-center justify-between gap-2">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class={`px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${statusBadge}`}>
                      {statusText}
                    </span>
                    <span class="text-xs text-slate-400 font-mono">
                      Diajukan: {formatIndonesianDate(r.created_at.slice(0, 10))}
                    </span>
                  </div>

                  {r.status === 'pending' && (
                    <div class="flex items-center gap-1.5">
                      <button
                        type="button"
                        onclick={`openEditCashbonModal(${r.id}, ${r.amount_requested}, ${JSON.stringify(r.reason || '')})`}
                        class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200 transition flex items-center gap-1"
                        title="Ubah Pengajuan"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        Edit
                      </button>
                      <button
                        type="button"
                        onclick={`deleteCashbon(${r.id}, ${r.amount_requested})`}
                        class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 transition flex items-center gap-1"
                        title="Batalkan & Hapus Pengajuan"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        Hapus
                      </button>
                    </div>
                  )}
                </div>

                <!-- Baris 2: Nominal Diajukan (Besar, Jelas, Flex-Row) -->
                <div class="flex flex-row items-baseline gap-2 pt-0.5">
                  <span class="text-xs font-semibold text-slate-500">Nominal Diajukan:</span>
                  <span class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
                    {formatRupiah(r.amount_requested)}
                  </span>
                </div>

                <!-- Baris 2: Alasan Kebutuhan & Catatan Admin -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                  <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                    <span class="font-semibold text-slate-500 block text-[11px] mb-0.5">Alasan Kebutuhan:</span>
                    <span class="text-slate-800">{r.reason || '-'}</span>
                  </div>
                  <div class={`p-2.5 rounded-xl border text-xs ${
                    r.admin_notes
                      ? 'bg-amber-50/60 border-amber-200 text-amber-900'
                      : 'bg-slate-50 border-slate-100 text-slate-400'
                  }`}>
                    <span class="font-semibold block text-[11px] mb-0.5 text-slate-500">Catatan Admin / Kasir:</span>
                    <span>{r.admin_notes || 'Belum ada catatan dari admin'}</span>
                  </div>
                </div>

                <!-- Baris 3: Status 3 Box Rincian Keuangan & Pemotongan -->
                {r.amount_approved > 0 && (
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
                    <!-- Box 1: Dana Pinjaman Diterima -->
                    <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs">
                      <span class="text-[11px] text-slate-500 font-medium block">1. Total Pinjaman Cair</span>
                      <div class="text-base font-extrabold text-slate-900 mt-0.5">
                        {formatRupiah(r.amount_approved)}
                      </div>
                      <span class="text-[10px] text-emerald-600 block mt-1 font-medium">
                        {r.disbursed_at
                          ? `✓ Cair: ${formatIndonesianDate(r.disbursed_at.slice(0, 10))}`
                          : '⏳ Menunggu dicairkan kasir'}
                      </span>
                      {r.status === 'partial' && (
                        r.remaining_status === 'closed' ? (
                          <span class="text-[10px] text-slate-500 block mt-1">
                            1x pencairan. Sisa {formatRupiah(r.un_disbursed_amount)} ditutup.
                          </span>
                        ) : (
                          <span class="text-[10px] text-amber-700 block mt-1 font-semibold">
                            Cair bertahap. Sisa {formatRupiah(r.un_disbursed_amount)} belum cair.
                          </span>
                        )
                      )}
                    </div>

                    <!-- Box 2: Sudah Terpotong dari Gaji -->
                    <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs">
                      <span class="text-[11px] text-slate-500 font-medium block">2. Sudah Dipotong dari Gaji</span>
                      <div class="text-base font-extrabold text-emerald-600 mt-0.5">
                        {formatRupiah(r.total_repaid)}
                      </div>
                      <span class="text-[10px] text-slate-500 block mt-1">
                        {r.total_repaid > 0
                          ? `✓ Terpotong via ${myRepayments.length} slip gaji`
                          : 'Belum ada potongan gaji'}
                      </span>
                    </div>

                    <!-- Box 3: Sisa yang Belum Dipotong -->
                    <div class={`p-3 rounded-2xl border text-xs ${
                      r.remaining_balance > 0
                        ? 'bg-rose-50/60 border-rose-200'
                        : 'bg-emerald-50/60 border-emerald-200'
                    }`}>
                      <span class="text-[11px] font-medium block text-slate-600">
                        3. Sisa Belum Dipotong (Utang)
                      </span>
                      <div class={`text-base font-extrabold mt-0.5 ${
                        r.remaining_balance > 0 ? 'text-rose-600' : 'text-emerald-700'
                      }`}>
                        {formatRupiah(r.remaining_balance)}
                      </div>
                      <span class={`text-[10px] block mt-1 font-semibold ${
                        r.remaining_balance > 0 ? 'text-rose-600' : 'text-emerald-700'
                      }`}>
                        {r.remaining_balance > 0
                          ? 'Akan dipotong saat gajian'
                          : '✓ Lunas tuntas terpotong'}
                      </span>
                    </div>
                  </div>
                )}

                {r.status === 'partial' && (
                  r.remaining_status === 'closed' ? (
                    <div class="p-2.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-700 flex items-start gap-2">
                      <span class="text-slate-500 font-bold text-sm">ℹ️</span>
                      <div>
                        <strong>Keterangan Pencairan:</strong>
                        <p class="text-[11px] text-slate-600 mt-0.5 leading-relaxed">
                          Dari pengajuan awal sebesar <strong>{formatRupiah(r.amount_requested)}</strong>, disetujui sebesar <strong>{formatRupiah(r.amount_approved)}</strong> untuk satu kali pencairan. Sisa permohonan sebesar <strong>{formatRupiah(r.un_disbursed_amount)}</strong> tidak dicairkan.
                        </p>
                      </div>
                    </div>
                  ) : (
                    <div class="p-2.5 rounded-2xl bg-amber-50/70 border border-amber-200 text-xs text-amber-950 flex items-start gap-2">
                      <span class="text-amber-600 font-bold text-sm">ℹ️</span>
                      <div>
                        <strong>Pencairan Bertahap:</strong>
                        <p class="text-[11px] text-amber-900 mt-0.5 leading-relaxed">
                          Dari total pengajuan <strong>{formatRupiah(r.amount_requested)}</strong>, disetujui dicairkan tahap ini sebesar <strong>{formatRupiah(r.amount_approved)}</strong>. Sisa sebesar <strong>{formatRupiah(r.un_disbursed_amount)}</strong> masih dapat dicairkan oleh Admin di kemudian hari.
                        </p>
                      </div>
                    </div>
                  )
                )}

                <!-- Baris 4: Informasi Arah & Sumber Data (Kemana arahnya & dari mana terpotong) -->
                {r.disbursed_at && r.remaining_balance > 0 && (
                  <div class="p-3 rounded-2xl bg-indigo-50/80 border border-indigo-100 flex items-start gap-2 text-xs text-indigo-950">
                    <span class="text-indigo-600 font-bold text-sm">💡</span>
                    <div>
                      <strong>Kemana arah sisa pinjaman ini?</strong>
                      <p class="text-[11px] text-indigo-800 mt-0.5 leading-relaxed">
                        Sisa pinjaman sebesar <strong>{formatRupiah(r.remaining_balance)}</strong> ini akan <strong>dipotong otomatis dari Slip Gaji Anda</strong> saat Admin memproses pembayaran gaji berikutnya. Anda tidak perlu membayar tunai ke kantor.
                      </p>
                    </div>
                  </div>
                )}

                <!-- Rincian Sumber Pemotongan yang sudah terjadi -->
                {myRepayments.length > 0 && (
                  <div class="pt-2">
                    <div class="text-[11px] font-bold text-slate-700 mb-1 flex items-center gap-1">
                      <span>Dari mana data terpotong?</span>
                      <span class="text-slate-400 font-normal">(Riwayat pemotongan pada slip gaji):</span>
                    </div>
                    <div class="space-y-1">
                      {myRepayments.map((rp) => (
                        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-100 text-xs">
                          <div>
                            <span class="font-bold text-slate-800">{rp.notes || 'Potongan gaji'}</span>
                            <span class="text-[10px] text-slate-400 font-mono block">
                              Tanggal: {formatIndonesianDate(rp.repaid_at.slice(0, 10))}
                            </span>
                          </div>
                          <div class="font-extrabold text-emerald-700">
                            -{formatRupiah(Number(rp.amount))}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            );
          })
        )}
        <div id="cashbonEmptyFiltered" class="hidden p-8 text-center text-slate-400 text-xs">
          Tidak ada pengajuan cashbon untuk filter yang dipilih.
        </div>
      </div>
    </div>

    <!-- Riwayat Potongan Penggajian (Repayments) -->
    {repayments.length > 0 && (
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100">
          <h2 class="text-sm font-bold text-slate-900">Riwayat Pemotongan Saat Penggajian</h2>
          <span class="text-xs text-slate-400">Daftar cicilan yang telah terpotong pada slip gaji Anda</span>
        </div>

        <div class="divide-y divide-slate-100 text-xs">
          {repayments.map((rp) => (
            <div class="p-3.5 sm:p-4 flex items-center justify-between">
              <div>
                <div class="font-bold text-slate-800">{rp.notes || 'Potongan gaji'}</div>
                <div class="text-[11px] text-slate-400 font-mono mt-0.5">
                  {formatIndonesianDate(rp.repaid_at.slice(0, 10))}
                </div>
              </div>
              <div class="text-right font-extrabold text-emerald-600 text-sm">
                -{formatRupiah(Number(rp.amount))}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Modal Edit Pengajuan Cashbon -->
  <div id="editCashbonModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 relative animate-in fade-in zoom-in-95 duration-200">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
        <div>
          <h3 class="text-sm font-bold text-slate-900">Ubah Pengajuan Cashbon</h3>
          <p class="text-[11px] text-slate-500">Edit nominal atau alasan kebutuhan sebelum direview admin</p>
        </div>
        <button
          type="button"
          onclick="closeEditCashbonModal()"
          class="w-7 h-7 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form id="editCashbonForm" onsubmit="submitEditCashbon(event)" class="space-y-4">
        <input type="hidden" id="editCashbonId" />

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">
            Nominal Diajukan (Rp) <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="editCashbonAmount"
            required
            oninput="formatRupiahInput(this)"
            placeholder="Contoh: 300.000"
            class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 text-sm font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">
            Alasan Kebutuhan <span class="text-rose-500">*</span>
          </label>
          <textarea
            id="editCashbonReason"
            required
            rows="3"
            placeholder="Jelaskan secara singkat keperluan mendesak Anda..."
            class="w-full px-4 py-2.5 rounded-2xl border border-slate-200 text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          ></textarea>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button
            type="button"
            onclick="closeEditCashbonModal()"
            class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 transition"
          >
            Batal
          </button>
          <button
            type="submit"
            id="editCashbonSubmitBtn"
            class="px-5 py-2 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition flex items-center gap-1.5"
          >
            Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function formatRupiahInput(el) {
      const cursor = el.selectionStart;
      const prevLen = el.value.length;
      const raw = el.value.replace(/\D/g, '');
      if (!raw) {
        el.value = '';
        return;
      }
      const formatted = new Intl.NumberFormat('id-ID').format(Number(raw));
      el.value = formatted;
      const diff = formatted.length - prevLen;
      const newPos = Math.max(0, (cursor || 0) + diff);
      try {
        el.setSelectionRange(newPos, newPos);
      } catch (e) {}
    }

    function getRawNumber(input) {
      if (!input) return 0;
      const str = typeof input === 'object' && 'value' in input ? input.value : String(input);
      return Number(str.replace(/\D/g, '')) || 0;
    }

    async function sendCashbon(amount, reason, btnEl) {
      const numAmount = getRawNumber(amount);
      if (!numAmount || numAmount <= 0) {
        alert('Nominal cashbon harus lebih besar dari 0');
        return;
      }
      if (!reason || !reason.trim()) {
        alert('Lengkapi alasan pengajuan cashbon');
        return;
      }

      if (btnEl) {
        btnEl.disabled = true;
        btnEl.textContent = 'Mengirim Permohonan...';
      }

      try {
        const res = await fetch('/api/cashbon', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            amount: numAmount,
            amount_requested: numAmount,
            reason: reason.trim(),
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal mengajukan cashbon');

        window.showToast?.('Permohonan cashbon berhasil diajukan!');
        setTimeout(() => location.reload(), 600);
      } catch (err) {
        alert(err.message);
        if (btnEl) {
          btnEl.disabled = false;
          btnEl.textContent = 'Kirim Pengajuan Cashbon';
        }
      }
    }

    async function submitApplyCashbon(e) {
      e.preventDefault();
      const amount = getRawNumber(document.getElementById('applyAmount'));
      const reason = document.getElementById('applyReason').value.trim();
      const btn = document.getElementById('applySubmitBtn');
      await sendCashbon(amount, reason, btn);
    }

    function openEditCashbonModal(id, amount, reason) {
      document.getElementById('editCashbonId').value = id;
      document.getElementById('editCashbonAmount').value = new Intl.NumberFormat('id-ID').format(amount);
      document.getElementById('editCashbonReason').value = reason || '';
      const modal = document.getElementById('editCashbonModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeEditCashbonModal() {
      const modal = document.getElementById('editCashbonModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    async function submitEditCashbon(e) {
      e.preventDefault();
      const id = document.getElementById('editCashbonId').value;
      const amount = getRawNumber(document.getElementById('editCashbonAmount'));
      const reason = document.getElementById('editCashbonReason').value.trim();
      const btn = document.getElementById('editCashbonSubmitBtn');

      if (!amount || amount <= 0) {
        alert('Nominal cashbon harus lebih besar dari 0');
        return;
      }
      if (!reason) {
        alert('Mohon cantumkan alasan pengajuan cashbon');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Menyimpan...';

      try {
        const res = await fetch('/api/cashbon', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, amount, reason }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal mengubah pengajuan cashbon');

        window.showToast?.('Pengajuan cashbon berhasil diperbarui');
        setTimeout(() => location.reload(), 600);
      } catch (err) {
        alert(err.message);
        btn.disabled = false;
        btn.textContent = 'Simpan Perubahan';
      }
    }

    async function deleteCashbon(id, amount) {
      const formatted = new Intl.NumberFormat('id-ID').format(amount);
      if (!confirm(`Apakah Anda yakin ingin membatalkan dan menghapus pengajuan cashbon sebesar Rp ${formatted}?`)) {
        return;
      }

      try {
        const res = await fetch(`/api/cashbon?id=${id}`, {
          method: 'DELETE',
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal membatalkan pengajuan');

        window.showToast?.('Pengajuan cashbon berhasil dibatalkan dan dihapus');
        setTimeout(() => location.reload(), 600);
      } catch (err) {
        alert(err.message);
      }
    }

    window.applyCashbonFilters = function () {
      const monthSelect = document.getElementById('filterMonth');
      const yearSelect = document.getElementById('filterYear');
      const statusSelect = document.getElementById('filterStatus');
      if (!monthSelect || !yearSelect || !statusSelect) return;

      const monthVal = monthSelect.value;
      const yearVal = yearSelect.value;
      const statusVal = statusSelect.value;

      const cards = Array.from(document.querySelectorAll('.cashbon-card'));
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardMonth = card.dataset.month;
        const cardYear = card.dataset.year;
        const cardStatus = card.dataset.status;

        let match = true;
        if (monthVal !== 'all' && cardMonth !== monthVal) {
          match = false;
        }
        if (yearVal !== 'all' && cardYear !== yearVal) {
          match = false;
        }
        if (statusVal !== 'all' && cardStatus !== statusVal) {
          match = false;
        }

        if (match) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      const badgeEl = document.getElementById('cashbonCountBadge');
      if (badgeEl) {
        if (monthVal === 'all' && yearVal === 'all' && statusVal === 'all') {
          badgeEl.textContent = `${visibleCount} Pengajuan`;
        } else {
          badgeEl.textContent = `${visibleCount} dari ${cards.length} Pengajuan`;
        }
      }

      const emptyFilteredEl = document.getElementById('cashbonEmptyFiltered');
      if (emptyFilteredEl) {
        emptyFilteredEl.classList.toggle('hidden', cards.length === 0 || visibleCount > 0);
      }
    };

    window.resetCashbonFilter = function () {
      const monthSelect = document.getElementById('filterMonth');
      const yearSelect = document.getElementById('filterYear');
      const statusSelect = document.getElementById('filterStatus');
      if (monthSelect) monthSelect.value = 'all';
      if (yearSelect) yearSelect.value = 'all';
      if (statusSelect) statusSelect.value = 'all';
      window.applyCashbonFilters();
    };

    // Apply on load
    window.applyCashbonFilters();
  </script>
</Layout>
