---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser } from '../../lib/auth';
import { queryOne, queryAll } from '../../lib/db';
import { computeEmployeeRealtimePayroll, formatRupiah, formatIndonesianDate, getJakartaTodayStr } from '../../lib/payroll';
import type { Employee, AttendanceRecord } from '../../lib/types';

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || currentUser.role !== 'karyawan' || !currentUser.employee_id) {
  return Astro.redirect('/login');
}

const employee = await queryOne<Employee>(
  'SELECT * FROM employees WHERE id = ?',
  [currentUser.employee_id]
);

if (!employee) {
  return Astro.redirect('/login');
}

const payrollInfo = await computeEmployeeRealtimePayroll(employee);

// Today's attendance
const todayStr = getJakartaTodayStr();
const todayAttendance = await queryOne<AttendanceRecord>(
  'SELECT * FROM attendance WHERE employee_id = ? AND date = ?',
  [employee.id, todayStr]
);

// Recent 5 attendance logs
const recentLogs = await queryAll<AttendanceRecord>(
  `SELECT * FROM attendance WHERE employee_id = ? ORDER BY date DESC, check_in DESC LIMIT 5`,
  [employee.id]
);

// Active unpaid cashbons
const rawActiveCashbons = await queryAll<{
  id: number;
  amount_requested: number;
  amount_approved: number;
  reason: string;
  status: string;
  remaining_status: string;
  disbursed_at: string;
  admin_notes: string | null;
  created_at: string;
  total_repaid: number;
}>(
  `SELECT 
     c.id, c.amount_requested, c.amount_approved, c.reason, c.status,
     COALESCE(c.remaining_status, 'open') AS remaining_status,
     c.disbursed_at, c.admin_notes, c.created_at,
     COALESCE(SUM(r.amount), 0) AS total_repaid
   FROM cashbon_requests c
   LEFT JOIN cashbon_repayments r ON c.id = r.cashbon_id
   WHERE c.employee_id = ? AND c.status IN ('approved', 'partial') AND c.disbursed_at IS NOT NULL
   GROUP BY c.id, c.amount_requested, c.amount_approved, c.reason, c.status,
            c.remaining_status, c.disbursed_at, c.admin_notes, c.created_at
   HAVING total_repaid < c.amount_approved
   ORDER BY c.disbursed_at DESC`,
  [employee.id]
);

function humanizeNotes(notes: string | null | undefined): string {
  if (!notes) return '';
  return notes
    .replace(/\s*\[Dana tahap ini telah dicairkan\]/gi, '')
    .replace(/\s*\[Dana dicairkan\]/gi, '')
    .replace(/\[Sisa (?:Rp )?[\d\.,]+ (?:ditutup|tidak dicairkan)[^\]]*?(?:-\s*Alasan:\s*([^\]]+))?\]/gi, (_m, reason) => {
      return reason ? `. Sisa pinjaman tidak dicairkan: ${reason.trim()}` : '. Sisa pinjaman tidak dicairkan.';
    })
    .replace(/\[([^\]]+)\]/g, '$1')
    .replace(/\s*\.\s*\./g, '.')
    .replace(/^\s*\.\s*/, '')
    .trim();
}

const activeCashbons = rawActiveCashbons.map((c) => {
  const approved = Number(c.amount_approved) || 0;
  const repaid = Number(c.total_repaid) || 0;
  const remaining = Math.max(0, approved - repaid);
  return {
    ...c,
    amount_approved: approved,
    total_repaid: repaid,
    remaining_balance: remaining,
    admin_notes: humanizeNotes(c.admin_notes),
  };
});

const totalUnpaidCashbon = activeCashbons.reduce((sum, c) => sum + c.remaining_balance, 0);
---

<Layout title="Beranda Karyawan" activeNav="karyawan-dashboard">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <!-- Welcome Card -->
    <div class="bg-gradient-to-r from-slate-900 to-indigo-950 rounded-3xl p-6 sm:p-7 text-white shadow-md mb-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-semibold text-indigo-300 block mb-1">
            Selamat Datang
          </span>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Halo, {employee.name}</h1>
          <p class="text-xs text-slate-300 mt-1">
            NIK: {employee.nik} • Gaji {employee.scheme.replace('_', ' ')}
          </p>
        </div>

        <a
          href="/karyawan/presensi"
          class="px-5 py-3 rounded-2xl bg-white text-slate-900 font-bold text-xs hover:bg-slate-100 transition shadow self-start sm:self-auto flex items-center gap-1.5"
        >
          <span>Absen Sekarang</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <!-- 3 Simple Info Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      <!-- Status Absen Hari Ini -->
      <div class="bg-white p-5 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-xs text-slate-400 font-medium block mb-2">Absen Hari Ini</span>
          {todayAttendance ? (
            <div>
              <div class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <span>Masuk: {todayAttendance.check_in}</span>
              </div>
              <p class="text-xs text-slate-500 mt-1">
                {todayAttendance.check_out ? `Pulang: ${todayAttendance.check_out}` : 'Sedang bekerja'}
              </p>
            </div>
          ) : (
            <div>
              <div class="text-base font-bold text-amber-600 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                <span>Belum Absen Masuk</span>
              </div>
              <p class="text-xs text-slate-500 mt-1">Tekan tombol untuk absen sekarang</p>
            </div>
          )}
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100">
          <a href="/karyawan/presensi" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">
            Buka Menu Absen &rarr;
          </a>
        </div>
      </div>

      <!-- Gaji Berjalan -->
      <div class="bg-white p-5 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
            <span>Gaji Berjalan Saya</span>
            <span class="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 font-semibold text-[10px] capitalize">
              Gaji {employee.scheme.replace('_', ' ')}
            </span>
          </div>
          <div class="text-2xl font-extrabold text-indigo-600">{payrollInfo.currency_formatted}</div>
          <p class="text-xs text-slate-500 mt-1">Terkumpul periode ini</p>
          {totalUnpaidCashbon > 0 && (
            <p class="text-[11px] text-rose-600 font-semibold mt-1">
              Potongan cashbon: -{formatRupiah(Math.min(payrollInfo.raw_amount, totalUnpaidCashbon))}
            </p>
          )}
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100">
          <a href="/karyawan/payroll" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">
            Lihat Rincian Gaji &rarr;
          </a>
        </div>
      </div>

      <!-- Jadwal Gajian -->
      <div class="bg-white p-5 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-xs text-slate-400 font-medium block mb-2">Jadwal Gajian Berikutnya</span>
          <div class="text-lg font-extrabold text-slate-900">{formatIndonesianDate(payrollInfo.next_payday)}</div>
          <p class="text-xs font-semibold text-emerald-600 mt-1">
            {payrollInfo.days_until_payday <= 0 ? 'Hari Ini / Siap Cair' : payrollInfo.days_until_payday + ' hari lagi'}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-400">
          Gaji dibayar tepat waktu
        </div>
      </div>
    </div>

    <!-- Section Cashbon Belum Terpotong Gaji -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-5 sm:p-6 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 pb-4 border-b border-slate-100">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-base font-bold text-slate-900">Cashbon Belum Terpotong Gaji</h2>
            {totalUnpaidCashbon > 0 ? (
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                {activeCashbons.length} Pinjaman Aktif
              </span>
            ) : (
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                Bebas Pinjaman
              </span>
            )}
          </div>
          <p class="text-xs text-slate-500 mt-0.5">
            Daftar dana cashbon yang telah cair ke Anda dan akan dipotong otomatis saat penggajian berikutnya
          </p>
        </div>

        <div class="flex items-center gap-3">
          {totalUnpaidCashbon > 0 && (
            <div class="text-left sm:text-right">
              <span class="text-[10px] text-slate-400 block font-medium">Total Belum Dipotong</span>
              <span class="text-lg font-black text-rose-600 block leading-tight">{formatRupiah(totalUnpaidCashbon)}</span>
            </div>
          )}
          <a
            href="/karyawan/cashbon"
            class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200 transition"
          >
            Kelola Cashbon &rarr;
          </a>
        </div>
      </div>

      {activeCashbons.length > 0 ? (
        <div class="space-y-3">
          {activeCashbons.map((cb) => (
            <div class="p-4 rounded-2xl bg-slate-50/70 border border-slate-200/80 hover:bg-slate-50 transition">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                    Uang Cair
                  </span>
                  <span class="text-xs text-slate-400 font-mono">
                    Cair: {formatIndonesianDate(cb.disbursed_at.slice(0, 10))}
                  </span>
                </div>
                <div class="text-xs">
                  <span class="text-slate-500">Alasan:</span>
                  <span class="font-semibold text-slate-800 ml-1">{cb.reason || '-'}</span>
                </div>
              </div>

              <!-- 3 Kolom Rincian Keuangan Pinjaman -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
                <div class="p-2.5 rounded-xl bg-white border border-slate-200">
                  <span class="text-[10px] text-slate-400 block">Total Pinjaman Cair</span>
                  <span class="text-sm font-extrabold text-slate-900 mt-0.5 block">{formatRupiah(cb.amount_approved)}</span>
                </div>
                <div class="p-2.5 rounded-xl bg-white border border-slate-200">
                  <span class="text-[10px] text-slate-400 block">Sudah Terpotong Gaji</span>
                  <span class="text-sm font-extrabold text-emerald-600 mt-0.5 block">{formatRupiah(cb.total_repaid)}</span>
                </div>
                <div class="p-2.5 rounded-xl bg-rose-50/70 border border-rose-200">
                  <span class="text-[10px] text-rose-700 block font-medium">Sisa Belum Dipotong (Utang)</span>
                  <span class="text-sm font-extrabold text-rose-600 mt-0.5 block">{formatRupiah(cb.remaining_balance)}</span>
                </div>
              </div>

              {cb.admin_notes && (
                <div class="mt-2 text-[11px] text-slate-500 bg-white/70 p-2 rounded-xl border border-slate-100">
                  <span class="font-semibold text-slate-600">Catatan Admin:</span> {cb.admin_notes}
                </div>
              )}
            </div>
          ))}

          <!-- Info Banner Pemotongan Otomatis -->
          <div class="mt-4 p-3 rounded-2xl bg-indigo-50/80 border border-indigo-100 flex items-start gap-2 text-xs text-indigo-950">
            <span class="text-indigo-600 font-bold text-sm">💡</span>
            <div>
              <strong>Kemana arah sisa pinjaman ini?</strong>
              <p class="text-[11px] text-indigo-800 mt-0.5 leading-relaxed">
                Sisa pinjaman sebesar <strong>{formatRupiah(totalUnpaidCashbon)}</strong> ini akan <strong>dipotong otomatis dari Slip Gaji Anda</strong> saat Admin memproses pembayaran gaji berikutnya. Anda tidak perlu membayar tunai ke kantor.
              </p>
            </div>
          </div>
        </div>
      ) : (
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 p-2 text-xs">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm">✓</span>
            <div>
              <span class="font-bold text-slate-800 block">Tidak ada potongan cashbon aktif</span>
              <span class="text-[11px] text-slate-500 block">Seluruh gaji berjalan akan Anda terima utuh saat jadwal gajian.</span>
            </div>
          </div>
          <a
            href="/karyawan/cashbon"
            class="px-3.5 py-1.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold transition shadow-sm"
          >
            + Ajukan Cashbon
          </a>
        </div>
      )}
    </div>

    <!-- Riwayat Absen Terbaru -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-5 sm:p-6">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
        <div>
          <h2 class="text-base font-bold text-slate-900">Riwayat Absen Terakhir</h2>
          <p class="text-xs text-slate-500">Catatan jam kerja Anda</p>
        </div>
        <a href="/karyawan/presensi" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">
          Lihat Semua &rarr;
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50/60 border-b border-slate-100 text-slate-400 font-semibold uppercase tracking-wider">
              <th class="py-3 px-3">Hari & Tanggal</th>
              <th class="py-3 px-3">Jam Masuk</th>
              <th class="py-3 px-3">Jam Pulang</th>
              <th class="py-3 px-3">Lama Kerja</th>
              <th class="py-3 px-3">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {recentLogs.map((log) => (
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-3 px-3 font-semibold text-slate-800 whitespace-nowrap">{formatIndonesianDate(log.date)}</td>
                <td class="py-3 px-3 font-mono text-slate-700">{log.check_in}</td>
                <td class="py-3 px-3 font-mono text-slate-700">{log.check_out || 'Belum Pulang'}</td>
                <td class="py-3 px-3 font-bold text-slate-900">
                  {log.duration_minutes > 0 ? `${(log.duration_minutes / 60).toFixed(1)} jam` : 'Sedang Kerja'}
                </td>
                <td class="py-3 px-3 whitespace-nowrap">
                  <span
                    class={`inline-flex items-center px-2 py-0.5 rounded-full font-semibold text-[10px] whitespace-nowrap ${
                      log.status === 'hadir'
                        ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                        : 'bg-amber-50 text-amber-700 border border-amber-200'
                    }`}
                  >
                    {log.status === 'hadir' ? 'Tepat Waktu' : 'Terlambat'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>
