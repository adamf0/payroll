---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser } from '../../lib/auth';
import { queryOne, queryAll } from '../../lib/db';
import { generateHourlyToken } from '../../lib/qr';
import type { Employee, AttendanceRecord } from '../../lib/types';
import { formatIndonesianDate } from '../../lib/payroll';

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || currentUser.role !== 'karyawan' || !currentUser.employee_id) {
  return Astro.redirect('/login');
}

const employee = await queryOne<Employee>('SELECT * FROM employees WHERE id = ?', [currentUser.employee_id]);
if (!employee) return Astro.redirect('/login');

const todayStr = new Date().toISOString().split('T')[0];
const todayRecord = await queryOne<AttendanceRecord>(
  'SELECT * FROM attendance WHERE employee_id = ? AND date = ?',
  [employee.id, todayStr]
);

const logs = await queryAll<AttendanceRecord>(
  `SELECT * FROM attendance WHERE employee_id = ? ORDER BY date DESC, check_in DESC LIMIT 30`,
  [employee.id]
);

const { token: currentToken } = generateHourlyToken(0);
---

<Layout title="Absen Mandiri" activeNav="karyawan-presensi">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Absen Mandiri
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Buka kamera untuk scan barcode di kantor, lalu tekan tombol absen.
        </p>
      </div>

      <div class="bg-white border border-slate-200/80 px-4 py-2 rounded-2xl shadow-sm text-left sm:text-right">
        <span class="text-[11px] text-slate-400 block">Hari Ini</span>
        <div class="text-sm font-bold text-slate-900">{formatIndonesianDate(todayStr)}</div>
      </div>
    </div>

    <!-- Main 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8">
      <!-- Left Column: Kamera & Tombol Absen (7 cols) -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-5 sm:p-7 border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
            <h2 class="text-sm font-bold text-slate-900">Kamera Pemindai</h2>
            <span id="camera-status-badge" class="text-xs px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium">
              Kamera Mati
            </span>
          </div>

          <!-- Video Viewfinder Container -->
          <div class="relative w-full h-56 sm:h-64 bg-slate-900 rounded-2xl overflow-hidden flex items-center justify-center">
            <video
              id="scanner-video"
              playsinline
              autoplay
              muted
              class="w-full h-full object-cover hidden"
            ></video>

            <!-- Placeholder saat kamera mati -->
            <div id="camera-placeholder" class="text-center p-6 text-slate-400">
              <div class="w-12 h-12 mx-auto mb-2 rounded-2xl bg-slate-800 flex items-center justify-center text-slate-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <p class="text-xs font-semibold text-slate-300">Kamera Belum Menyala</p>
              <p class="text-[11px] text-slate-500 mt-0.5">Tekan tombol "Buka Kamera" di bawah</p>
            </div>

            <!-- Frame pembidik -->
            <div id="scanner-overlay" class="hidden absolute inset-0 pointer-events-none flex items-center justify-center">
              <div class="w-40 h-40 border-2 border-emerald-400 rounded-2xl shadow-[0_0_15px_rgba(52,211,153,0.3)] relative">
                <div class="w-full h-0.5 bg-emerald-400 absolute top-1/2 -translate-y-1/2 animate-pulse"></div>
              </div>
            </div>
          </div>

          <!-- Tombol Kontrol Kamera -->
          <div class="flex flex-wrap items-center gap-2 mt-4">
            <button
              type="button"
              id="toggle-camera-btn"
              class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs transition shadow-sm flex items-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>Buka Kamera</span>
            </button>

            <button
              type="button"
              id="simulate-scan-btn"
              class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs transition border border-slate-200/80"
            >
              Ambil Kode Barcode Otomatis
            </button>
          </div>
        </div>

        <!-- Form Konfirmasi Absen -->
        <form id="karyawan-scan-form" class="mt-5 pt-4 border-t border-slate-100 space-y-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">
              Kode Barcode
            </label>
            <input
              type="text"
              id="qr-token-input"
              value={currentToken}
              class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs font-mono bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500"
              required
            />
          </div>

          <button
            type="submit"
            id="submit-scan-btn"
            class={`w-full py-3.5 rounded-xl font-bold text-sm transition shadow-sm flex items-center justify-center gap-2 text-white ${
              todayRecord && !todayRecord.check_out
                ? 'bg-amber-600 hover:bg-amber-700'
                : 'bg-emerald-600 hover:bg-emerald-700'
            }`}
          >
            {todayRecord && !todayRecord.check_out ? (
              <span>Absen Pulang Sekarang</span>
            ) : (
              <span>Absen Masuk Sekarang</span>
            )}
          </button>

          <div id="scan-feedback" class="hidden p-3.5 rounded-2xl border text-xs leading-relaxed mt-2 text-center"></div>
        </form>
      </div>

      <!-- Right Column: Status Kehadiran Hari Ini (5 cols) -->
      <div class="lg:col-span-5 bg-white rounded-3xl p-5 sm:p-7 border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-2">
            Status Hari Ini
          </span>

          {todayRecord ? (
            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 mb-5">
              <div class="flex items-center gap-2.5 mb-1">
                <span class="w-3 h-3 rounded-full bg-emerald-500 flex-shrink-0"></span>
                <div class="text-sm font-bold text-emerald-900">
                  {todayRecord.check_out ? 'Absen Hari Ini Selesai' : 'Sedang Masuk Kerja'}
                </div>
              </div>
              <p class="text-xs text-emerald-700">
                {todayRecord.check_out
                  ? `Sudah absen pulang jam ${todayRecord.check_out}. Selamat istirahat!`
                  : `Sudah absen masuk jam ${todayRecord.check_in}. Jangan lupa absen pulang ya.`}
              </p>
            </div>
          ) : (
            <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 mb-5">
              <div class="flex items-center gap-2.5 mb-1">
                <span class="w-3 h-3 rounded-full bg-amber-500 animate-pulse flex-shrink-0"></span>
                <div class="text-sm font-bold text-amber-900">Belum Absen Masuk</div>
              </div>
              <p class="text-xs text-amber-700">
                Silakan scan barcode atau tekan tombol "Absen Masuk Sekarang".
              </p>
            </div>
          )}

          <!-- Rincian Waktu Hari Ini -->
          <div class="grid grid-cols-2 gap-3 text-xs">
            <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100">
              <span class="text-slate-400 block text-[11px] mb-0.5">Jam Masuk</span>
              <span class="font-bold text-slate-900 text-sm">
                {todayRecord?.check_in || '-'}
              </span>
            </div>

            <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100">
              <span class="text-slate-400 block text-[11px] mb-0.5">Jam Pulang</span>
              <span class="font-bold text-slate-900 text-sm">
                {todayRecord?.check_out || (todayRecord ? 'Belum Pulang' : '-')}
              </span>
            </div>

            <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100">
              <span class="text-slate-400 block text-[11px] mb-0.5">Durasi Kerja</span>
              <span class="font-bold text-slate-900 text-sm">
                {todayRecord
                  ? todayRecord.duration_minutes > 0
                    ? `${(todayRecord.duration_minutes / 60).toFixed(1)} jam`
                    : 'Sedang berjalan'
                  : '-'}
              </span>
            </div>

            <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100">
              <span class="text-slate-400 block text-[11px] mb-0.5">Keterangan</span>
              {todayRecord ? (
                <span class={`inline-block font-semibold text-[11px] px-2 py-0.5 rounded-full ${
                  todayRecord.status === 'hadir'
                    ? 'bg-emerald-100 text-emerald-800'
                    : 'bg-amber-100 text-amber-800'
                }`}>
                  {todayRecord.status === 'hadir' ? 'Tepat Waktu' : 'Terlambat'}
                </span>
              ) : (
                <span class="text-slate-400 text-xs">-</span>
              )}
            </div>
          </div>
        </div>

        <!-- Info Karyawan -->
        <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
          <div>
            <div class="font-bold text-slate-800">{employee.name}</div>
            <div class="text-[11px] text-slate-400">NIK: {employee.nik}</div>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 font-semibold text-[11px] capitalize">
            Gaji {employee.scheme.replace('_', ' ')}
          </span>
        </div>
      </div>
    </div>

    <!-- Riwayat Absen Pribadi -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900">Riwayat Absen Saya</h2>
          <p class="text-xs text-slate-500">Catatan jam masuk dan pulang Anda</p>
        </div>
        <span class="text-xs px-3 py-1 rounded-full bg-slate-100 text-slate-600 font-medium">
          {logs.length} Catatan
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50/60 border-b border-slate-100 text-slate-400 font-semibold uppercase tracking-wider">
              <th class="py-3 px-4">Hari & Tanggal</th>
              <th class="py-3 px-4">Jam Masuk</th>
              <th class="py-3 px-4">Jam Pulang</th>
              <th class="py-3 px-4">Lama Kerja</th>
              <th class="py-3 px-4">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {logs.length > 0 ? (
              logs.map((log) => (
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3 px-4 font-semibold text-slate-900 whitespace-nowrap">
                    {formatIndonesianDate(log.date)}
                  </td>
                  <td class="py-3 px-4 font-mono font-medium text-slate-700">{log.check_in}</td>
                  <td class="py-3 px-4 font-mono font-medium text-slate-700">
                    {log.check_out || 'Belum Pulang'}
                  </td>
                  <td class="py-3 px-4 font-bold text-slate-900">
                    {log.duration_minutes > 0 ? `${(log.duration_minutes / 60).toFixed(1)} jam` : 'Sedang Kerja'}
                  </td>
                  <td class="py-3 px-4 whitespace-nowrap">
                    <span
                      class={`inline-flex items-center px-2.5 py-0.5 rounded-full font-semibold text-[10px] whitespace-nowrap ${
                        log.status === 'hadir'
                          ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                          : 'bg-amber-50 text-amber-700 border border-amber-200'
                      }`}
                    >
                      {log.status === 'hadir' ? 'Tepat Waktu' : 'Terlambat'}
                    </span>
                  </td>
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="5" class="py-8 text-center text-slate-400">
                  Belum ada catatan absen.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline>
    let stream = null;
    let scanTimer = null;
    const video = document.getElementById('scanner-video');
    const placeholder = document.getElementById('camera-placeholder');
    const overlay = document.getElementById('scanner-overlay');
    const toggleCameraBtn = document.getElementById('toggle-camera-btn');
    const cameraStatusBadge = document.getElementById('camera-status-badge');
    const tokenInput = document.getElementById('qr-token-input');
    const simulateBtn = document.getElementById('simulate-scan-btn');
    const form = document.getElementById('karyawan-scan-form');
    const feedback = document.getElementById('scan-feedback');

    async function startCamera() {
      try {
        cameraStatusBadge.textContent = 'Membuka kamera...';
        stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'environment' }
        });
        video.srcObject = stream;
        video.classList.remove('hidden');
        placeholder.classList.add('hidden');
        overlay.classList.remove('hidden');

        await video.play();

        cameraStatusBadge.textContent = 'Kamera Aktif';
        cameraStatusBadge.className = 'text-xs px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 font-semibold';
        toggleCameraBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span>Tutup Kamera</span>
        `;
        toggleCameraBtn.classList.replace('bg-indigo-600', 'bg-slate-800');

        if ('BarcodeDetector' in window) {
          const barcodeDetector = new window.BarcodeDetector({ formats: ['qr_code'] });
          scanTimer = setInterval(async () => {
            if (!video.videoWidth) return;
            try {
              const barcodes = await barcodeDetector.detect(video);
              if (barcodes.length > 0) {
                const scannedVal = barcodes[0].rawValue;
                if (scannedVal && scannedVal.startsWith('FERMI-')) {
                  tokenInput.value = scannedVal;
                  stopCamera();
                  if (window.showToast) window.showToast('Barcode berhasil dibaca!', 'success');
                  submitAttendance(scannedVal);
                }
              }
            } catch (err) {}
          }, 350);
        }
      } catch (err) {
        cameraStatusBadge.textContent = 'Kamera tidak dapat diakses';
        cameraStatusBadge.className = 'text-xs px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-700 font-semibold';
        if (window.showToast) window.showToast('Izin kamera belum diaktifkan', 'error');
      }
    }

    function stopCamera() {
      if (scanTimer) clearInterval(scanTimer);
      if (stream) {
        stream.getTracks().forEach((track) => track.stop());
        stream = null;
      }
      if (video) video.srcObject = null;
      video.classList.add('hidden');
      placeholder.classList.remove('hidden');
      overlay.classList.add('hidden');

      cameraStatusBadge.textContent = 'Kamera Mati';
      cameraStatusBadge.className = 'text-xs px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium';
      toggleCameraBtn.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span>Buka Kamera</span>
      `;
      toggleCameraBtn.classList.replace('bg-slate-800', 'bg-indigo-600');
    }

    toggleCameraBtn.addEventListener('click', () => {
      if (stream) {
        stopCamera();
      } else {
        startCamera();
      }
    });

    simulateBtn.addEventListener('click', async () => {
      try {
        const res = await fetch('/api/attendance/active-qr');
        const data = await res.json();
        if (data && data.token) {
          tokenInput.value = data.token;
          if (window.showToast) window.showToast('Kode barcode berhasil diambil!');
        }
      } catch (err) {
        if (window.showToast) window.showToast('Gagal mengambil kode barcode', 'error');
      }
    });

    async function submitAttendance(token) {
      try {
        const res = await fetch('/api/attendance/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token }),
        });
        const data = await res.json();

        feedback.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-900', 'border-emerald-200', 'bg-rose-50', 'text-rose-900', 'border-rose-200');

        if (res.ok && data.success) {
          feedback.classList.add('bg-emerald-50', 'text-emerald-900', 'border-emerald-200');
          feedback.innerHTML = `<strong>Berhasil:</strong> ${data.message}`;
          if (window.showToast) window.showToast(data.message, 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else {
          feedback.classList.add('bg-rose-50', 'text-rose-900', 'border-rose-200');
          feedback.innerHTML = `<strong>Belum Berhasil:</strong> ${data.error || 'Silakan coba lagi'}`;
          if (window.showToast) window.showToast(data.error || 'Gagal absen', 'error');
        }
      } catch (err) {
        alert('Gagal terhubung ke server');
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const token = tokenInput.value.trim();
      if (!token) return;
      submitAttendance(token);
    });
  </script>
</Layout>
