---
import Layout from '../../layouts/Layout.astro';
import { getCurrentUser } from '../../lib/auth';
import { queryOne, queryAll } from '../../lib/db';
import { 
  computeEmployeeRealtimePayroll, 
  formatRupiah, 
  formatIndonesianDate, 
  getJakartaNow,
  getEmployeePayrollCycle,
  getSettledPayrollInPeriod,
  getRateUnitLabel
} from '../../lib/payroll';
import type { Employee, PayrollSettlement } from '../../lib/types';

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || currentUser.role !== 'karyawan' || !currentUser.employee_id) {
  return Astro.redirect('/login');
}

const employee = await queryOne<Employee>('SELECT * FROM employees WHERE id = ?', [currentUser.employee_id]);
if (!employee) return Astro.redirect('/login');

const jakartaNow = getJakartaNow();
const currentYear = parseInt(jakartaNow.dateStr.substring(0, 4), 10);
const currentMonthStr = jakartaNow.dateStr.substring(5, 7);

// Active payroll cycle based on employee's start working date (join_date)
const cycleInfo = getEmployeePayrollCycle(employee);
const defaultStartDate = cycleInfo.startDate;
const defaultEndDate = cycleInfo.endDate;

const payrollInfo = await computeEmployeeRealtimePayroll(employee, defaultStartDate, defaultEndDate);
const settledInfo = await getSettledPayrollInPeriod(employee.id, defaultStartDate, defaultEndDate);

// Fetch all unbilled attendance records for this employee (for client-side dynamic filtering)
const allUnbilledRecords = await queryAll<{
  id: number;
  date_str: string;
  duration_minutes: number;
  status: string;
}>(`
  SELECT a.id, 
         DATE_FORMAT(a.date, '%Y-%m-%d') as date_str,
         a.duration_minutes, a.status
  FROM attendance a
  WHERE a.employee_id = ?
    AND NOT EXISTS (
      SELECT 1 FROM payroll_settlements s
      WHERE s.employee_id = a.employee_id
        AND a.date >= s.period_start
        AND a.date <= s.period_end
    )
  ORDER BY a.date ASC
`, [employee.id]);

// Fetch settled payouts for this employee
const settlements = await queryAll<PayrollSettlement>(
  `SELECT * FROM payroll_settlements WHERE employee_id = ? ORDER BY id DESC`,
  [employee.id]
);

// Fetch cashbon repayments linked to this employee's settlements
const rawRepayments = await queryAll<{
  id: number;
  cashbon_id: number;
  settlement_id: number;
  deduction_amount: number;
  repaid_at: string;
  repayment_notes: string | null;
  amount_requested: number;
  amount_approved: number;
  reason: string;
  cashbon_status: string;
  remaining_status: string;
  disbursed_at: string | null;
  admin_notes: string | null;
  cashbon_created_at: string;
  total_repaid_all: number;
}>(`
  SELECT 
    r.id,
    r.cashbon_id,
    r.settlement_id,
    r.amount AS deduction_amount,
    r.repaid_at,
    r.notes AS repayment_notes,
    c.amount_requested,
    c.amount_approved,
    c.reason,
    c.status AS cashbon_status,
    c.remaining_status,
    c.disbursed_at,
    c.admin_notes,
    c.created_at AS cashbon_created_at,
    (SELECT COALESCE(SUM(cr.amount), 0) FROM cashbon_repayments cr WHERE cr.cashbon_id = c.id) AS total_repaid_all
  FROM cashbon_repayments r
  JOIN cashbon_requests c ON r.cashbon_id = c.id
  WHERE r.settlement_id IN (
    SELECT id FROM payroll_settlements WHERE employee_id = ?
  )
  ORDER BY r.id ASC
`, [employee.id]);

const repaymentsBySettlement = new Map<number, typeof rawRepayments>();
for (const rep of rawRepayments) {
  const list = repaymentsBySettlement.get(rep.settlement_id) || [];
  list.push(rep);
  repaymentsBySettlement.set(rep.settlement_id, list);
}

function getUnitLabel(scheme: string, units: number) {
  if (scheme === 'per_jam') return `${units} Jam Kerja`;
  if (scheme === 'harian') return `${units} Hari Kerja`;
  if (scheme === 'mingguan') return `${units} Minggu`;
  return `${units} Bulan`;
}

const settlementRows = settlements.map((s) => {
  const baseWageNum = Number(s.rate) * Number(s.total_units);
  const allwNum = Number(s.allowance) || 0;
  const ovtNum = Number(s.overtime_pay) || 0;
  const bnsNum = Number(s.bonus) || 0;
  const grossNum = baseWageNum + allwNum + ovtNum + bnsNum;
  const cashbonNum = Number(s.cashbon_deduction) || 0;
  const netNum = Number(s.amount_paid);

  const periodStartStr = s.period_start ? s.period_start.toString().substring(0, 10) : '';
  const periodEndStr = s.period_end ? s.period_end.toString().substring(0, 10) : '';
  const settledDateStr = s.settled_at ? s.settled_at.toString().substring(0, 10) : '';

  const linkedRepayments = repaymentsBySettlement.get(s.id) || [];
  const cashbonModalPayload = {
    slipNo: `#SLIP-${s.id.toString().padStart(4, '0')}`,
    period: `${formatIndonesianDate(s.period_start, false)} s/d ${formatIndonesianDate(s.period_end, false)}`,
    settledDate: formatIndonesianDate(s.settled_at),
    totalDeduction: cashbonNum,
    totalDeductionFormatted: formatRupiah(cashbonNum),
    items: linkedRepayments.map((item) => {
      const approved = Number(item.amount_approved) || 0;
      const repaidAll = Number(item.total_repaid_all) || 0;
      const remaining = Math.max(0, approved - repaidAll);
      const isFull = remaining <= 0 || item.cashbonStatus === 'settled';
      return {
        repaymentId: item.id,
        cashbonId: item.cashbon_id,
        cashbonCode: `#CSB-${item.cashbon_id.toString().padStart(4, '0')}`,
        deductionAmount: Number(item.deduction_amount) || 0,
        deductionFormatted: formatRupiah(Number(item.deduction_amount) || 0),
        amountApproved: approved,
        amountApprovedFormatted: formatRupiah(approved),
        amountRequested: Number(item.amount_requested) || 0,
        amountRequestedFormatted: formatRupiah(Number(item.amount_requested) || 0),
        totalRepaidAll: repaidAll,
        totalRepaidAllFormatted: formatRupiah(repaidAll),
        remaining: remaining,
        remainingFormatted: formatRupiah(remaining),
        isFull,
        statusBadgeLabel: isFull ? 'Lunas Terpotong Penuh' : 'Potongan Sebagian (Parsial)',
        reason: item.reason,
        cashbonStatus: item.cashbon_status,
        disbursedAtFormatted: item.disbursed_at ? formatIndonesianDate(item.disbursed_at) : '-',
        createdAtFormatted: item.cashbon_created_at ? formatIndonesianDate(item.cashbon_created_at) : '-',
        repaymentNotes: item.repayment_notes || `Potongan otomatis gaji via slip #${s.id}`,
        adminNotes: item.admin_notes || '-'
      };
    })
  };

  const slipDataObj = {
    slipNo: `#SLIP-${s.id.toString().padStart(4, '0')}`,
    empName: employee.name,
    empNik: employee.nik,
    position: employee.position || '',
    period: `${formatIndonesianDate(s.period_start, false)} s/d ${formatIndonesianDate(s.period_end, false)}`,
    scheme: s.scheme.replace('_', ' '),
    units: getUnitLabel(s.scheme, s.total_units),
    rateFormatted: `${formatRupiah(s.rate)} ${getRateUnitLabel(s.scheme)}`,
    baseWage: formatRupiah(baseWageNum),
    allowance: formatRupiah(allwNum),
    overtime: formatRupiah(ovtNum),
    bonus: formatRupiah(bnsNum),
    cashbon: formatRupiah(cashbonNum),
    amountFormatted: formatRupiah(netNum),
    settledDate: formatIndonesianDate(s.settled_at),
    cashbonData: cashbonModalPayload
  };

  return {
    s,
    slipDataObj,
    cashbonModalPayload,
    grossNum,
    cashbonNum,
    netNum,
    periodStartStr,
    periodEndStr,
    settledDateStr
  };
});

const monthsList = [
  { val: 'all', label: 'Semua Bulan' },
  { val: '01', label: 'Januari' },
  { val: '02', label: 'Februari' },
  { val: '03', label: 'Maret' },
  { val: '04', label: 'April' },
  { val: '05', label: 'Mei' },
  { val: '06', label: 'Juni' },
  { val: '07', label: 'Juli' },
  { val: '08', label: 'Agustus' },
  { val: '09', label: 'September' },
  { val: '10', label: 'Oktober' },
  { val: '11', label: 'November' },
  { val: '12', label: 'Desember' },
];

const currentMonthLabel = monthsList.find((m) => m.val === currentMonthStr)?.label || 'Bulan Ini';
const yearsList = [currentYear - 1, currentYear, currentYear + 1];
---

<Layout title="Gaji & Slip Saya" activeNav="karyawan-payroll">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Gaji & Slip Saya</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Pantau gaji yang terkumpul saat ini dan riwayat slip gaji yang telah dibayarkan.
        </p>
      </div>

      <div class="bg-white border border-slate-200/80 px-4 py-2 rounded-2xl shadow-sm self-start sm:self-auto text-left sm:text-right">
        <span class="text-[11px] text-slate-400 block">Jenis Gaji</span>
        <div class="text-sm font-bold text-slate-900 capitalize">
          Gaji {employee.scheme.replace('_', ' ')}
        </div>
      </div>
    </div>

    <!-- Filter Bar: Pilih Bulan / Tanggal Spesifik (Mengontrol Gaji Berjalan & Riwayat Slip) -->
    <div class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-sm mb-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
          <!-- Dropdown Bulan -->
          <div>
            <label for="filterMonth" class="block text-[10px] font-semibold text-slate-400 mb-1">Pilih Bulan</label>
            <select
              id="filterMonth"
              onchange="onMonthOrYearChange()"
              class="px-3 py-1.5 rounded-xl border border-slate-200 text-xs font-medium text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer shadow-sm"
            >
              {monthsList.map((m) => (
                <option value={m.val} selected={m.val === currentMonthStr}>{m.label}</option>
              ))}
            </select>
          </div>

          <!-- Dropdown Tahun -->
          <div>
            <label for="filterYear" class="block text-[10px] font-semibold text-slate-400 mb-1">Tahun</label>
            <select
              id="filterYear"
              onchange="onMonthOrYearChange()"
              class="px-3 py-1.5 rounded-xl border border-slate-200 text-xs font-medium text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer shadow-sm"
            >
              {yearsList.map((y) => (
                <option value={y} selected={y === currentYear}>{y}</option>
              ))}
            </select>
          </div>

          <div class="hidden sm:block text-slate-300 font-bold text-xs self-end pb-2">atau</div>

          <!-- Tanggal Spesifik -->
          <div>
            <label class="block text-[10px] font-semibold text-slate-400 mb-1">Pilih Tanggal Spesifik</label>
            <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-xl px-2.5 py-1.5 shadow-sm focus-within:ring-2 focus-within:ring-indigo-500">
              <input
                type="date"
                id="filterStartDate"
                value={defaultStartDate}
                onchange="onSpecificDateChange()"
                class="text-xs font-medium text-slate-700 bg-transparent focus:outline-none cursor-pointer"
                title="Dari Tanggal"
              />
              <span class="text-slate-300 text-xs">s/d</span>
              <input
                type="date"
                id="filterEndDate"
                value={defaultEndDate}
                onchange="onSpecificDateChange()"
                class="text-xs font-medium text-slate-700 bg-transparent focus:outline-none cursor-pointer"
                title="Sampai Tanggal"
              />
            </div>
          </div>
        </div>

        <!-- Reset Filter Button -->
        <div class="self-end sm:self-center">
          <button
            type="button"
            onclick="resetSlipFilter()"
            class="px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-100 text-slate-600 text-xs font-semibold transition shadow-sm cursor-pointer"
          >
            Reset Filter
          </button>
        </div>
      </div>
    </div>

    <!-- Gaji & Ringkasan Periode Ini Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-sm mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span id="gaji-berjalan-period-title" class="text-xs font-semibold text-slate-400">
              Periode Penggajian: {cycleInfo.label}
            </span>
            <span class="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 font-semibold text-[10px] capitalize">
              Gaji {employee.scheme.replace('_', ' ')}
            </span>
          </div>

          <div class="flex flex-wrap items-baseline gap-6 mt-2">
            <div>
              <span class="text-[11px] text-slate-400 block mb-0.5">Gaji Sudah Cair</span>
              <div id="gaji-settled-amount" class={`text-2xl sm:text-3xl font-extrabold ${settledInfo.totalGross > 0 ? 'text-slate-900' : 'text-slate-700'}`}>
                {formatRupiah(settledInfo.totalGross)}
              </div>
            </div>

            <div class="border-l border-slate-200 pl-6">
              <span class="text-[11px] text-slate-400 block mb-0.5">Potongan Cashbon</span>
              <div id="gaji-cashbon-amount" class={`text-2xl sm:text-3xl font-extrabold ${settledInfo.totalCashbon > 0 ? 'text-rose-600' : 'text-slate-400'}`}>
                {settledInfo.totalCashbon > 0 ? `-${formatRupiah(settledInfo.totalCashbon)}` : formatRupiah(0)}
              </div>
            </div>

            <div class="border-l border-slate-200 pl-6">
              <span class="text-[11px] text-slate-400 block mb-0.5">Gaji Bersih</span>
              <div id="gaji-net-amount" class={`text-2xl sm:text-3xl font-extrabold ${settledInfo.totalNet > 0 ? 'text-emerald-600' : 'text-slate-700'}`}>
                {formatRupiah(settledInfo.totalNet)}
              </div>
            </div>

            <!-- <div class="border-l border-slate-200 pl-6">
              <span class="text-[11px] text-slate-400 block mb-0.5">Gaji Belum Cair (Berjalan)</span>
              <div id="gaji-berjalan-amount" class="text-2xl sm:text-3xl font-extrabold text-indigo-600">
                {payrollInfo.currency_formatted}
              </div>
            </div> -->
          </div>

          <p id="gaji-berjalan-desc" class="text-xs text-slate-500 mt-2">
            {payrollInfo.accrued_amount > 0
              ? (employee.scheme === 'per_jam' || employee.scheme === 'harian'
                ? 'Gaji berjalan yang siap dicairkan hari itu juga'
                : 'Gaji yang sudah terkumpul (akan cair pada tanggal gajian)')
              : (employee.scheme === 'per_jam' || employee.scheme === 'harian'
                ? 'Tidak ada jam kerja berjalan yang belum dicairkan pada periode ini'
                : 'Tidak ada gaji berjalan belum dicairkan pada periode ini')}
          </p>
        </div>

        <div class="text-left sm:text-right">
          <span class="text-xs text-slate-400 block mb-1">Jadwal Gajian</span>
          {employee.scheme === 'per_jam' || employee.scheme === 'harian' ? (
            <div>
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-bold border border-emerald-200">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Bisa Cair Hari Ini
              </span>
              <p class="text-[10px] text-slate-400 mt-1">Bisa bayar hari itu juga</p>
            </div>
          ) : (
            <div>
              <div class="text-base font-bold text-slate-900 whitespace-nowrap">
                {formatIndonesianDate(payrollInfo.next_payday)}
              </div>
              <span class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-[11px] mt-1 border border-emerald-200">
                {payrollInfo.days_until_payday <= 0 ? 'Siap Cair Hari Ini' : payrollInfo.days_until_payday + ' hari lagi'}
              </span>
            </div>
          )}
        </div>
      </div>

      <!-- Rincian Sederhana -->
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 pt-5 text-xs">
        <div>
          <span class="text-slate-400 block mb-1">Tarif / Gaji Pokok</span>
          <div class="text-sm font-bold text-slate-900">
            {formatRupiah(employee.base_rate)} {getRateUnitLabel(employee.scheme)}
          </div>
          <span class="text-[10px] text-slate-400 block mt-0.5">
            {employee.scheme === 'mingguan' ? 'Dibagi 6 hari kerja/minggu' : employee.scheme === 'bulanan' ? 'Dibagi 26 hari kerja/bulan' : ''}
          </span>
        </div>

        <div>
          <span class="text-slate-400 block mb-1">Slip Gaji Dicairkan</span>
          <div id="gaji-settled-count" class="text-sm font-bold text-slate-900">
            {settledInfo.settlementCount > 0 ? `${settledInfo.settlementCount} Slip Dicairkan` : 'Belum Ada'}
          </div>
          <span id="gaji-settled-sublabel" class="text-[10px] text-slate-400 block mt-0.5">
            Bersih {formatRupiah(settledInfo.totalNet)}
          </span>
        </div>

        <div>
          <span class="text-slate-400 block mb-1">Data Kehadiran Periode Ini</span>
          <div id="gaji-berjalan-attendance-label" class="text-sm font-bold text-slate-900">
            {payrollInfo.attendance_label}
          </div>
          {payrollInfo.attendance_badge && (
            <span id="gaji-berjalan-attendance-badge" class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold mt-1 ${
              payrollInfo.attendance_badge_type === 'warning'
                ? 'bg-amber-100 text-amber-800'
                : payrollInfo.attendance_badge_type === 'danger'
                ? 'bg-rose-100 text-rose-800'
                : payrollInfo.attendance_badge_type === 'success'
                ? 'bg-emerald-100 text-emerald-800'
                : 'bg-slate-100 text-slate-700'
            }`}>
              {payrollInfo.attendance_badge}
            </span>
          )}
        </div>

        <div>
          <span class="text-slate-400 block mb-1">Aturan Gajian</span>
          <div class="text-sm font-bold text-slate-900">
            {employee.scheme === 'per_jam' || employee.scheme === 'harian'
              ? 'Hari Itu Juga (Harian)'
              : employee.payday_rule === 'jumat'
              ? 'Setiap Hari Jumat'
              : `Setiap Tanggal ${employee.payday_rule}`}
          </div>
        </div>
      </div>
    </div>

    <!-- Riwayat Slip Gaji -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-base font-bold text-slate-900">Riwayat Slip Gaji</h2>
          <p class="text-xs text-slate-500">Bukti resmi pembayaran gaji dan potongan pinjaman (cashbon)</p>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="exportRekapPDF()"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition cursor-pointer"
            title="Export Rekapitulasi Slip Gaji ke PDF"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Export PDF (Rekap)
          </button>
          <span id="badge-total-slips" class="text-xs px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 font-semibold">
            {settlements.length} Slip Tersedia
          </span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider text-[11px]">
              <th class="py-3 px-4">No. Slip</th>
              <th class="py-3 px-4">Periode Kerja</th>
              <th class="py-3 px-4">Total Kerja</th>
              <th class="py-3 px-4 text-right">Gaji Kotor</th>
              <th class="py-3 px-4 text-right">Potongan Cashbon</th>
              <th class="py-3 px-4 text-right">Gaji Bersih</th>
              <th class="py-3 px-4 text-center">Tanggal Bayar</th>
              <th class="py-3 px-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="slip-table-body">
            {settlementRows.length > 0 ? (
              settlementRows.map(({ s, slipDataObj, cashbonModalPayload, grossNum, cashbonNum, netNum, periodStartStr, periodEndStr, settledDateStr }) => (
                  <tr
                    class="slip-row hover:bg-slate-50/80 transition-colors"
                    data-slip-no={slipDataObj.slipNo}
                    data-period-start={periodStartStr}
                    data-period-end={periodEndStr}
                    data-settled-date={settledDateStr}
                    data-period={slipDataObj.period}
                    data-units={slipDataObj.units}
                    data-gross={grossNum}
                    data-cashbon={cashbonNum}
                    data-net={netNum}
                    data-settled-date-formatted={slipDataObj.settledDate}
                  >
                    <td class="py-3.5 px-4 font-mono font-bold text-slate-900 whitespace-nowrap">
                      {slipDataObj.slipNo}
                    </td>
                    <td class="py-3.5 px-4 font-medium text-slate-800 whitespace-nowrap">
                      {slipDataObj.period}
                    </td>
                    <td class="py-3.5 px-4 whitespace-nowrap">
                      <span class="font-semibold text-slate-700">{slipDataObj.units}</span>
                    </td>
                    <td class="py-3.5 px-4 text-right font-medium text-slate-700 whitespace-nowrap">
                      {formatRupiah(grossNum)}
                    </td>
                    <td class="py-3.5 px-4 text-right whitespace-nowrap">
                      {cashbonNum > 0 ? (
                        <button
                          type="button"
                          onclick={`openCashbonModal(${JSON.stringify(cashbonModalPayload)})`}
                          class="inline-flex items-center gap-1.5 font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 hover:text-rose-800 px-2.5 py-1 rounded-xl border border-rose-200 hover:border-rose-300 transition text-xs cursor-pointer shadow-sm group"
                          title="Klik untuk melihat rincian cashbon yang dipotong pada slip ini"
                        >
                          <span>-{formatRupiah(cashbonNum)}</span>
                          <svg class="w-3.5 h-3.5 text-rose-400 group-hover:text-rose-700 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                        </button>
                      ) : (
                        <span class="text-slate-400 font-medium">-</span>
                      )}
                    </td>
                    <td class="py-3.5 px-4 text-right whitespace-nowrap">
                      <span class="font-extrabold text-emerald-700 text-sm">{formatRupiah(netNum)}</span>
                    </td>
                    <td class="py-3.5 px-4 text-center text-slate-600 whitespace-nowrap">
                      {formatIndonesianDate(s.settled_at)}
                    </td>
                    <td class="py-3.5 px-4 text-right whitespace-nowrap">
                      <div class="inline-flex items-center gap-1.5">
                        <button
                          type="button"
                          onclick={`openSlipModal(${JSON.stringify(slipDataObj)})`}
                          class="px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold transition text-xs cursor-pointer"
                          title="Lihat Rincian Slip Gaji"
                        >
                          Lihat Detail
                        </button>
                        <button
                          type="button"
                          onclick={`printSlip(${JSON.stringify(slipDataObj)})`}
                          class="px-3 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold transition text-xs border border-indigo-200 cursor-pointer inline-flex items-center gap-1"
                          title="Cetak / Simpan Slip ke PDF"
                        >
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                          Cetak Slip
                        </button>
                      </div>
                    </td>
                  </tr>
                )
              )
            ) : null}
            <tr id="no-slips-row" class={settlements.length > 0 ? "hidden" : ""}>
              <td colspan="8" class="py-8 text-center text-slate-400">
                Belum ada riwayat slip gaji sebelumnya.
              </td>
            </tr>
            <tr id="no-slips-filtered-row" class="hidden">
              <td colspan="8" class="py-8 text-center text-slate-400">
                Tidak ada slip gaji yang sesuai dengan filter bulan/tanggal yang dipilih.
              </td>
            </tr>
          </tbody>
          <tfoot id="slip-table-tfoot" class="bg-slate-50/90 border-t-2 border-slate-200 font-bold text-slate-800">
            <tr>
              <td colspan="3" class="py-3.5 px-4 text-right text-slate-600 font-bold text-xs">
                Total Terfilter (<span id="summary-slip-count">0</span> Slip):
              </td>
              <td class="py-3.5 px-4 text-right text-slate-900" id="summary-gross-val">Rp 0</td>
              <td class="py-3.5 px-4 text-right text-rose-600" id="summary-cashbon-val">-Rp 0</td>
              <td class="py-3.5 px-4 text-right text-emerald-700 text-sm font-extrabold" id="summary-net-val">Rp 0</td>
              <td colspan="2" class="py-3.5 px-4"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Slip Gaji Lengkap -->
  <div id="slip-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full border border-slate-200 shadow-xl overflow-hidden">
      <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
        <div class="text-sm font-bold flex items-center gap-2">
          <span>Bukti Slip Gaji</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-indigo-300 font-mono font-normal">Payrollku</span>
        </div>
        <button
          type="button"
          onclick="closeSlipModal()"
          class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-white flex items-center justify-center text-sm font-bold cursor-pointer"
        >
          &times;
        </button>
      </div>

      <div class="p-6 text-xs text-slate-700 space-y-3">
        <div class="flex justify-between pb-3 border-b border-slate-100">
          <span class="text-slate-400">Nomor Slip:</span>
          <strong id="modal-slip-no" class="font-mono text-slate-900">#SLIP-0000</strong>
        </div>

        <div class="space-y-2 py-1">
          <div class="flex justify-between">
            <span class="text-slate-500">Nama:</span>
            <strong id="modal-emp-name" class="text-slate-900">Nama</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Periode Kerja:</span>
            <span id="modal-period" class="text-slate-800">Periode</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Jenis Gaji:</span>
            <span id="modal-scheme" class="text-slate-800 capitalize font-medium">Skema</span>
          </div>
          <div class="border-t border-slate-100 pt-2 font-semibold text-slate-500 text-[11px] uppercase tracking-wider">
            Pendapatan
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Gaji Pokok:</span>
            <span id="modal-base-wage" class="font-medium text-slate-800">Rp 0</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Tunjangan:</span>
            <span id="modal-allowance" class="font-medium text-slate-800">Rp 0</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Lembur & Bonus:</span>
            <span id="modal-additional" class="font-medium text-slate-800">Rp 0</span>
          </div>
          <div class="border-t border-slate-100 pt-2 font-semibold text-rose-600 text-[11px] uppercase tracking-wider">
            Potongan
          </div>
          <div class="flex justify-between items-center text-rose-600 font-semibold">
            <span>Potongan Cashbon:</span>
            <div class="flex items-center gap-1.5">
              <span id="modal-cashbon">-Rp 0</span>
              <button
                type="button"
                id="modal-cashbon-detail-btn"
                class="hidden text-[10px] bg-rose-100 hover:bg-rose-200 text-rose-700 font-bold px-2 py-0.5 rounded-full border border-rose-200 transition cursor-pointer"
                onclick="openCashbonModalFromSlip()"
              >
                Lihat Rincian &rarr;
              </button>
            </div>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-between mt-2">
          <div>
            <span class="font-bold text-indigo-950 text-xs block">Total Gaji Bersih</span>
            <span class="text-[10px] text-indigo-600">Take Home Pay</span>
          </div>
          <div id="modal-amount" class="text-lg font-extrabold text-indigo-900">
            Rp 0
          </div>
        </div>

        <div class="text-[11px] text-slate-400 text-center pt-2">
          Dibayarkan pada <span id="modal-settled-date">Tanggal</span>. Dokumen sah resmi dari sistem Payrollku.
        </div>
      </div>

      <div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-2">
        <button
          type="button"
          onclick="closeSlipModal()"
          class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-200 transition cursor-pointer"
        >
          Tutup
        </button>
        <button
          type="button"
          id="modal-print-btn"
          class="inline-flex items-center gap-1.5 px-5 py-2 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white transition shadow-sm cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          Cetak / Simpan PDF
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Rincian Cashbon Terkait Slip Gaji -->
  <div id="cashbon-detail-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4" onclick="if(event.target === this) closeCashbonModal()">
    <div class="bg-white rounded-3xl max-w-lg w-full border border-slate-200 shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
      <!-- Header -->
      <div class="p-5 bg-gradient-to-r from-slate-900 to-indigo-950 text-white flex items-center justify-between shrink-0">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
            <h3 class="text-sm sm:text-base font-bold">Rincian Potongan Cashbon</h3>
          </div>
          <p class="text-xs text-slate-300 mt-0.5" id="cashbon-modal-subtitle">
            Slip Gaji #SLIP-0000
          </p>
        </div>
        <button
          type="button"
          onclick="closeCashbonModal()"
          class="w-8 h-8 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-base font-bold transition cursor-pointer"
          title="Tutup"
        >
          &times;
        </button>
      </div>

      <!-- Body -->
      <div class="p-5 sm:p-6 overflow-y-auto space-y-4 text-xs text-slate-700 flex-1">
        <!-- Summary Card -->
        <div class="p-4 rounded-2xl bg-rose-50/80 border border-rose-100 flex items-center justify-between">
          <div>
            <span class="text-[11px] font-semibold text-rose-800 block">Total Potongan Pada Slip Ini</span>
            <span class="text-[11px] text-rose-600" id="cashbon-modal-period-text">Periode Slip</span>
          </div>
          <div class="text-lg sm:text-xl font-extrabold text-rose-700" id="cashbon-modal-total-val">
            -Rp 0
          </div>
        </div>

        <!-- Cashbon Items List -->
        <div id="cashbon-modal-items-container" class="space-y-3.5">
          <!-- Dynamic cards injected via JS -->
        </div>
      </div>

      <!-- Footer -->
      <div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between shrink-0">
        <span class="text-[11px] text-slate-400">
          Data tersinkron otomatis dengan kasbon Anda
        </span>
        <button
          type="button"
          onclick="closeCashbonModal()"
          class="px-4 py-2 rounded-xl text-xs font-semibold bg-white border border-slate-200 text-slate-700 hover:bg-slate-100 transition cursor-pointer shadow-sm"
        >
          Tutup
        </button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{
    employeeName: employee.name,
    employeeNik: employee.nik,
    employeePosition: employee.position || '',
    employeeScheme: employee.scheme,
    employeeSchemeLabel: employee.scheme.replace('_', ' '),
    baseRate: Number(employee.base_rate) || 0,
    defaultMonthVal: currentMonthStr,
    defaultYearVal: currentYear,
    defaultStartDateVal: defaultStartDate,
    defaultEndDateVal: defaultEndDate,
    defaultCycleLabel: cycleInfo.label,
    unbilledRecords: allUnbilledRecords,
  }}>
    let activeSlipData = null;

    function formatRupiahJS(num) {
      return 'Rp ' + Math.round(Number(num) || 0).toLocaleString('id-ID');
    }

    function formatDateID(dateStr) {
      if (!dateStr) return '-';
      const parts = dateStr.split('-');
      if (parts.length === 3) {
        const months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
        const d = parseInt(parts[2], 10);
        const m = parseInt(parts[1], 10) - 1;
        const y = parts[0];
        return `${d} ${months[m] || ''} ${y}`;
      }
      return dateStr;
    }

    window.openSlipModal = function (data) {
      activeSlipData = data;
      document.getElementById('modal-slip-no').textContent = data.slipNo;
      document.getElementById('modal-settled-date').textContent = data.settledDate;
      document.getElementById('modal-emp-name').textContent = data.empName;
      document.getElementById('modal-period').textContent = data.period;
      document.getElementById('modal-scheme').textContent = data.scheme;
      document.getElementById('modal-base-wage').textContent = data.baseWage || data.rateFormatted;
      document.getElementById('modal-allowance').textContent = data.allowance || 'Rp 0';
      document.getElementById('modal-additional').textContent = `Lembur: ${data.overtime || 'Rp 0'} • Bonus: ${data.bonus || 'Rp 0'}`;
      document.getElementById('modal-cashbon').textContent = `-${data.cashbon || 'Rp 0'}`;
      document.getElementById('modal-amount').textContent = data.amountFormatted;

      const cashbonBtn = document.getElementById('modal-cashbon-detail-btn');
      if (cashbonBtn) {
        if (data.cashbonData && Number(data.cashbonData.totalDeduction) > 0) {
          cashbonBtn.classList.remove('hidden');
        } else {
          cashbonBtn.classList.add('hidden');
        }
      }

      document.getElementById('slip-modal').classList.remove('hidden');
    };

    window.closeSlipModal = function () {
      document.getElementById('slip-modal').classList.add('hidden');
    };

    window.openCashbonModal = function (data) {
      if (!data) return;
      document.getElementById('cashbon-modal-subtitle').textContent = `${data.slipNo} • Periode: ${data.period}`;
      document.getElementById('cashbon-modal-period-text').textContent = `Dipotong pada ${data.settledDate}`;
      document.getElementById('cashbon-modal-total-val').textContent = `-${data.totalDeductionFormatted || formatRupiahJS(data.totalDeduction)}`;

      const container = document.getElementById('cashbon-modal-items-container');
      if (container) {
        if (!data.items || data.items.length === 0) {
          container.innerHTML = `
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 text-center text-slate-500">
              <svg class="w-8 h-8 text-slate-400 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="font-bold text-slate-800 text-xs">Potongan Langsung Slip Gaji</p>
              <p class="text-[11px] text-slate-500 mt-1">Potongan sebesar <strong>${data.totalDeductionFormatted || formatRupiahJS(data.totalDeduction)}</strong> dicatat saat pembayaran slip gaji ini.</p>
            </div>
          `;
        } else {
          container.innerHTML = data.items.map((item, idx) => {
            const isFull = item.isFull;
            const badgeBg = isFull 
              ? 'bg-emerald-50 text-emerald-700 border-emerald-200' 
              : 'bg-amber-50 text-amber-700 border-amber-200';
            const statusDot = isFull ? 'bg-emerald-500' : 'bg-amber-500';
            
            const percentPaid = item.amountApproved > 0 
              ? Math.min(100, Math.round((item.totalRepaidAll / item.amountApproved) * 100))
              : 100;

            return `
              <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <!-- Card Header -->
                <div class="px-4 py-3 bg-slate-50/80 border-b border-slate-100 flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="font-mono font-bold text-slate-900 text-xs">${item.cashbonCode}</span>
                    <span class="text-[10px] text-slate-400">Pinjaman #${idx + 1}</span>
                  </div>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${badgeBg}">
                    <span class="w-1.5 h-1.5 rounded-full ${statusDot}"></span>
                    <span>${item.statusBadgeLabel}</span>
                  </span>
                </div>

                <!-- Card Body -->
                <div class="p-4 space-y-3">
                  <!-- 3 Financial Metrics -->
                  <div class="grid grid-cols-3 gap-2 text-center">
                    <div class="p-2.5 rounded-xl bg-rose-50/70 border border-rose-100">
                      <span class="text-[10px] text-slate-500 block mb-0.5">Dipotong Slip Ini</span>
                      <span class="text-xs sm:text-sm font-extrabold text-rose-600">-${item.deductionFormatted}</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                      <span class="text-[10px] text-slate-500 block mb-0.5">Total Pinjaman</span>
                      <span class="text-xs sm:text-sm font-bold text-slate-800">${item.amountApprovedFormatted}</span>
                    </div>
                    <div class="p-2.5 rounded-xl ${isFull ? 'bg-emerald-50/70 border border-emerald-100' : 'bg-amber-50/70 border border-amber-100'}">
                      <span class="text-[10px] text-slate-500 block mb-0.5">Sisa Pinjaman</span>
                      <span class="text-xs sm:text-sm font-extrabold ${isFull ? 'text-emerald-700' : 'text-amber-700'}">
                        ${isFull ? 'Rp 0 (Lunas)' : item.remainingFormatted}
                      </span>
                    </div>
                  </div>

                  <!-- Progress Bar -->
                  <div class="pt-1">
                    <div class="flex justify-between text-[10px] text-slate-500 mb-1">
                      <span>Progress Pelunasan Pinjaman</span>
                      <span class="font-bold ${isFull ? 'text-emerald-700' : 'text-amber-700'}">${percentPaid}%</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden">
                      <div class="${isFull ? 'bg-emerald-500' : 'bg-amber-500'} h-2 rounded-full transition-all duration-500" style="width: ${percentPaid}%"></div>
                    </div>
                    <div class="flex justify-between text-[10px] text-slate-400 mt-1">
                      <span>Total Terbayar: <strong>${item.totalRepaidAllFormatted}</strong></span>
                      <span>Total Disetujui: <strong>${item.amountApprovedFormatted}</strong></span>
                    </div>
                  </div>

                  <!-- Information Details -->
                  <div class="pt-2 border-t border-slate-100 space-y-1.5 text-[11px]">
                    <div class="flex justify-between items-start gap-2">
                      <span class="text-slate-400 shrink-0">Keperluan:</span>
                      <span class="text-slate-800 font-medium text-right">${item.reason || '-'}</span>
                    </div>
                    <div class="flex justify-between items-center gap-2">
                      <span class="text-slate-400 shrink-0">Tgl Diajukan:</span>
                      <span class="text-slate-700 text-right">${item.createdAtFormatted}</span>
                    </div>
                    <div class="flex justify-between items-center gap-2">
                      <span class="text-slate-400 shrink-0">Tgl Pencairan Dana:</span>
                      <span class="text-slate-700 text-right">${item.disbursedAtFormatted}</span>
                    </div>
                    <div class="flex justify-between items-start gap-2">
                      <span class="text-slate-400 shrink-0">Catatan Pemotongan:</span>
                      <span class="text-slate-700 text-right font-mono text-[10px]">${item.repaymentNotes || '-'}</span>
                    </div>
                    ${item.adminNotes && item.adminNotes !== '-' ? `
                      <div class="flex justify-between items-start gap-2">
                        <span class="text-slate-400 shrink-0">Catatan Admin:</span>
                        <span class="text-slate-700 text-right italic">${item.adminNotes}</span>
                      </div>
                    ` : ''}
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }
      }

      document.getElementById('cashbon-detail-modal').classList.remove('hidden');
    };

    window.closeCashbonModal = function () {
      document.getElementById('cashbon-detail-modal').classList.add('hidden');
    };

    window.openCashbonModalFromSlip = function () {
      if (activeSlipData && activeSlipData.cashbonData) {
        window.openCashbonModal(activeSlipData.cashbonData);
      }
    };

    window.printSlip = function (data) {
      const d = data || activeSlipData;
      if (!d) return;

      const printWindow = window.open('', '', 'width=680,height=750');
      printWindow.document.write(`
        <!DOCTYPE html>
        <html>
          <head>
            <title>Slip_Gaji_${d.slipNo}_${d.empName.replace(/[\s\/]/g, '_')}</title>
            <style>
              @page { size: portrait; margin: 12mm 15mm; }
              body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; padding: 25px; color: #0f172a; margin: 0; font-size: 13px; line-height: 1.5; }
              .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 20px; }
              .brand { font-size: 22px; font-weight: 800; letter-spacing: -0.5px; color: #4338ca; }
              .sub { font-size: 11px; color: #64748b; margin-top: 2px; }
              .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px; font-size: 13px; background: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid #e2e8f0; }
              .section-title { font-size: 11px; font-weight: bold; text-transform: uppercase; color: #475569; letter-spacing: 0.5px; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; margin-bottom: 8px; margin-top: 16px; }
              .row { display: flex; justify-content: space-between; padding: 5px 0; font-size: 13px; }
              .total-box { margin-top: 20px; border-top: 2px solid #0f172a; padding-top: 12px; display: flex; justify-content: space-between; font-size: 16px; font-weight: bold; }
              .footer { margin-top: 35px; font-size: 11px; color: #64748b; text-align: center; border-top: 1px dashed #cbd5e1; padding-top: 15px; }
              @media print {
                body { padding: 0; }
              }
            </style>
          </head>
          <body>
            <div class="header">
              <div>
                <div class="brand">PAYROLLKU</div>
                <div class="sub">Bukti Resmi Penggajian & Potongan</div>
              </div>
              <div style="text-align: right;">
                <div style="font-family: monospace; font-weight: bold; font-size: 14px;">${d.slipNo}</div>
                <div class="sub">${d.settledDate}</div>
              </div>
            </div>

            <div class="info-grid">
              <div>
                <div style="color: #64748b; font-size: 11px;">Karyawan:</div>
                <strong style="font-size: 14px;">${d.empName}</strong>
                <div style="color: #64748b;">NIK: ${d.empNik} • Posisi: ${d.position || '-'}</div>
              </div>
              <div style="text-align: right;">
                <div style="color: #64748b; font-size: 11px;">Periode Pembayaran:</div>
                <strong style="font-size: 13px;">${d.period}</strong>
                <div style="color: #64748b; text-transform: capitalize;">Skema Gaji: ${d.scheme} (${d.units})</div>
              </div>
            </div>

            <div class="section-title">Pendapatan</div>
            <div class="row"><span>Gaji Pokok (${d.units} × ${d.rateFormatted}):</span><span>${d.baseWage}</span></div>
            <div class="row"><span>Tunjangan:</span><span>${d.allowance || 'Rp 0'}</span></div>
            <div class="row"><span>Upah Lembur:</span><span>${d.overtime || 'Rp 0'}</span></div>
            <div class="row"><span>Bonus:</span><span>${d.bonus || 'Rp 0'}</span></div>

            <div class="section-title" style="color: #b91c1c;">Potongan</div>
            <div class="row" style="color: #b91c1c;">
              <span>Potongan Cashbon / Pinjaman:</span>
              <strong>-${d.cashbon || 'Rp 0'}</strong>
            </div>

            <div class="total-box">
              <span>Total Gaji Bersih (Take Home Pay):</span>
              <span style="color: #047857;">${d.amountFormatted}</span>
            </div>

            <div class="footer">
              Dibayarkan pada ${d.settledDate}. Dokumen ini dihasilkan secara otomatis oleh sistem Payrollku dan sah tanpa tanda tangan fisik.
            </div>
          </body>
        </html>
      `);
      printWindow.document.close();
      printWindow.focus();
      printWindow.print();
    };

    document.getElementById('modal-print-btn')?.addEventListener('click', () => {
      if (activeSlipData) {
        window.printSlip(activeSlipData);
      }
    });

    window.onMonthOrYearChange = function () {
      const startInput = document.getElementById('filterStartDate');
      const endInput = document.getElementById('filterEndDate');
      if (startInput) startInput.value = '';
      if (endInput) endInput.value = '';
      window.applyFilters();
    };

    window.onSpecificDateChange = function () {
      window.applyFilters();
    };

    window.resetSlipFilter = function () {
      const monthSelect = document.getElementById('filterMonth');
      const yearSelect = document.getElementById('filterYear');
      const startInput = document.getElementById('filterStartDate');
      const endInput = document.getElementById('filterEndDate');

      if (monthSelect) monthSelect.value = 'all';
      if (yearSelect) yearSelect.value = String(defaultYearVal);
      if (startInput) startInput.value = defaultStartDateVal;
      if (endInput) endInput.value = defaultEndDateVal;

      window.applyFilters();
    };

    window.applySlipFilters = function () {
      window.applyFilters();
    };

    window.applyFilters = function () {
      const startFilter = document.getElementById('filterStartDate')?.value || '';
      const endFilter = document.getElementById('filterEndDate')?.value || '';
      const monthFilter = document.getElementById('filterMonth')?.value || 'all';
      const yearFilter = document.getElementById('filterYear')?.value || '';

      let activeStart = '';
      let activeEnd = '';
      let periodLabel = '';

      if (startFilter || endFilter) {
        activeStart = startFilter;
        activeEnd = endFilter;
        if (startFilter && endFilter) {
          periodLabel = `${formatDateID(startFilter)} s/d ${formatDateID(endFilter)}`;
        } else if (startFilter) {
          periodLabel = `Mulai ${formatDateID(startFilter)}`;
        } else {
          periodLabel = `Sampai ${formatDateID(endFilter)}`;
        }
      } else if (monthFilter !== 'all') {
        const y = parseInt(yearFilter, 10);
        const m = parseInt(monthFilter, 10);
        const lastDay = new Date(y, m, 0).getDate();
        activeStart = `${y}-${String(m).padStart(2, '0')}-01`;
        activeEnd = `${y}-${String(m).padStart(2, '0')}-${String(lastDay).padStart(2, '0')}`;
        const months = ['', 'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
        periodLabel = `${months[m]} ${y}`;
      } else {
        periodLabel = 'Semua Periode';
      }

      // 1. Recalculate Gaji Berjalan Card
      let filteredUnbilled = unbilledRecords || [];
      if (activeStart && activeEnd) {
        filteredUnbilled = unbilledRecords.filter((r) => r.date_str >= activeStart && r.date_str <= activeEnd);
      } else if (activeStart) {
        filteredUnbilled = unbilledRecords.filter((r) => r.date_str >= activeStart);
      } else if (activeEnd) {
        filteredUnbilled = unbilledRecords.filter((r) => r.date_str <= activeEnd);
      }

      const totalPresentDays = filteredUnbilled.length;
      const totalMinutes = filteredUnbilled.reduce((sum, r) => sum + (Number(r.duration_minutes) || 480), 0);
      const totalHoursWorked = parseFloat((totalMinutes / 60).toFixed(1));

      let accruedAmount = 0;
      let attendanceLabel = '';
      let attendanceBadge = '';
      let attendanceBadgeType = 'info';
      let descText = '';

      if (employeeScheme === 'per_jam') {
        accruedAmount = Math.round(totalHoursWorked * baseRate);
        attendanceLabel = `${totalHoursWorked} Jam Kerja`;
        if (accruedAmount > 0) {
          attendanceBadge = 'Bisa Bayar Hari Ini';
          attendanceBadgeType = 'success';
          descText = 'Gaji berjalan yang siap dicairkan hari itu juga';
        } else {
          attendanceBadge = 'Sudah Dicairkan / Nihil';
          attendanceBadgeType = 'info';
          descText = 'Tidak ada jam kerja berjalan yang belum dicairkan pada periode ini';
        }
      } else if (employeeScheme === 'harian') {
        accruedAmount = Math.round(totalPresentDays * baseRate);
        attendanceLabel = `${totalPresentDays} Hari Hadir`;
        if (accruedAmount > 0) {
          attendanceBadge = 'Bisa Bayar Hari Ini';
          attendanceBadgeType = 'success';
          descText = 'Gaji berjalan yang siap dicairkan hari itu juga';
        } else {
          attendanceBadge = 'Sudah Dicairkan / Nihil';
          attendanceBadgeType = 'info';
          descText = 'Tidak ada kehadiran berjalan yang belum dicairkan pada periode ini';
        }
      } else if (employeeScheme === 'mingguan') {
        const dailyRate = Math.round(baseRate / 6);
        accruedAmount = Math.round(totalPresentDays * dailyRate);
        attendanceLabel = `${totalPresentDays} Hari Kerja`;
        if (accruedAmount > 0) {
          attendanceBadge = `Sedang Berjalan (${totalPresentDays} Hari)`;
          attendanceBadgeType = 'info';
          descText = 'Gaji yang sudah terkumpul (akan cair pada tanggal gajian)';
        } else {
          attendanceBadge = 'Nihil';
          attendanceBadgeType = 'info';
          descText = 'Tidak ada catatan kerja belum dicairkan pada periode ini';
        }
      } else if (employeeScheme === 'bulanan') {
        const dailyRate = Math.round(baseRate / 26);
        accruedAmount = totalPresentDays >= 26 ? baseRate : Math.round((totalPresentDays / 26) * baseRate);
        attendanceLabel = `${totalPresentDays} / 26 Hari Kerja`;
        if (accruedAmount > 0) {
          attendanceBadge = `Sedang Berjalan (${totalPresentDays} Hari)`;
          attendanceBadgeType = 'info';
          descText = 'Gaji yang sudah terkumpul (akan cair pada tanggal gajian)';
        } else {
          attendanceBadge = 'Nihil';
          attendanceBadgeType = 'info';
          descText = 'Tidak ada catatan kerja belum dicairkan pada periode ini';
        }
      }

      const periodTitleEl = document.getElementById('gaji-berjalan-period-title');
      if (periodTitleEl) {
        periodTitleEl.textContent = `Gaji Berjalan Periode Ini (${periodLabel})`;
      }

      const amountEl = document.getElementById('gaji-berjalan-amount');
      if (amountEl) {
        amountEl.textContent = formatRupiahJS(accruedAmount);
      }

      const descEl = document.getElementById('gaji-berjalan-desc');
      if (descEl) {
        descEl.textContent = descText;
      }

      const attLabelEl = document.getElementById('gaji-berjalan-attendance-label');
      if (attLabelEl) {
        attLabelEl.textContent = attendanceLabel;
      }

      const attBadgeEl = document.getElementById('gaji-berjalan-attendance-badge');
      if (attBadgeEl) {
        attBadgeEl.textContent = attendanceBadge;
        attBadgeEl.className = `inline-block px-2 py-0.5 rounded text-[10px] font-bold mt-1 ${
          attendanceBadgeType === 'success'
            ? 'bg-emerald-100 text-emerald-800'
            : attendanceBadgeType === 'warning'
            ? 'bg-amber-100 text-amber-800'
            : 'bg-slate-100 text-slate-700'
        }`;
      }

      // 2. Filter Riwayat Slip Gaji table rows
      const rows = Array.from(document.querySelectorAll('.slip-row'));
      let visibleCount = 0;
      let totalGross = 0;
      let totalCashbon = 0;
      let totalNet = 0;

      rows.forEach((row) => {
        const periodStart = row.dataset.periodStart || '';
        const periodEnd = row.dataset.periodEnd || '';
        const settledDate = row.dataset.settledDate || '';
        const gross = Number(row.dataset.gross) || 0;
        const cashbon = Number(row.dataset.cashbon) || 0;
        const net = Number(row.dataset.net) || 0;

        let match = true;
        if (activeStart && activeEnd) {
          const checkDate = settledDate || periodEnd;
          if (checkDate < activeStart && periodEnd < activeStart) match = false;
          if (checkDate > activeEnd && periodStart > activeEnd) match = false;
        } else if (activeStart) {
          const checkDate = settledDate || periodEnd;
          if (checkDate < activeStart && periodEnd < activeStart) match = false;
        } else if (activeEnd) {
          const checkDate = settledDate || periodStart;
          if (checkDate > activeEnd && periodStart > activeEnd) match = false;
        }

        if (match) {
          row.style.display = '';
          visibleCount++;
          totalGross += gross;
          totalCashbon += cashbon;
          totalNet += net;
        } else {
          row.style.display = 'none';
        }
      });

      const badgeEl = document.getElementById('badge-total-slips');
      if (badgeEl) {
        badgeEl.textContent = `${visibleCount} Slip Ditemukan`;
      }

      const countEl = document.getElementById('summary-slip-count');
      if (countEl) countEl.textContent = visibleCount;

      const grossEl = document.getElementById('summary-gross-val');
      if (grossEl) grossEl.textContent = formatRupiahJS(totalGross);

      const cashbonEl = document.getElementById('summary-cashbon-val');
      if (cashbonEl) {
        cashbonEl.textContent = totalCashbon > 0 ? `-${formatRupiahJS(totalCashbon)}` : 'Rp 0';
      }

      const netEl = document.getElementById('summary-net-val');
      if (netEl) netEl.textContent = formatRupiahJS(totalNet);

      const settledGrossEl = document.getElementById('gaji-settled-amount');
      if (settledGrossEl) {
        settledGrossEl.textContent = formatRupiahJS(totalGross);
        settledGrossEl.className = `text-2xl sm:text-3xl font-extrabold ${totalGross > 0 ? 'text-slate-900' : 'text-slate-700'}`;
      }

      const settledCashbonEl = document.getElementById('gaji-cashbon-amount');
      if (settledCashbonEl) {
        settledCashbonEl.textContent = totalCashbon > 0 ? `-${formatRupiahJS(totalCashbon)}` : formatRupiahJS(0);
        settledCashbonEl.className = `text-2xl sm:text-3xl font-extrabold ${totalCashbon > 0 ? 'text-rose-600' : 'text-slate-400'}`;
      }

      const settledNetEl = document.getElementById('gaji-net-amount');
      if (settledNetEl) {
        settledNetEl.textContent = formatRupiahJS(totalNet);
        settledNetEl.className = `text-2xl sm:text-3xl font-extrabold ${totalNet > 0 ? 'text-emerald-600' : 'text-slate-700'}`;
      }

      const settledCountEl = document.getElementById('gaji-settled-count');
      if (settledCountEl) {
        settledCountEl.textContent = visibleCount > 0 ? `${visibleCount} Slip Dicairkan` : 'Belum Ada';
      }

      const settledSublabelEl = document.getElementById('gaji-settled-sublabel');
      if (settledSublabelEl) {
        settledSublabelEl.textContent = `Bersih ${formatRupiahJS(totalNet)}`;
      }

      const emptyFilteredEl = document.getElementById('no-slips-filtered-row');
      const tfootEl = document.getElementById('slip-table-tfoot');
      if (emptyFilteredEl) {
        emptyFilteredEl.classList.toggle('hidden', visibleCount > 0);
      }
      if (tfootEl) {
        tfootEl.style.display = visibleCount > 0 ? '' : 'none';
      }
    };

    window.exportRekapPDF = function () {
      const visibleRows = Array.from(document.querySelectorAll('.slip-row')).filter(
        (r) => r.style.display !== 'none'
      );
      if (visibleRows.length === 0) {
        alert('Tidak ada data slip gaji pada periode yang dipilih untuk diexport.');
        return;
      }

      const monthSelect = document.getElementById('filterMonth');
      const monthText = monthSelect ? monthSelect.options[monthSelect.selectedIndex].text : '';
      const yearSelect = document.getElementById('filterYear');
      const yearText = yearSelect ? yearSelect.value : '';
      const startDate = document.getElementById('filterStartDate')?.value;
      const endDate = document.getElementById('filterEndDate')?.value;

      let periodLabel = '';
      if (startDate && endDate) {
        periodLabel = `${formatDateID(startDate)} s/d ${formatDateID(endDate)}`;
      } else if (monthSelect && monthSelect.value !== 'all') {
        periodLabel = `${monthText} ${yearText}`;
      } else {
        periodLabel = 'Semua Riwayat Slip Gaji';
      }

      let totalGross = 0;
      let totalCashbon = 0;
      let totalNet = 0;

      const rowsHtml = visibleRows
        .map((r) => {
          const slipNo = r.dataset.slipNo;
          const period = r.dataset.period;
          const units = r.dataset.units;
          const gross = Number(r.dataset.gross) || 0;
          const cashbon = Number(r.dataset.cashbon) || 0;
          const net = Number(r.dataset.net) || 0;
          const settledDate = r.dataset.settledDateFormatted;

          totalGross += gross;
          totalCashbon += cashbon;
          totalNet += net;

          return `
          <tr>
            <td style="padding: 7px 10px; border: 1px solid #cbd5e1; font-family: monospace; font-weight: bold;">${slipNo}</td>
            <td style="padding: 7px 10px; border: 1px solid #cbd5e1;">${period}</td>
            <td style="padding: 7px 10px; border: 1px solid #cbd5e1;">${units}</td>
            <td style="padding: 7px 10px; border: 1px solid #cbd5e1; text-align: right;">${formatRupiahJS(gross)}</td>
            <td style="padding: 7px 10px; border: 1px solid #cbd5e1; text-align: right; color: ${cashbon > 0 ? '#b91c1c' : '#64748b'}; font-weight: ${cashbon > 0 ? 'bold' : 'normal'};">
              ${cashbon > 0 ? '-' + formatRupiahJS(cashbon) : '-'}
            </td>
            <td style="padding: 7px 10px; border: 1px solid #cbd5e1; text-align: right; font-weight: bold; color: #047857;">${formatRupiahJS(net)}</td>
            <td style="padding: 7px 10px; border: 1px solid #cbd5e1; text-align: center;">${settledDate}</td>
          </tr>
        `;
        })
        .join('');

      const printWindow = window.open('', '', 'width=850,height=750');
      printWindow.document.write(`
        <!DOCTYPE html>
        <html>
          <head>
            <title>Rekap_Slip_Gaji_${encodeURIComponent(employeeName)}_${periodLabel.replace(/[\s\/]/g, '_')}</title>
            <style>
              @page { size: landscape; margin: 12mm 15mm; }
              body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; padding: 25px; color: #0f172a; margin: 0; font-size: 12px; }
              .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 16px; }
              .brand { font-size: 20px; font-weight: 800; letter-spacing: -0.5px; color: #4338ca; }
              .title { font-size: 14px; font-weight: bold; color: #0f172a; margin-top: 2px; }
              .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 16px; font-size: 12px; background: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid #e2e8f0; }
              table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 11px; }
              th { background: #f1f5f9; color: #334155; font-weight: 700; text-transform: uppercase; font-size: 10px; letter-spacing: 0.5px; border: 1px solid #94a3b8; padding: 8px; }
              td { border: 1px solid #cbd5e1; }
              tfoot td { background: #f8fafc; font-weight: bold; border: 1px solid #94a3b8; }
              .footer { margin-top: 25px; display: flex; justify-content: space-between; align-items: flex-end; font-size: 11px; color: #64748b; border-top: 1px dashed #cbd5e1; padding-top: 12px; }
              @media print {
                body { padding: 0; }
              }
            </style>
          </head>
          <body>
            <div class="header">
              <div>
                <div class="brand">PAYROLLKU</div>
                <div class="title">REKAPITULASI SLIP GAJI KARYAWAN</div>
              </div>
              <div style="text-align: right; font-size: 11px; color: #64748b;">
                <div>Tanggal Cetak: <strong>${new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</strong></div>
                <div>Total: <strong>${visibleRows.length} Slip</strong></div>
              </div>
            </div>

            <div class="info-grid">
              <div>
                <div style="color: #64748b; font-size: 11px;">Nama Karyawan:</div>
                <div style="font-size: 14px; font-weight: bold; color: #0f172a;">${employeeName}</div>
                <div style="color: #64748b;">NIK: ${employeeNik} • Jabatan: ${employeePosition || '-'}</div>
              </div>
              <div style="text-align: right;">
                <div style="color: #64748b; font-size: 11px;">Periode Filter:</div>
                <div style="font-size: 13px; font-weight: bold; color: #4338ca;">${periodLabel}</div>
                <div style="color: #64748b;">Skema: ${employeeSchemeLabel}</div>
              </div>
            </div>

            <table>
              <thead>
                <tr>
                  <th style="text-align: left;">No. Slip</th>
                  <th style="text-align: left;">Periode Kerja</th>
                  <th style="text-align: left;">Total Kerja</th>
                  <th style="text-align: right;">Gaji Kotor</th>
                  <th style="text-align: right;">Potongan Cashbon</th>
                  <th style="text-align: right;">Gaji Bersih</th>
                  <th style="text-align: center;">Tgl Bayar</th>
                </tr>
              </thead>
              <tbody>
                ${rowsHtml}
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="3" style="padding: 8px; text-align: right;">TOTAL:</td>
                  <td style="padding: 8px; text-align: right;">${formatRupiahJS(totalGross)}</td>
                  <td style="padding: 8px; text-align: right; color: ${totalCashbon > 0 ? '#b91c1c' : '#0f172a'};">
                    ${totalCashbon > 0 ? '-' + formatRupiahJS(totalCashbon) : 'Rp 0'}
                  </td>
                  <td style="padding: 8px; text-align: right; color: #047857; font-size: 12px;">${formatRupiahJS(totalNet)}</td>
                  <td></td>
                </tr>
              </tfoot>
            </table>

            <div class="footer">
              <div>Dokumen ini dihasilkan secara resmi oleh sistem <strong>Payrollku</strong>.</div>
              <div>Halaman 1 dari 1</div>
            </div>
          </body>
        </html>
      `);
      printWindow.document.close();
      printWindow.focus();
      printWindow.print();
    };

    // Initialize filter on load
    window.applyFilters();
  </script>

</Layout>
